{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://install.doctor/schemas/performance-evidence/v2",
  "title":"Install Doctor hermetic performance evidence v2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","fixtureId","scope","claimsProductionPerformance","generatedAt","runtime","authority","sampling","processEvidence","measurements"],
  "properties":{
    "schemaVersion":{"const":2},
    "fixtureId":{"const":"installer-hermetic-v2"},
    "scope":{"const":"hermetic-fixture"},
    "claimsProductionPerformance":{"const":false},
    "generatedAt":{"type":"string","format":"date-time"},
    "runtime":{"type":"object","additionalProperties":false,"required":["node","platform","arch"],"properties":{"node":{"type":"string"},"platform":{"type":"string"},"arch":{"type":"string"}}},
    "authority":{"type":"object","additionalProperties":false,"required":["releaseId","sourceCommit","planDigest","fixturePlatform","hardwareClass","isolation"],"properties":{"releaseId":{"const":"fixture-release"},"sourceCommit":{"pattern":"^[a-f0-9]{40}$"},"planDigest":{"pattern":"^[a-f0-9]{64}$"},"fixturePlatform":{"type":"object","additionalProperties":false,"required":["os","osVersion","arch","environment","packageManager"],"properties":{"os":{"const":"darwin"},"osVersion":{"const":"15"},"arch":{"const":"arm64"},"environment":{"const":"native"},"packageManager":{"const":"brew"}}},"hardwareClass":{"const":"local-unclassified"},"isolation":{"const":"fresh-process-and-loopback-fixture"}}},
    "sampling":{"type":"object","additionalProperties":false,"required":["cold","warm","minimumSamples"],"properties":{"cold":{"const":"fresh-process-per-sample"},"warm":{"const":"persistent-process-repeated-samples"},"minimumSamples":{"type":"integer","minimum":3}}},
    "processEvidence":{"type":"object","additionalProperties":false,"required":["coldPids","warmPids"],"properties":{"coldPids":{"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"integer","minimum":1}},"warmPids":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"integer","minimum":1}}}},
    "measurements":{"type":"array","minItems":21,"maxItems":21,"items":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["name","temperature","unit","status","sampleCount","statistics","budget","passed","method","limitation"],"properties":{"name":{"type":"string"},"temperature":{"enum":["cold","warm"]},"unit":{"type":"string"},"status":{"const":"measured"},"sampleCount":{"type":"integer","minimum":3},"statistics":{"type":"object","additionalProperties":false,"required":["p50","p95","max"],"properties":{"p50":{"type":"number","minimum":0},"p95":{"type":"number","minimum":0},"max":{"type":"number","minimum":0}}},"budget":{"type":"object","additionalProperties":false,"required":["comparison","value","statistic"],"properties":{"comparison":{"enum":["min","max"]},"value":{"type":"number","minimum":0},"statistic":{"const":"p95"}}},"passed":{"type":"boolean"},"method":{"type":"string","minLength":8},"limitation":{"type":"null"}}},
      {"type":"object","additionalProperties":false,"required":["name","temperature","unit","status","sampleCount","statistics","budget","passed","method","limitation"],"properties":{"name":{"type":"string"},"temperature":{"enum":["cold","warm"]},"unit":{"type":"string"},"status":{"const":"unsupported"},"sampleCount":{"const":0},"statistics":{"type":"null"},"budget":{"type":"null"},"passed":{"type":"null"},"method":{"type":"string","minLength":8},"limitation":{"type":"string","minLength":16}}}
    ]}}
  }
}
