### Ensure Homebrew is loaded
idPartialSha256File() {
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  else return 1
  fi
}

idTrustedHomebrewExecutable() {
  local candidate="${INSTALL_DOCTOR_HOMEBREW_PATH:-}" expected="${INSTALL_DOCTOR_HOMEBREW_SHA256:-}" actual owner mode parent parent_owner parent_mode
  if [ -z "$candidate" ]; then candidate="$(command -v brew 2>/dev/null || true)"; fi
  case "$candidate" in /*) ;; *) return 1 ;; esac
  [ -f "$candidate" ] && [ ! -L "$candidate" ] && [ -x "$candidate" ] || return 1
  parent="$(dirname "$candidate")"
  [ -d "$parent" ] && [ ! -L "$parent" ] || return 1
  if stat -f '%u %Lp' "$candidate" >/dev/null 2>&1; then
    read -r owner mode <<EOF
$(stat -f '%u %Lp' "$candidate")
EOF
    read -r parent_owner parent_mode <<EOF
$(stat -f '%u %Lp' "$parent")
EOF
  else
    read -r owner mode <<EOF
$(stat -c '%u %a' "$candidate")
EOF
    read -r parent_owner parent_mode <<EOF
$(stat -c '%u %a' "$parent")
EOF
  fi
  case "$owner:$parent_owner" in
    "$(id -u):$(id -u)"|"$(id -u):0"|"0:0"|"0:$(id -u)") ;;
    *) return 1 ;;
  esac
  [ $((8#$mode & 2)) -eq 0 ] && [ $((8#$parent_mode & 2)) -eq 0 ] || return 1
  case "$expected" in
    absent|'') ;;
    *[!a-f0-9]*) return 1 ;;
    *) [ "${#expected}" -eq 64 ] || return 1; actual="$(idPartialSha256File "$candidate")" || return 1; [ "$actual" = "$expected" ] || return 1 ;;
  esac
  printf '%s\n' "$candidate"
}

loadHomebrew() {
  local brew_path
  brew_path="$(idTrustedHomebrewExecutable)" || { logg info 'Could not find the exact trusted Homebrew executable'; return 1; }
  PATH="$(dirname "$brew_path"):$PATH"
  export PATH
  hash -r
  [ "$(command -v brew)" = "$brew_path" ]
}

### Ensures Homebrew folders have proper owners / permissions
fixHomebrewPermissions() {
  if command -v brew > /dev/null; then
    logg info 'Applying proper permissions on Homebrew folders'
    sudo chmod -R go-w "$(brew --prefix)/share"
    BREW_DIRS="share etc/bash_completion.d"
    for BREW_DIR in $BREW_DIRS; do
      if [ -d "$(brew --prefix)/$BREW_DIR" ]; then
        sudo chown -Rf "$(whoami)" "$(brew --prefix)/$BREW_DIR"
      fi
    done
    logg info 'Running brew update --force --quiet' && brew update --force --quiet
  fi
}

# @description This function removes group write permissions from the Homebrew share folder which
#     is required for the ZSH configuration.
fixHomebrewSharePermissions() {
  if [ -f /usr/local/bin/brew ]; then
    sudo chmod -R g-w /usr/local/share
  elif [ -f "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/brew" ]; then
    sudo chmod -R g-w "${HOMEBREW_PREFIX:-/opt/homebrew}/share"
  elif [ -d "$HOME/.linuxbrew" ]; then
    sudo chmod -R g-w "$HOME/.linuxbrew/share"
  elif [ -d "/home/linuxbrew/.linuxbrew" ]; then
    sudo chmod -R g-w /home/linuxbrew/.linuxbrew/share
  fi
}

runPinnedHomebrewInstaller() {
  local installer actual status=0 commit='959bdd728192d78c47287c177796c3d86d111f09'
  local expected='5f333bbe53bc490e51e7ccb1df8779b3dd6ee73a1a7379efda216edb08ccb148'
  installer="$(mktemp)" || return 1
  if ! curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 10 --max-time 60 "https://raw.githubusercontent.com/Homebrew/install/$commit/install.sh" -o "$installer"; then
    rm -f "$installer"
    return 1
  fi
  [ "$(wc -c < "$installer")" -le 1048576 ] || { rm -f "$installer"; return 1; }
  if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$installer" | awk '{print $1}')";
  elif command -v shasum >/dev/null 2>&1; then actual="$(shasum -a 256 "$installer" | awk '{print $1}')";
  else rm -f "$installer"; return 1; fi
  [ "$actual" = "$expected" ] || { rm -f "$installer"; return 1; }
  NONINTERACTIVE=1 bash "$installer" || status=$?
  rm -f "$installer"
  return "$status"
}

### Installs Homebrew
ensurePackageManagerHomebrew() {
  if ! idTrustedHomebrewExecutable >/dev/null 2>&1; then
    if [ -n "${INSTALL_DOCTOR_HOMEBREW_PATH:-}" ] && [ -e "$INSTALL_DOCTOR_HOMEBREW_PATH" ]; then
      logg error 'The plan-bound Homebrew executable changed or has unsafe ownership or permissions'
      return 2
    fi
    ### Select install type based off of whether or not sudo privileges are available
    if command -v sudo > /dev/null && sudo -n true; then
      logg info 'Installing Homebrew. Sudo privileges available.'
      runPinnedHomebrewInstaller || BREW_EXIT_CODE="$?"
      if [ -d "/opt/homebrew" ]; then
        if [ -n "$USER" ]; then
          logg info "Setting owner of /opt/homebrew to '$USER'" && sudo chown -R "$USER" /opt/homebrew || logg warn "Failed to chown /opt/homebrew to '$USER'"
        else
          logg warn "USER not set; skipping chown /opt/homebrew"
        fi
      fi
      fixHomebrewSharePermissions
    else
      logg info 'Installing Homebrew. Sudo privileges not available. Password may be required.'
      runPinnedHomebrewInstaller || BREW_EXIT_CODE="$?"
      if [ -d "/opt/homebrew" ]; then
        if [ -n "$USER" ]; then
          logg info "Setting owner of /opt/homebrew to '$USER'" && sudo chown -R "$USER" /opt/homebrew || logg warn "Failed to chown /opt/homebrew to '$USER'"
        else
          logg warn "USER not set; skipping chown /opt/homebrew"
        fi
      fi
      fixHomebrewSharePermissions
    fi

    ### Attempt to fix problematic installs
    if [ -n "$BREW_EXIT_CODE" ]; then
        logg warn 'Homebrew was installed but part of the installation failed to complete successfully.'
        fixHomebrewPermissions
      fi
  fi
}

# @description This function ensures Homebrew is installed and available in the `PATH`. It handles the installation of Homebrew on both **Linux and macOS**.
#     It will attempt to bypass sudo password entry if it detects that it can do so. The function also has some error handling in regards to various
#     directories falling out of the correct ownership and permission states. Finally, it loads Homebrew into the active profile (allowing other parts of the script
#     to use the `brew` command).
#
#     Optional compilers remain selected desired-state packages and are never eagerly installed by bootstrap.
ensureHomebrew() {
  loadHomebrew || true
  ensurePackageManagerHomebrew
  loadHomebrew || { logg error 'Homebrew installation did not produce the exact trusted executable'; return 1; }
}
