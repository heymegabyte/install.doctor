#!/usr/bin/env bash
# @file home/.chezmoiscripts/universal/run_after_21-cua-spaces.sh.tmpl
# @brief Install Cua Spaces on GUI desktops with >= 16 GiB RAM (gated, idempotent, consent-safe)
# @description
#     Cua Spaces (https://cua.ai) is a computer-use execution SUBSTRATE (isolated desktops for
#     agents), not a governance plane. Brian directive 2026-10-28: "ensure Cua Spaces is installed
#     on any desktop with 16GB+ RAM." Per the `cua-spaces-integration` rule it is OFFERED during
#     provisioning only on a GUI DESKTOP with >= 16 GiB RAM and a supported OS (macOS / Linux).
#
#     This provisioning step is deliberately CONSERVATIVE: it installs the Cua Spaces app + the `cua`
#     CLI (dry-run first), and NOTHING that needs explicit per-action consent. It does NOT pair the
#     machine to an account (--pair), does NOT sign in, does NOT run `cua connect setup` to attach
#     agents, and NEVER unlocks the Keyvault or copies host credentials — those remain the user's
#     explicit later action. The Linux AppImage is excluded (the installer selects the native package).
#
#     Gates (skips gracefully, exit 0): HEADLESS_INSTALL set · opt-out INSTALL_DOCTOR_CUA=0 ·
#     unsupported OS · no graphical session · < 16 GiB RAM · `cua` already installed (idempotent).
set -Eeo pipefail
trap "command -v gum >/dev/null 2>&1 && gum log -sl error 'post run_after_21-cua-spaces encountered an error' || echo '[ERROR] run_after_21-cua-spaces' >&2" ERR

log() { if command -v gum >/dev/null 2>&1; then gum log -sl info "$1"; else echo "[INFO] $1"; fi; }
warn() { if command -v gum >/dev/null 2>&1; then gum log -sl warn "$1"; else echo "[WARN] $1" >&2; fi; }

### Opt-out
if [ "${INSTALL_DOCTOR_CUA:-1}" = "0" ]; then
  log 'Cua Spaces install opted out (INSTALL_DOCTOR_CUA=0) — skipping'
  exit 0
fi

### Headless gate — Cua Spaces is a DESKTOP app; a headless/server provision has no GUI
if [ -n "${HEADLESS_INSTALL:-}" ]; then
  log 'HEADLESS_INSTALL set — skipping Cua Spaces (desktop app needs a graphical session)'
  exit 0
fi

### OS gate — supported on macOS + Linux only
case "${OSTYPE:-}" in
  darwin*) CUA_OS='macos' ;;
  linux*) CUA_OS='linux' ;;
  *)
    log "Cua Spaces unsupported on OSTYPE='${OSTYPE:-unknown}' — skipping"
    exit 0
    ;;
esac

### Graphical-session gate (Linux) — a headless server has no DISPLAY/WAYLAND_DISPLAY
if [ "$CUA_OS" = 'linux' ] && [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  log 'No graphical session (DISPLAY/WAYLAND_DISPLAY unset) — skipping Cua Spaces (desktop app)'
  exit 0
fi

### RAM gate — require >= 16 GiB
CUA_RAM_GIB=0
if [ "$CUA_OS" = 'macos' ]; then
  CUA_RAM_GIB=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))
else
  CUA_MEM_KB="$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null || echo 0)"
  CUA_RAM_GIB=$(( CUA_MEM_KB / 1048576 ))
fi
if [ "$CUA_RAM_GIB" -lt 16 ]; then
  log "Cua Spaces needs >= 16 GiB RAM; detected ${CUA_RAM_GIB} GiB — skipping"
  exit 0
fi

### Idempotency — if `cua` is already installed, verify health and stop (no reinstall)
if command -v cua >/dev/null 2>&1; then
  log "Cua already installed ($(cua --version 2>/dev/null || echo present)) — verifying runtime"
  if cua runtime doctor >/dev/null 2>&1; then
    log 'cua runtime doctor: OK'
  else
    warn 'cua runtime doctor reported issues (left as-is — not reinstalling)'
  fi
  exit 0
fi

log "GUI desktop with ${CUA_RAM_GIB} GiB RAM (${CUA_OS}) — installing Cua Spaces (dry-run first)"

### Step 1 — dry-run (shows what WOULD happen; installs nothing) per the cua-spaces rule
if ! curl -fsSL https://cua.ai/install.sh | sh -s -- --dry-run; then
  warn 'Cua Spaces dry-run failed — NOT installing'
  exit 0
fi

### Step 2 — real install, non-interactive: the Cua Spaces app + the `cua` CLI (native package; NOT
### the Linux AppImage). `--yes` installs without prompts and WITHOUT signing in or pairing — there is
### no auto account-join, no credential copy. The user finishes sign-in / pairing / Keyvault later.
if ! curl -fsSL https://cua.ai/install.sh | sh -s -- --yes; then
  warn 'Cua Spaces install failed — leaving the system unchanged'
  exit 0
fi

### Step 3 — verify (never claim success without evidence)
if command -v cua >/dev/null 2>&1; then
  if cua runtime doctor >/dev/null 2>&1; then
    log "Cua Spaces installed ($(cua --version 2>/dev/null || echo installed)) — runtime doctor OK"
  else
    warn 'Cua installed but runtime doctor reported issues — review with: cua runtime doctor'
  fi
else
  warn 'Cua installer ran but `cua` is not on PATH yet — open a new shell or review the installer output'
fi
