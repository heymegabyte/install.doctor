#!/usr/bin/env bash
# @file run_after_30-aid-report.sh
# @brief After every `chezmoi apply`, a PAIRED machine fetches its desired state + records a reconcile.
# @description
#     If this machine has been paired with the aid control plane (a device token exists), run
#     `aid pull` (fetch the desired ENVIRONMENT.md) + `aid plan` (reconcile vs installed + auto-register
#     a History event) so a provisioned box automatically reports its state (MASTER-PROMPT §2). This
#     NEVER mutates packages — `aid apply` stays an explicit, opt-in action. Unpaired machines skip
#     silently (pairing is the deliberate `aid-pair` step). Best-effort, headless-safe, idempotent,
#     universal (all roles). Set AID_SKIP_REPORT=1 to skip. Seams: AID_BIN, AID_TOKEN_PATH.
set -euo pipefail

[ "${AID_SKIP_REPORT:-0}" = "1" ] && exit 0

AID_TOKEN_PATH="${AID_TOKEN_PATH:-$HOME/.config/aid/device-token}"
# Unpaired → nothing to report; skip silently.
[ -s "$AID_TOKEN_PATH" ] || exit 0

AID_BIN="${AID_BIN:-$HOME/.local/bin/aid}"
if [ ! -x "$AID_BIN" ]; then
  if command -v aid >/dev/null 2>&1; then
    AID_BIN="$(command -v aid)"
  else
    exit 0 # aid client not deployed yet
  fi
fi

# Best-effort: fetch desired + reconcile + record. NEVER mutate (no `aid apply`), NEVER fail the apply.
"$AID_BIN" pull >/dev/null 2>&1 || true
"$AID_BIN" plan >/dev/null 2>&1 || true
