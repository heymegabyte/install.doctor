#!/usr/bin/env bash
# @file run_after_30-aid-report.sh
# @brief After every `chezmoi apply`, emits a structured NDJSON event and reconciles desired state with desktop.tools.
# @description
#     1. Appends a structured JSON apply receipt to ~/.local/var/log/install.doctor/events.ndjson for Alloy/Loki.
#     2. If this machine has been paired with desktop.tools (or legacy aid), runs pull + plan (read-only reconcile).
set -euo pipefail

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/var/log}/install.doctor"
mkdir -p "$LOG_DIR" 2>/dev/null || true
TS="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)"
HOST_SHORT="$(hostname -s 2>/dev/null || hostname || echo unknown)"
OS_NAME="$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]' || echo unknown)"
printf '{"ts":"%s","event":"chezmoi_apply_completed","host":"%s","os":"%s","controlPlane":"desktop.tools","status":"ok"}\n' \
  "$TS" "$HOST_SHORT" "$OS_NAME" >> "$LOG_DIR/events.ndjson" 2>/dev/null || true

SKIP_REPORT="${DESKTOP_TOOLS_SKIP_REPORT:-0}"
[ "$SKIP_REPORT" = "1" ] && exit 0

DESKTOP_TOOLS_TOKEN_PATH="${DESKTOP_TOOLS_TOKEN_PATH:-$HOME/.config/desktop-tools/device-token}"
if [ ! -s "$DESKTOP_TOOLS_TOKEN_PATH" ] && [ -s "$HOME/.config/aid/device-token" ]; then
  DESKTOP_TOOLS_TOKEN_PATH="$HOME/.config/aid/device-token"
fi
[ -s "$DESKTOP_TOOLS_TOKEN_PATH" ] || exit 0

CLIENT_BIN="${DESKTOP_TOOLS_BIN:-$HOME/.local/bin/desktop-tools}"
if [ ! -x "$CLIENT_BIN" ]; then
  if command -v desktop-tools >/dev/null 2>&1; then
    CLIENT_BIN="$(command -v desktop-tools)"
  elif [ -x "$HOME/.local/bin/aid" ]; then
    CLIENT_BIN="$HOME/.local/bin/aid"
  elif command -v aid >/dev/null 2>&1; then
    CLIENT_BIN="$(command -v aid)"
  else
    exit 0
  fi
fi

# Best-effort: fetch desired + reconcile + record. NEVER mutate packages.
"$CLIENT_BIN" pull >/dev/null 2>&1 || true
"$CLIENT_BIN" plan >/dev/null 2>&1 || true
