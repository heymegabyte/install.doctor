#!/usr/bin/env bash
# @file Miscellaneous Clean Up
# @brief Removes deprecated Volta shims and runs package-manager cache cleanup without deleting user history or Wrangler state.

{{ includeTemplate "universal/profile" }}
{{ includeTemplate "universal/logg" }}

cleanAptGet() {
  if command -v apt-get > /dev/null; then
    gum log -sl info 'Running sudo apt-get autoclean' && sudo apt-get autoclean
    gum log -sl info 'Running sudo apt-get -y autoremove' && sudo apt-get -y autoremove
  fi
}

cleanupBrew() {
  if command -v brew > /dev/null; then
    gum log -sl info 'Running brew cleanup' && brew cleanup
  fi
}

removeDotVolta() {
  for VOLTA_DIR in "$HOME/.volta" "${XDG_DATA_HOME:-$HOME/.local/share}/volta"; do
    if [ -d "$VOLTA_DIR" ]; then
      gum log -sl info "Removing legacy Volta directory $VOLTA_DIR (mise is the canonical runtime manager per ADR 0003)"
      rm -rf "$VOLTA_DIR" 2>/dev/null || sudo rm -rf "$VOLTA_DIR"
    fi
  done
}

### Remove meta sudo file
if [ -f "$HOME/.sudo_as_admin_successful" ]; then
  rm -f "$HOME/.sudo_as_admin_successful"
fi

### Remove wget HSTS file in root HOME (alias places it in ~/.local)
if [ -f "$HOME/.wget-hsts" ]; then
  rm -f "$HOME/.wget-hsts"
fi

removeDotVolta &
cleanAptGet &
cleanupBrew &
wait

gum log -sl info 'Finished cleanup process' && exit 0
