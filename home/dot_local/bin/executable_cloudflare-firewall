#!/usr/bin/env bash
# @file Cloudflare-Only Zero-Trust Firewall
# @brief Locks down the host firewall so incoming connections on ports 22, 80, and 443 are strictly allowed ONLY via Cloudflare IPv4/IPv6 edge CIDRs (plus local loopback & Zero-Trust mesh interfaces).

set -euo pipefail

log_info() {
  if command -v gum > /dev/null 2>&1; then
    gum log -sl info "$*"
  else
    printf '[INFO] %s\n' "$*"
  fi
}

log_warn() {
  if command -v gum > /dev/null 2>&1; then
    gum log -sl warn "$*"
  else
    printf '[WARN] %s\n' "$*" >&2
  fi
}

# Canonical Cloudflare IPv4 & IPv6 edge CIDR blocks (https://www.cloudflare.com/ips-v4 and ips-v6)
FALLBACK_CF_IPV4=(
  "173.245.48.0/20"
  "103.21.244.0/22"
  "103.22.200.0/22"
  "103.31.4.0/22"
  "141.101.64.0/18"
  "108.162.192.0/18"
  "190.93.240.0/20"
  "188.114.96.0/20"
  "197.234.240.0/22"
  "198.41.128.0/17"
  "162.158.0.0/15"
  "104.16.0.0/13"
  "104.24.0.0/14"
  "172.64.0.0/13"
  "131.0.72.0/22"
)

FALLBACK_CF_IPV6=(
  "2400:cb00::/32"
  "2606:4700::/32"
  "2803:f800::/32"
  "2405:b500::/32"
  "2405:8100::/32"
  "2a06:98c0::/29"
  "2c0f:f248::/32"
)

fetch_cloudflare_ips() {
  local version="$1"
  local url="https://www.cloudflare.com/ips-${version}"
  local fetched=""
  if command -v curl > /dev/null 2>&1; then
    fetched="$(curl -fsSL --connect-timeout 5 --max-time 10 "$url" 2> /dev/null || true)"
  fi
  if [ -n "$fetched" ]; then
    printf '%s\n' "$fetched"
  elif [ "$version" = "v4" ]; then
    printf '%s\n' "${FALLBACK_CF_IPV4[@]}"
  else
    printf '%s\n' "${FALLBACK_CF_IPV6[@]}"
  fi
}

configure_linux_ufw() {
  log_info "Configuring UFW Zero-Trust Cloudflare-only incoming firewall (ports 22, 80, 443)"
  sudo ufw default deny incoming
  sudo ufw default allow outgoing

  # Allow Zero-Trust mesh & tunnel interfaces (Tailscale, WireGuard, Cloudflare WARP)
  for iface in tailscale0 wg0 CloudflareWARP; do
    sudo ufw allow in on "$iface" > /dev/null 2>&1 || true
  done

  while IFS= read -r cidr; do
    [ -n "$cidr" ] || continue
    sudo ufw allow proto tcp from "$cidr" to any port 22,80,443 comment 'Cloudflare Edge IPv4' > /dev/null 2>&1 || true
    sudo ufw allow proto udp from "$cidr" to any port 443 comment 'Cloudflare Edge QUIC IPv4' > /dev/null 2>&1 || true
  done < <(fetch_cloudflare_ips v4)

  while IFS= read -r cidr6; do
    [ -n "$cidr6" ] || continue
    sudo ufw allow proto tcp from "$cidr6" to any port 22,80,443 comment 'Cloudflare Edge IPv6' > /dev/null 2>&1 || true
    sudo ufw allow proto udp from "$cidr6" to any port 443 comment 'Cloudflare Edge QUIC IPv6' > /dev/null 2>&1 || true
  done < <(fetch_cloudflare_ips v6)

  sudo ufw --force enable
  log_info "UFW enabled: incoming traffic restricted to Cloudflare Edge CIDRs and Zero-Trust interfaces"
}

configure_linux_nftables() {
  log_info "Configuring nftables Zero-Trust Cloudflare-only incoming firewall (ports 22, 80, 443)"
  local v4_list v6_list tmp_nft
  v4_list="$(fetch_cloudflare_ips v4 | paste -sd, -)"
  v6_list="$(fetch_cloudflare_ips v6 | paste -sd, -)"
  tmp_nft="$(mktemp)"
  trap 'rm -f "$tmp_nft"' EXIT
  cat > "$tmp_nft" <<EOF
table inet cloudflare_zero_trust {
  set cf_ipv4 {
    type ipv4_addr
    flags interval
    elements = { ${v4_list} }
  }
  set cf_ipv6 {
    type ipv6_addr
    flags interval
    elements = { ${v6_list} }
  }
  chain input {
    type filter hook input priority 0; policy drop;
    iifname { "lo", "tailscale0", "wg0", "CloudflareWARP" } accept
    ct state established,related accept
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
    ip saddr @cf_ipv4 tcp dport { 22, 80, 443 } accept
    ip saddr @cf_ipv4 udp dport { 443 } accept
    ip6 saddr @cf_ipv6 tcp dport { 22, 80, 443 } accept
    ip6 saddr @cf_ipv6 udp dport { 443 } accept
  }
}
EOF
  sudo mkdir -p /etc/nftables.d
  sudo cp -f "$tmp_nft" /etc/nftables.d/cloudflare-zero-trust.nft
  sudo nft -f /etc/nftables.d/cloudflare-zero-trust.nft || log_warn "nft apply skipped (kernel module unavailable in container)"
}

configure_darwin_pf() {
  log_info "Configuring macOS Packet Filter (pf) Cloudflare-only incoming anchor (/etc/pf.anchors/com.install.doctor)"
  local tmp_pf
  tmp_pf="$(mktemp)"
  trap 'rm -f "$tmp_pf"' EXIT
  {
    printf '# Generated by install.doctor cloudflare-firewall\n'
    printf 'table <cloudflare> persist {\n'
    while IFS= read -r cidr; do
      [ -n "$cidr" ] && printf '  %s\n' "$cidr"
    done < <(fetch_cloudflare_ips v4)
    while IFS= read -r cidr6; do
      [ -n "$cidr6" ] && printf '  %s\n' "$cidr6"
    done < <(fetch_cloudflare_ips v6)
    printf '}\n'
    printf 'set skip on lo0\n'
    printf 'pass in quick on { utun0, utun1, utun2, utun3, utun4 } all\n'
    printf 'block in quick proto tcp from !<cloudflare> to any port { 22, 80, 443 }\n'
    printf 'pass in proto tcp from <cloudflare> to any port { 22, 80, 443 } keep state\n'
  } > "$tmp_pf"
  sudo mkdir -p /etc/pf.anchors
  sudo cp -f "$tmp_pf" /etc/pf.anchors/com.install.doctor
  sudo chmod 0644 /etc/pf.anchors/com.install.doctor
  if [ -f /etc/pf.conf ] && ! grep -q 'com.install.doctor' /etc/pf.conf 2> /dev/null; then
    printf '\nanchor "com.install.doctor"\nload anchor "com.install.doctor" from "/etc/pf.anchors/com.install.doctor"\n' | sudo tee -a /etc/pf.conf > /dev/null
  fi
  sudo pfctl -ef /etc/pf.conf > /dev/null 2>&1 || sudo pfctl -f /etc/pf.conf > /dev/null 2>&1 || true
  # Also enable macOS Application Firewall & Stealth Mode
  if [ -x /usr/libexec/ApplicationFirewall/socketfilterfw ]; then
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on > /dev/null 2>&1 || true
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on > /dev/null 2>&1 || true
  fi
  log_info "macOS pf anchor com.install.doctor loaded (ports 22, 80, 443 restricted to Cloudflare CIDRs)"
}

main() {
  if [ "${1:-}" = "--print-cidrs" ]; then
    fetch_cloudflare_ips v4
    fetch_cloudflare_ips v6
    exit 0
  fi
  if [ -d /Applications ] && [ -d /System ]; then
    configure_darwin_pf
  elif command -v ufw > /dev/null 2>&1; then
    configure_linux_ufw
  elif command -v nft > /dev/null 2>&1; then
    configure_linux_nftables
  else
    log_warn "No supported firewall binary (ufw, nft, pfctl) found on this host"
  fi
}

main "$@"
