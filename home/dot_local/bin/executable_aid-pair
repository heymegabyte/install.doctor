#!/usr/bin/env bash
# Compatibility entrypoint only. It delegates without copying or moving device state.
set -uo pipefail

printf 'aid-pair: deprecated compatibility alias; use desktop-tools-pair\n' >&2

resolve_desktop_tools_pair() {
  if [ -n "${DESKTOP_TOOLS_PAIR_BIN:-}" ] && [ -x "$DESKTOP_TOOLS_PAIR_BIN" ]; then
    printf '%s\n' "$DESKTOP_TOOLS_PAIR_BIN"
  elif command -v desktop-tools-pair >/dev/null 2>&1; then
    command -v desktop-tools-pair
  elif [ -x "$HOME/.local/bin/desktop-tools-pair" ]; then
    printf '%s\n' "$HOME/.local/bin/desktop-tools-pair"
  elif [ -x "$(dirname "$0")/executable_desktop-tools-pair" ]; then
    printf '%s\n' "$(dirname "$0")/executable_desktop-tools-pair"
  else
    return 1
  fi
}

desktop_tools_pair_bin="$(resolve_desktop_tools_pair)" || {
  printf 'aid-pair: desktop-tools-pair is not installed; run the Desktop Tools bootstrap\n' >&2
  exit 127
}
exec "$desktop_tools_pair_bin" "$@"
