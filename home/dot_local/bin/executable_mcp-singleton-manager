#!/usr/bin/env bash
set -euo pipefail

label="space.megabyte.mcp-singletons"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/mcp-singletons"
config_root="${XDG_CONFIG_HOME:-$HOME/.config}/mcp-singletons"
detected_platform="${MCP_SINGLETON_PLATFORM:-$(case "$(uname -s)" in Darwin) printf darwin ;; Linux) printf linux ;; *) printf unknown ;; esac)}"
if test "$detected_platform" = linux; then
  socket_root="${MCP_SINGLETON_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mcp-singletons}"
else
  socket_root="$state_root/sockets"
fi
config_path="$config_root/config.json"
plist="$HOME/Library/LaunchAgents/$label.plist"
systemd_unit_name="mcp-singletons.service"
systemd_unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
systemd_unit="$systemd_unit_dir/$systemd_unit_name"
broker="${MCP_SINGLETON_BROKER:-$HOME/.local/bin/mcp-singleton-broker.mjs}"
runner="${MCP_SINGLETON_RUNNER:-$HOME/.agentskills/mcp-servers/paperclip-mcp-stdio-runner.mjs}"
node_bin="${MCP_SINGLETON_NODE:-$(command -v node || true)}"
default_services="cloudflare-mcp langfuse-mcp paperclip-control-plane-mcp theme-tools-mcp voicekit-mcp"
read -r -a services <<<"${MCP_SINGLETON_SERVICES:-$default_services}"
host_id="${MCP_SINGLETON_HOST_ID:-$(hostname -f 2>/dev/null || hostname)}"
linger_policy="${MCP_SINGLETON_LINGER_POLICY:-forbid}"

die() { printf 'mcp-singleton-manager: %s\n' "$*" >&2; exit 1; }
require_paths() { test -x "$node_bin" || die "node unavailable"; test -f "$broker" || die "broker unavailable: $broker"; test -f "$runner" || die "runner unavailable: $runner"; }
case "$host_id" in ''|*[!A-Za-z0-9._-]*) die "invalid MCP_SINGLETON_HOST_ID" ;; esac
case "$linger_policy" in forbid|authorized-headless) ;; *) die "invalid MCP_SINGLETON_LINGER_POLICY" ;; esac

platform() {
  if test -n "${MCP_SINGLETON_PLATFORM:-}"; then
    case "$MCP_SINGLETON_PLATFORM" in darwin|linux) printf '%s\n' "$MCP_SINGLETON_PLATFORM"; return ;; *) die "invalid MCP_SINGLETON_PLATFORM" ;; esac
  fi
  case "$(uname -s)" in
    Darwin) printf 'darwin\n' ;;
    Linux) printf 'linux\n' ;;
    *) die "unsupported platform: $(uname -s)" ;;
  esac
}

render_config() {
  require_paths
  mkdir -p "$config_root" "$socket_root" "$state_root/logs"
  chmod 700 "$config_root" "$state_root" "$socket_root" "$state_root/logs"
  "$node_bin" - "$config_path" "$socket_root" "$node_bin" "$runner" "$host_id" "$(platform)" "$linger_policy" -- "${services[@]}" <<'NODE'
const fs = require('node:fs');
const [output, socketRoot, node, runner, hostId, platform, lingerPolicy, separator, ...services] = process.argv.slice(2);
if (separator !== '--') throw new Error('invalid singleton render arguments');
const config = { version: 1, hostContract: { hostId, platform, lingerPolicy }, runtimeDir: socketRoot, services: {} };
for (const id of services) config.services[id] = { socket: `${socketRoot}/${id}.sock`, command: [node, runner, id] };
const temp = `${output}.${process.pid}.tmp`;
fs.writeFileSync(temp, `${JSON.stringify(config, null, 2)}\n`, { mode: 0o600 });
fs.renameSync(temp, output);
fs.chmodSync(output, 0o600);
NODE
}

configured_linger_policy() {
  "$node_bin" -e 'const c=require(process.argv[1]); process.stdout.write(c.hostContract?.lingerPolicy ?? "forbid")' "$config_path"
}

validate_linux_linger() {
  test "$(platform)" = linux || return 0
  command -v loginctl >/dev/null || die "loginctl unavailable for linger policy validation"
  local actual policy
  actual="$(loginctl show-user "$(id -u)" -p Linger --value 2>/dev/null || true)"
  policy="$(configured_linger_policy)"
  case "$actual:$policy" in
    yes:authorized-headless|no:forbid) ;;
    yes:forbid) die "Linger=yes requires MCP_SINGLETON_LINGER_POLICY=authorized-headless" ;;
    no:authorized-headless) die "authorized-headless profile requires Linger=yes" ;;
    *) die "unable to validate user linger state" ;;
  esac
}

render_plist() {
  mkdir -p "$(dirname "$plist")"
  local temp="$plist.$$.tmp"
  cat >"$temp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>$node_bin</string><string>$broker</string><string>--config</string><string>$config_path</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>XDG_CONFIG_HOME</key><string>$HOME/.config</string>
    <key>XDG_STATE_HOME</key><string>$HOME/.local/state</string>
  </dict>
  <key>StandardOutPath</key><string>$state_root/logs/stdout.log</string>
  <key>StandardErrorPath</key><string>$state_root/logs/stderr.log</string>
</dict></plist>
EOF
  plutil -lint "$temp" >/dev/null
  mv "$temp" "$plist"
  chmod 600 "$plist"
}

render_systemd_unit() {
  mkdir -p "$systemd_unit_dir"
  chmod 700 "$systemd_unit_dir"
  local temp="$systemd_unit.$$.tmp"
  umask 077
  printf '%s\n' \
    '[Unit]' \
    'Description=Megabyte per-user MCP singleton broker' \
    'After=network.target' \
    '' \
    '[Service]' \
    'Type=simple' \
    "ExecStart=$node_bin $broker --config $config_path" \
    'Restart=on-failure' \
    'RestartSec=2' \
    'UMask=0077' \
    'RuntimeDirectory=mcp-singletons' \
    'RuntimeDirectoryMode=0700' \
    "Environment=HOME=$HOME" \
    "Environment=XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}" \
    "Environment=XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}" \
    'Environment=PATH=/usr/local/bin:/usr/bin:/bin' \
    'PrivateTmp=true' \
    'ProtectControlGroups=true' \
    'ProtectKernelTunables=true' \
    'ProtectSystem=strict' \
    'ReadWritePaths=%h/.config %h/.local/state %t/mcp-singletons' \
    '' \
    '[Install]' \
    'WantedBy=default.target' >"$temp"
  mv "$temp" "$systemd_unit"
  chmod 600 "$systemd_unit"
}

install_service() {
  render_config
  if test "$(platform)" = darwin; then
    render_plist
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    for _ in 1 2 3 4 5; do
      launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1 || break
      sleep 1
    done
    bootstrap_ok=0
    for _ in 1 2 3 4 5; do
      if launchctl bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1; then bootstrap_ok=1; break; fi
      sleep 1
    done
    test "$bootstrap_ok" = 1 || die "launchd bootstrap failed after bounded retry"
    launchctl kickstart -k "gui/$(id -u)/$label"
  else
    command -v systemctl >/dev/null || die "systemctl unavailable"
    render_systemd_unit
    validate_linux_linger
    systemctl --user daemon-reload
    systemctl --user enable --now "$systemd_unit_name"
  fi
  sleep 1
  status_service
}

status_service() {
  if test "$(platform)" = darwin; then
    launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1 || die "service not loaded"
  else
    validate_linux_linger
    systemctl --user is-active --quiet "$systemd_unit_name" || die "service not active"
    systemctl --user is-enabled --quiet "$systemd_unit_name" || die "service not enabled"
  fi
  ready=0
  attempt=0
  while test "$attempt" -lt 40; do
    attempt=$((attempt + 1))
    ready=1
    for service in "${services[@]}"; do test -S "$socket_root/$service.sock" || ready=0; done
    test "$ready" = 1 && break
    sleep 0.5
  done
  test "$ready" = 1 || die "singleton sockets did not become ready"
  "$node_bin" --input-type=module - "$config_path" <<'NODE'
import { readFileSync } from 'node:fs';
import { connect } from 'node:net';
const config = JSON.parse(readFileSync(process.argv[2], 'utf8'));
await Promise.all(Object.entries(config.services).map(async ([id, service]) => {
  let replies;
  let lastError;
  for (let attempt = 0; attempt < 20; attempt += 1) {
    try {
      replies = await new Promise((resolve, reject) => {
        const socket = connect(service.socket);
        const messages = new Map();
        let buffer = '';
        const timeout = setTimeout(() => { socket.destroy(); reject(new Error(`${id} probe timed out`)); }, 1000);
        socket.setEncoding('utf8');
        socket.on('connect', () => {
          socket.write(`${JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'initialize', params: { protocolVersion: '2024-11-05', capabilities: {}, clientInfo: { name: 'mcp-singleton-manager', version: '1' } } })}\n`);
          socket.write(`${JSON.stringify({ jsonrpc: '2.0', id: 2, method: 'tools/list', params: {} })}\n`);
        });
        socket.on('data', (chunk) => {
          buffer += chunk;
          for (;;) {
            const newline = buffer.indexOf('\n');
            if (newline < 0) break;
            const line = buffer.slice(0, newline);
            buffer = buffer.slice(newline + 1);
            if (!line) continue;
            const message = JSON.parse(line);
            messages.set(message.id, message);
            if (messages.has(1) && messages.has(2)) { clearTimeout(timeout); socket.end(); resolve(messages); }
          }
        });
        socket.on('error', reject);
      });
      break;
    } catch (error) {
      lastError = error;
      await new Promise((resolve) => setTimeout(resolve, 500));
    }
  }
  if (!replies) throw lastError ?? new Error(`${id} protocol probe failed`);
  if (replies.get(1)?.error || replies.get(2)?.error || !Array.isArray(replies.get(2)?.result?.tools)) throw new Error(`${id} protocol probe failed`);
}));
NODE
  printf 'mcp singleton broker ready: %s\n' "$label"
}

uninstall_service() {
  if test "$(platform)" = darwin; then
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    rm -f "$plist"
  else
    systemctl --user disable --now "$systemd_unit_name" >/dev/null 2>&1 || true
    rm -f "$systemd_unit"
    systemctl --user daemon-reload
  fi
  for service in "${services[@]}"; do rm -f "$socket_root/$service.sock"; done
  printf 'mcp singleton broker unloaded; configuration retained at %s\n' "$config_path"
}

case "${1:-status}" in
  install|start) install_service ;;
  status) status_service ;;
  restart) install_service ;;
  uninstall|rollback) uninstall_service ;;
  render)
    render_config
    if test "$(platform)" = darwin; then render_plist; printf '%s\n' "$plist"
    else render_systemd_unit; printf '%s\n' "$systemd_unit"; fi
    ;;
  *) die "usage: mcp-singleton-manager {install|status|restart|rollback|render}" ;;
esac

