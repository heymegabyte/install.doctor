#!/usr/bin/env bash
set -euo pipefail

logical_identity="tools.theme.oneprompt.converge"
legacy_identity="com.heymegabyte.oneprompt-convergence"
package_name="@theme.tools/workflows"
package_version="1.0.0"
artifact_sha256="bcdbac76045a97091e864915e52fb2fe588a3c0711f067f583ac053f0d24a0fb"
state_schema_version="2"
state_root="${ONEPROMPT_CONVERGENCE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/oneprompt-convergence}"
config_root="$state_root/host-adapter"
recovery_root="$state_root/recovery"
log_file="$state_root/controller.log"

die() { printf 'oneprompt-convergence-supervisor: %s\n' "$*" >&2; exit 64; }
validate_path() { case "$1" in /*) ;; *) die "path must be absolute: $1" ;; esac; case "$1" in *$'\n'*|*$'\r'*) die "path contains a line break" ;; esac; }
sha256() { shasum -a 256 "$1" | awk '{print $1}'; }
json_string() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n'; }
manager() { if test -n "${ONEPROMPT_SUPERVISOR_MANAGER:-}"; then printf '%s\n' "$ONEPROMPT_SUPERVISOR_MANAGER"; elif test "$(uname -s)" = Darwin && command -v launchctl >/dev/null; then printf launchd; elif command -v systemctl >/dev/null; then printf systemd; else printf unsupported; fi; }
write_atomic() { local dst="$1" tmp; mkdir -p "$(dirname "$dst")"; chmod 700 "$(dirname "$dst")"; tmp="$(mktemp "$(dirname "$dst")/.oneprompt.XXXXXX")"; cat >"$tmp"; chmod 600 "$tmp"; if test -f "$dst" && cmp -s "$tmp" "$dst"; then rm -f "$tmp"; else mv -f "$tmp" "$dst"; fi; }
canonical_repo() { validate_path "$1"; test -d "$1" || die "repository does not exist: $1"; (cd "$1" && pwd -P); }
repo_revision() { git -C "$1" rev-parse HEAD 2>/dev/null || die "repository must be an immutable git checkout"; }

read_config() {
  test -r "$config_root/config" || die "service is not installed by install.doctor"
  # shellcheck disable=SC1090
  . "$config_root/config"
}
definition_path_for() { if test "$1" = launchd; then printf '%s/Library/LaunchAgents/%s.plist\n' "$HOME" "$logical_identity"; else printf '%s/.config/systemd/user/%s.service\n' "$HOME" "$logical_identity"; fi; }
legacy_definition_for() { if test "$1" = launchd; then printf '%s/Library/LaunchAgents/%s.plist\n' "$HOME" "$legacy_identity"; else printf '%s/.config/systemd/user/oneprompt-convergence.service\n' "$HOME"; fi; }
timer_path() { printf '%s/.config/systemd/user/%s.timer\n' "$HOME" "$logical_identity"; }
manager_active() { if test "$configured_manager" = launchd; then launchctl print "gui/$(id -u)/$logical_identity" >/dev/null 2>&1; else systemctl --user is-active --quiet "$logical_identity.service"; fi; }
manager_stop() { if test "$configured_manager" = launchd; then launchctl bootout "gui/$(id -u)/$logical_identity" >/dev/null 2>&1 || true; else systemctl --user disable --now "$logical_identity.timer" >/dev/null 2>&1 || true; systemctl --user stop "$logical_identity.service" >/dev/null 2>&1 || true; fi; }
manager_start() { if test "$configured_manager" = launchd; then launchctl print "gui/$(id -u)/$logical_identity" >/dev/null 2>&1 || launchctl bootstrap "gui/$(id -u)" "$configured_definition"; launchctl kickstart "gui/$(id -u)/$logical_identity"; else systemctl --user daemon-reload; systemctl --user enable --now "$logical_identity.timer"; fi; }

machine_call() {
  local operation="$1" mode="forbid" result
  test "$operation" = install && mode=safe
  result="$(env ONEPROMPT_CONVERGENCE_STATE_DIR="$state_root" "$configured_machine" "$operation" --json --migration-mode "$mode")" || die "controller machine interface failed for $operation"
  node -e 'const x=JSON.parse(process.argv[1]); if (!x || typeof x!=="object") process.exit(1)' "$result" || die "controller machine interface returned invalid JSON"
  printf '%s\n' "$result"
}

verify_artifacts() {
  read_config
  test "$(repo_revision "$configured_repo")" = "$configured_revision" || die "OnePrompt repository revision drift"
  test "$(sha256 "$configured_machine")" = "$configured_machine_sha256" || die "machine-interface digest drift"
  test "$configured_package_name" = "$package_name" || die "shared package name drift"
  test "$configured_package_version" = "$package_version" || die "shared package version drift"
  test "$configured_artifact_sha256" = "$artifact_sha256" || die "shared package artifact digest drift"
  test "$configured_state_schema_version" = "$state_schema_version" || die "state schema version drift"
  test -f "$configured_definition" || die "service definition is missing"
  test "$(sha256 "$configured_definition")" = "$configured_definition_sha256" || die "service definition digest drift"
}

render_definition() {
  local manager_name="$1" repo="$2" worker="$3" definition="$4"
  if test "$manager_name" = launchd; then
    write_atomic "$definition" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict><key>Label</key><string>$logical_identity</string><key>ProgramArguments</key><array><string>$(command -v node)</string><string>$worker</string></array><key>WorkingDirectory</key><string>$repo</string><key>EnvironmentVariables</key><dict><key>HOME</key><string>$HOME</string><key>ONEPROMPT_CONVERGENCE_STATE_DIR</key><string>$state_root</string></dict><key>RunAtLoad</key><false/><key>KeepAlive</key><false/><key>StandardOutPath</key><string>$log_file</string><key>StandardErrorPath</key><string>$log_file</string></dict></plist>
EOF
  else
    write_atomic "$definition" <<EOF
[Unit]
Description=OnePrompt bounded convergence controller
[Service]
Type=exec
WorkingDirectory=$repo
ExecStart=$(command -v node) $worker
Environment=ONEPROMPT_CONVERGENCE_STATE_DIR=$state_root
Restart=no
TimeoutStopSec=3
[Install]
WantedBy=default.target
EOF
    write_atomic "$(timer_path)" <<EOF
[Unit]
Description=Wake OnePrompt bounded convergence
[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
Persistent=true
Unit=$logical_identity.service
[Install]
WantedBy=timers.target
EOF
  fi
}

install_service() {
  local repo_arg="" machine_arg="" expected_revision="" service_manager repo worker definition observed_revision machine_hash definition_hash legacy
  while test "$#" -gt 0; do case "$1" in --repo) repo_arg="$2"; shift 2;; --machine-interface) machine_arg="$2"; shift 2;; --revision) expected_revision="$2"; shift 2;; *) die "unknown install option: $1";; esac; done
  test -n "$repo_arg" && test -n "$machine_arg" && test -n "$expected_revision" || die "install requires --repo, --machine-interface, and --revision"
  repo="$(canonical_repo "$repo_arg")"; validate_path "$machine_arg"; machine_arg="$(cd "$(dirname "$machine_arg")" && pwd -P)/$(basename "$machine_arg")"; test -x "$machine_arg" || die "machine interface is not executable"
  observed_revision="$(repo_revision "$repo")"; test "$observed_revision" = "$expected_revision" || die "requested revision does not match checkout"
  worker="$repo/scripts/convergence-worker.mjs"; test -f "$worker" || die "worker is missing: $worker"
  service_manager="$(manager)"; case "$service_manager" in launchd|systemd) ;; *) die "no supported user service manager";; esac
  definition="$(definition_path_for "$service_manager")"; legacy="$(legacy_definition_for "$service_manager")"
  test ! -e "$legacy" || die "legacy definition exists; use adopt-plan/adopt"
  if test -e "$definition" && test ! -r "$config_root/config"; then die "unmanaged canonical definition exists"; fi
  configured_machine="$machine_arg"; machine_call install >/dev/null
  render_definition "$service_manager" "$repo" "$worker" "$definition"
  machine_hash="$(sha256 "$machine_arg")"; definition_hash="$(sha256 "$definition")"
  write_atomic "$config_root/config" <<EOF
configured_repo='$repo'
configured_revision='$observed_revision'
configured_machine='$machine_arg'
configured_machine_sha256='$machine_hash'
configured_package_name='$package_name'
configured_package_version='$package_version'
configured_artifact_sha256='$artifact_sha256'
configured_state_schema_version='$state_schema_version'
configured_manager='$service_manager'
configured_identity='$logical_identity'
configured_definition='$definition'
configured_definition_sha256='$definition_hash'
adoption_state='native'
EOF
  printf 'installed inert %s definition for %s\n' "$service_manager" "$repo"
}

status_service() {
  read_config; local controller manager_state compatible=true
  controller="$(machine_call status)" || exit $?
  if manager_active; then manager_state=active; else manager_state=inactive; fi
  verify_artifacts >/dev/null 2>&1 || compatible=false
  node -e 'const c=JSON.parse(process.argv[1]); console.log(JSON.stringify({schemaVersion:2,logicalIdentity:process.argv[2],packageName:process.argv[3],packageVersion:process.argv[4],artifactSha256:process.argv[5],stateSchemaVersion:2,manager:process.argv[6],managerState:process.argv[7],artifactCompatible:process.argv[8]==="true",adoptionState:process.argv[9],controller:c,healthy:process.argv[8]==="true"&&process.argv[7]==="active"&&c.desiredMode==="running"&&c.workerLiveness==="live"&&c.heartbeatFreshness==="fresh"}))' "$controller" "$logical_identity" "$package_name" "$package_version" "$artifact_sha256" "$configured_manager" "$manager_state" "$compatible" "$adoption_state"
}

pause_service() { read_config; machine_call pause >/dev/null; manager_stop; }
stop_service() { read_config; machine_call stop >/dev/null; manager_stop; }
start_service() { verify_artifacts; local s; s="$(machine_call status)"; node -e 'const s=JSON.parse(process.argv[1]); if(s.desiredMode!=="running") process.exit(1)' "$s" || die "durable intent is not running; use resume"; manager_start; }
resume_service() { verify_artifacts; machine_call resume >/dev/null; manager_start; }
verify_service() { verify_artifacts; machine_call verify >/dev/null; printf 'verified %s (%s)\n' "$logical_identity" "$configured_manager"; }
run_worker() { verify_artifacts; exec node "$configured_repo/scripts/convergence-worker.mjs"; }

adopt_plan() {
  local m legacy canonical
  m="$(manager)"; legacy="$(legacy_definition_for "$m")"; canonical="$(definition_path_for "$m")"
  printf '{"schemaVersion":1,"logicalIdentity":"%s","legacyDefinition":"%s","canonicalDefinition":"%s","legacyPresent":%s,"canonicalPresent":%s,"mutationPerformed":false}\n' "$logical_identity" "$(json_string "$legacy")" "$(json_string "$canonical")" "$(test -e "$legacy" && printf true || printf false)" "$(test -e "$canonical" && printf true || printf false)"
}

uninstall_service() { read_config; machine_call stop >/dev/null; manager_stop; test "$(sha256 "$configured_definition")" = "$configured_definition_sha256" || die "refusing to remove changed definition"; rm -f "$configured_definition"; test "$configured_manager" != systemd || rm -f "$(timer_path)"; rm -f "$config_root/config"; printf 'removed managed definition; stopped state retained\n'; }
show_logs() { test -f "$log_file" && tail -n "${ONEPROMPT_LOG_LINES:-200}" "$log_file" || printf 'no controller log at %s\n' "$log_file"; }

command="${1:-}"; test -n "$command" || die "usage: install|start|status|logs|pause|resume|stop|verify|run|adopt-plan|uninstall"; shift
case "$command" in install) install_service "$@";; start) start_service;; status) status_service;; logs) show_logs;; pause) pause_service;; resume) resume_service;; stop) stop_service;; verify) verify_service;; run) run_worker;; adopt-plan) adopt_plan;; uninstall) uninstall_service;; *) die "unknown command: $command";; esac
