#!/usr/bin/env bash
# shellcheck disable=SC2154
set -euo pipefail

logical_identity="tools.theme.oneprompt.converge"
legacy_identity="com.heymegabyte.oneprompt-convergence"
package_name="@theme.tools/workflows"
package_version="1.0.0"
artifact_sha256="ecdd6446a0c3aae7574514a1959f24bd83a6ff02e8f81ae9e012dd6af6dd216c"
oneprompt_revision="3f16807c6dcf6272b64e9ae59342192a185096ea"
state_schema_version="2"
state_root="${ONEPROMPT_CONVERGENCE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/oneprompt-convergence}"
config_root="$state_root/host-adapter"
recovery_root="$state_root/recovery"
log_file="$state_root/controller.log"

die() { printf 'oneprompt-convergence-supervisor: %s\n' "$*" >&2; exit 64; }
validate_path() { case "$1" in /*) ;; *) die "path must be absolute: $1" ;; esac; case "$1" in *$'\n'*|*$'\r'*|*$'\t'*|*"'"*|*'"'*|*'<'*|*'>'*|*'&'*) die "path contains unsafe characters" ;; esac; }
sha256() { shasum -a 256 "$1" | awk '{print $1}'; }
json_string() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n'; }
manager() { if test -n "${ONEPROMPT_SUPERVISOR_MANAGER:-}"; then printf '%s\n' "$ONEPROMPT_SUPERVISOR_MANAGER"; elif test "$(uname -s)" = Darwin && command -v launchctl >/dev/null; then printf launchd; elif command -v systemctl >/dev/null; then printf systemd; else printf unsupported; fi; }
write_atomic() { local dst="$1" tmp; mkdir -p "$(dirname "$dst")"; chmod 700 "$(dirname "$dst")"; tmp="$(mktemp "$(dirname "$dst")/.oneprompt.XXXXXX")"; cat >"$tmp"; chmod 600 "$tmp"; if test -f "$dst" && cmp -s "$tmp" "$dst"; then rm -f "$tmp"; else mv -f "$tmp" "$dst"; fi; }
canonical_repo() { validate_path "$1"; test -d "$1" || die "repository does not exist: $1"; (cd "$1" && pwd -P); }
repo_revision() { git -C "$1" rev-parse HEAD 2>/dev/null || die "repository must be an immutable git checkout"; }

read_config() {
  test -r "$config_root/config" || die "service is not installed by install.doctor"
  # The validated, mode-0600 adapter-owned file defines the configured_* contract.
  # shellcheck disable=SC1090,SC1091,SC2154
  . "$config_root/config"
}
definition_path_for() { if test "$1" = launchd; then printf '%s/Library/LaunchAgents/%s.plist\n' "$HOME" "$logical_identity"; else printf '%s/.config/systemd/user/%s.service\n' "$HOME" "$logical_identity"; fi; }
legacy_definition_for() { if test "$1" = launchd; then printf '%s/Library/LaunchAgents/%s.plist\n' "$HOME" "$legacy_identity"; else printf '%s/.config/systemd/user/oneprompt-convergence.service\n' "$HOME"; fi; }
timer_path() { printf '%s/.config/systemd/user/%s.timer\n' "$HOME" "$logical_identity"; }
manager_active() { if test "$configured_manager" = launchd; then launchctl print "gui/$(id -u)/$logical_identity" 2>/dev/null | grep -Eq 'state = running|[[:space:]]pid = [0-9]+'; else systemctl --user is-active --quiet "$logical_identity.service"; fi; }
manager_loaded() { if test "$configured_manager" = launchd; then launchctl print "gui/$(id -u)/$logical_identity" >/dev/null 2>&1; else systemctl --user is-enabled --quiet "$logical_identity.timer" 2>/dev/null; fi; }
manager_stop() { if test "$configured_manager" = launchd; then launchctl bootout "gui/$(id -u)/$logical_identity" >/dev/null 2>&1 || true; else systemctl --user disable --now "$logical_identity.timer" >/dev/null 2>&1 || true; systemctl --user stop "$logical_identity.service" >/dev/null 2>&1 || true; fi; }
manager_start() { if test "$configured_manager" = launchd; then launchctl print "gui/$(id -u)/$logical_identity" >/dev/null 2>&1 || launchctl bootstrap "gui/$(id -u)" "$configured_definition"; launchctl kickstart "gui/$(id -u)/$logical_identity"; else systemctl --user daemon-reload; systemctl --user enable --now "$logical_identity.timer"; fi; }

machine_call() {
  local operation="$1" mode="forbid" result
  test "$operation" = install && mode=safe
  result="$(env ONEPROMPT_CONVERGENCE_STATE_DIR="$state_root" "$configured_machine" "$operation" --json --migration-mode "$mode")" || die "controller machine interface failed for $operation"
  node -e 'const x=JSON.parse(process.argv[1]); if (!x || typeof x!=="object") process.exit(1)' "$result" || die "controller machine interface returned invalid JSON"
  printf '%s\n' "$result"
}

verify_artifacts() {
  read_config
  test ! -e "$(legacy_definition_for "$configured_manager")" || die "competing legacy service definition exists"
  test "$(repo_revision "$configured_repo")" = "$configured_revision" || die "OnePrompt repository revision drift"
  test "$(sha256 "$configured_machine")" = "$configured_machine_sha256" || die "machine-interface digest drift"
  test "$configured_package_name" = "$package_name" || die "shared package name drift"
  test "$configured_package_version" = "$package_version" || die "shared package version drift"
  test "$configured_artifact_sha256" = "$artifact_sha256" || die "shared package artifact digest drift"
  test "$configured_state_schema_version" = "$state_schema_version" || die "state schema version drift"
  test -f "$configured_definition" || die "service definition is missing"
  test "$(sha256 "$configured_definition")" = "$configured_definition_sha256" || die "service definition digest drift"
}

render_definition() {
  local manager_name="$1" repo="$2" worker="$3" definition="$4" node_path
  node_path="$(dirname "$(command -v node)"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  if test "$manager_name" = launchd; then
    write_atomic "$definition" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict><key>Label</key><string>$logical_identity</string><key>ProgramArguments</key><array><string>$(command -v node)</string><string>$worker</string></array><key>WorkingDirectory</key><string>$repo</string><key>EnvironmentVariables</key><dict><key>HOME</key><string>$HOME</string><key>PATH</key><string>$node_path</string><key>ONEPROMPT_CONVERGENCE_STATE_DIR</key><string>$state_root</string></dict><key>RunAtLoad</key><false/><key>KeepAlive</key><false/><key>StartInterval</key><integer>900</integer><key>StandardOutPath</key><string>$log_file</string><key>StandardErrorPath</key><string>$log_file</string></dict></plist>
EOF
  else
    write_atomic "$definition" <<EOF
[Unit]
Description=OnePrompt bounded convergence controller
[Service]
Type=exec
WorkingDirectory=$repo
ExecStart=$(command -v node) $worker
Environment=ONEPROMPT_CONVERGENCE_STATE_DIR=$state_root
Restart=no
TimeoutStopSec=3
[Install]
WantedBy=default.target
EOF
    write_atomic "$(timer_path)" <<EOF
[Unit]
Description=Wake OnePrompt bounded convergence
[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
Persistent=true
Unit=$logical_identity.service
[Install]
WantedBy=timers.target
EOF
  fi
}

install_service() {
  local repo_arg="" machine_arg="" expected_revision="" service_manager repo worker definition observed_revision machine_hash definition_hash legacy prior_adoption=native prior_predecessor="" prior_recovery="" replace_repo=false replacement_bundle=""
  while test "$#" -gt 0; do case "$1" in --repo) repo_arg="$2"; shift 2;; --machine-interface) machine_arg="$2"; shift 2;; --revision) expected_revision="$2"; shift 2;; --replace-repo) replace_repo=true; shift;; *) die "unknown install option: $1";; esac; done
  test -n "$repo_arg" && test -n "$machine_arg" && test -n "$expected_revision" || die "install requires --repo, --machine-interface, and --revision"
  test "$expected_revision" = "$oneprompt_revision" || die "unsupported OnePrompt revision"
  repo="$(canonical_repo "$repo_arg")"; validate_path "$machine_arg"; machine_arg="$(cd "$(dirname "$machine_arg")" && pwd -P)/$(basename "$machine_arg")"; test -x "$machine_arg" || die "machine interface is not executable"
  observed_revision="$(repo_revision "$repo")"; test "$observed_revision" = "$expected_revision" || die "requested revision does not match checkout"
  worker="$repo/scripts/convergence-worker.mjs"; test -f "$worker" || die "worker is missing: $worker"
  service_manager="$(manager)"; case "$service_manager" in launchd|systemd) ;; *) die "no supported user service manager";; esac
  definition="$(definition_path_for "$service_manager")"; legacy="$(legacy_definition_for "$service_manager")"
  test ! -e "$legacy" || die "legacy definition exists; use adopt-plan/adopt"
  if test -r "$config_root/config"; then
    read_config
    if test "$configured_repo" != "$repo" || test "$configured_machine" != "$machine_arg"; then
      test "$replace_repo" = true || die "installed service identity differs from requested installation"
      verify_artifacts
      manager_active && die "cannot replace repository while the supervisor is active"
      local controller_status
      controller_status="$(machine_call status)"
      node -e '
        const s=JSON.parse(process.argv[1]);
        if(!["idle","paused","stopped"].includes(s.desiredMode) || s.processObservation==="alive") process.exit(1);
      ' "$controller_status" || die "repository replacement requires idle/paused/stopped durable intent and no live worker"
      replacement_bundle="$recovery_root/repository-repin-$(date -u +%Y%m%dT%H%M%SZ)-$$"
      mkdir -p "$replacement_bundle"; chmod 700 "$replacement_bundle"
      cp "$config_root/config" "$replacement_bundle/config"; cp "$configured_definition" "$replacement_bundle/definition"
      chmod 600 "$replacement_bundle/config" "$replacement_bundle/definition"
      node -e '
        const fs=require("node:fs");
        const out=process.argv[1], previousRepo=process.argv[2], previousRevision=process.argv[3], nextRepo=process.argv[4], nextRevision=process.argv[5];
        fs.writeFileSync(out, JSON.stringify({schemaVersion:1,kind:"repository-repin",previousRepo,previousRevision,nextRepo,nextRevision,createdAt:new Date().toISOString()},null,2)+"\n", {mode:0o600});
      ' "$replacement_bundle/manifest.json" "$configured_repo" "$configured_revision" "$repo" "$observed_revision"
    fi
    test "$configured_identity" = "$logical_identity" && test "$configured_package_name" = "$package_name" && test "$configured_package_version" = "$package_version" && test "$configured_state_schema_version" = "$state_schema_version" || die "installed service contract differs from requested installation"
    [[ "$configured_artifact_sha256" =~ ^[0-9a-f]{64}$ ]] || die "installed artifact identity is malformed"
    test "$(sha256 "$configured_machine")" = "$configured_machine_sha256" || die "machine interface drift"
    test "$(sha256 "$configured_definition")" = "$configured_definition_sha256" || die "service definition drift"
    prior_adoption="$adoption_state"
    prior_predecessor="${predecessor_kind:-}"
    prior_recovery="${recovery_bundle:-}"
  fi
  if test -e "$definition" && test ! -r "$config_root/config"; then die "unmanaged canonical definition exists"; fi
  node "$repo/scripts/verify-convergence-artifact.mjs" >/dev/null || die "requested shared artifact failed repository verification"
  configured_machine="$machine_arg"; machine_call install >/dev/null
  if test -r "$config_root/config" && manager_loaded; then manager_stop; fi
  render_definition "$service_manager" "$repo" "$worker" "$definition"
  machine_hash="$(sha256 "$machine_arg")"; definition_hash="$(sha256 "$definition")"
  write_atomic "$config_root/config" <<EOF
configured_repo='$repo'
configured_revision='$observed_revision'
configured_machine='$machine_arg'
configured_machine_sha256='$machine_hash'
configured_package_name='$package_name'
configured_package_version='$package_version'
configured_artifact_sha256='$artifact_sha256'
configured_state_schema_version='$state_schema_version'
configured_manager='$service_manager'
configured_identity='$logical_identity'
configured_definition='$definition'
configured_definition_sha256='$definition_hash'
adoption_state='native'
EOF
  if test "$prior_adoption" = adopted; then
    printf "adoption_state='adopted'\npredecessor_kind='%s'\nrecovery_bundle='%s'\n" "$prior_predecessor" "$prior_recovery" >>"$config_root/config"
  fi
  if test -n "$replacement_bundle"; then printf "repository_repin_bundle='%s'\n" "$replacement_bundle" >>"$config_root/config"; fi
  printf 'installed inert %s definition for %s\n' "$service_manager" "$repo"
}

status_service() {
  read_config; local controller manager_state compatible=true
  controller="$(machine_call status)" || exit $?
  if manager_active; then
    manager_state=active
  elif manager_loaded; then
    manager_state=scheduled
  else
    manager_state=inactive
  fi
  verify_artifacts >/dev/null 2>&1 || compatible=false
  node -e '
    const c=JSON.parse(process.argv[1]);
    const managerState=process.argv[7];
    const artifactCompatible=process.argv[8]==="true";
    const activelyExecuting=managerState==="active"&&c.desiredMode==="running"&&c.workerLiveness==="healthy"&&c.heartbeatFreshness==="fresh"&&c.progressLiveness==="current"&&c.processObservation==="alive";
    const scheduledWaiting=managerState==="scheduled"&&c.desiredMode==="running"&&c.currentOwner===null&&c.workerLiveness==="waiting";
    console.log(JSON.stringify({schemaVersion:2,logicalIdentity:process.argv[2],packageName:process.argv[3],packageVersion:process.argv[4],artifactSha256:process.argv[5],stateSchemaVersion:2,manager:process.argv[6],managerState,artifactCompatible,adoptionState:process.argv[9],controller:c,healthy:artifactCompatible&&(activelyExecuting||scheduledWaiting)}));
  ' "$controller" "$logical_identity" "$package_name" "$package_version" "$artifact_sha256" "$configured_manager" "$manager_state" "$compatible" "$adoption_state"
}

pause_service() { read_config; machine_call pause >/dev/null; manager_stop; }
stop_service() { read_config; machine_call stop >/dev/null; manager_stop; }
start_service() { verify_artifacts; local s; s="$(machine_call status)"; node -e 'const s=JSON.parse(process.argv[1]); if(s.desiredMode!=="running") process.exit(1)' "$s" || die "durable intent is not running; use resume"; manager_start; }
resume_service() { verify_artifacts; machine_call resume >/dev/null; manager_start; }
verify_service() { verify_artifacts; machine_call verify >/dev/null; printf 'verified %s (%s)\n' "$logical_identity" "$configured_manager"; }
run_worker() { verify_artifacts; exec node "$configured_repo/scripts/convergence-worker.mjs"; }

adopt_plan() {
  local m legacy canonical
  m="$(manager)"; legacy="$(legacy_definition_for "$m")"; canonical="$(definition_path_for "$m")"
  printf '{"schemaVersion":1,"logicalIdentity":"%s","legacyDefinition":"%s","canonicalDefinition":"%s","legacyPresent":%s,"canonicalPresent":%s,"mutationPerformed":false}\n' "$logical_identity" "$(json_string "$legacy")" "$(json_string "$canonical")" "$(test -e "$legacy" && printf true || printf false)" "$(test -e "$canonical" && printf true || printf false)"
}

legacy_active() {
  local m="$1"
  if test "$m" = launchd; then launchctl print "gui/$(id -u)/$legacy_identity" 2>/dev/null | grep -Eq 'state = running|[[:space:]]pid = [0-9]+'
  else systemctl --user is-active --quiet oneprompt-convergence.service; fi
}

canonical_active() {
  local m="$1"
  if test "$m" = launchd; then launchctl print "gui/$(id -u)/$logical_identity" 2>/dev/null | grep -Eq 'state = running|[[:space:]]pid = [0-9]+'
  else systemctl --user is-active --quiet "$logical_identity.service"; fi
}

unload_canonical_predecessor() {
  local m="$1"
  if test "$m" = launchd; then launchctl bootout "gui/$(id -u)/$logical_identity" >/dev/null 2>&1 || true
  else systemctl --user disable --now "$logical_identity.timer" >/dev/null 2>&1 || true; systemctl --user stop "$logical_identity.service" >/dev/null 2>&1 || true; fi
}

verify_known_canonical_predecessor() {
  local m="$1" definition="$2" repo="$3" worker
  worker="$repo/scripts/convergence-worker.mjs"
  test "$m" = launchd || die "canonical predecessor adoption is currently supported only for launchd"
  command -v plutil >/dev/null || die "plutil is required to validate a canonical launchd predecessor"
  local serialized
  serialized="$(plutil -convert json -o - "$definition" 2>/dev/null)" || die "canonical predecessor is not a valid launchd property list"
  node -e '
    const value=JSON.parse(process.argv[1]);
    const expectedWorker=process.argv[2], expectedRepo=process.argv[3], expectedState=process.argv[4];
    const args=value.ProgramArguments;
    const env=value.EnvironmentVariables;
    const allowed=new Set(["Label","ProgramArguments","WorkingDirectory","EnvironmentVariables","RunAtLoad","StartInterval","ThrottleInterval","ProcessType","StandardOutPath","StandardErrorPath"]);
    const executable=Array.isArray(args) ? args[0] : "";
    const safeExecutable=typeof executable==="string" && executable.startsWith("/") && executable.split("/").at(-1)==="node";
    const safeEnvironment=env && typeof env==="object" && !Array.isArray(env) && env.ONEPROMPT_CONVERGENCE_STATE_DIR===expectedState && Object.keys(env).every((key)=>["HOME","PATH","ONEPROMPT_CONVERGENCE_STATE_DIR"].includes(key));
    if(value.Label!=="tools.theme.oneprompt.converge" || !Array.isArray(args) || args.length!==2 || !safeExecutable || args[1]!==expectedWorker || value.WorkingDirectory!==expectedRepo || !safeEnvironment || value.KeepAlive===true || Object.keys(value).some((key)=>!allowed.has(key))) process.exit(1);
  ' "$serialized" "$worker" "$repo" "$state_root" || die "canonical definition is not a recognized inactive OnePrompt predecessor"
}

adopt_service() {
  local repo_arg="" machine_arg="" expected_revision="" m legacy canonical old_config bundle desired predecessor_kind
  while test "$#" -gt 0; do case "$1" in --repo) repo_arg="$2"; shift 2;; --machine-interface) machine_arg="$2"; shift 2;; --revision) expected_revision="$2"; shift 2;; *) die "unknown adopt option: $1";; esac; done
  test -n "$repo_arg" && test -n "$machine_arg" && test -n "$expected_revision" || die "adopt requires --repo, --machine-interface, and --revision"
  m="$(manager)"; legacy="$(legacy_definition_for "$m")"; canonical="$(definition_path_for "$m")"; old_config="$state_root/config"
  if test -r "$config_root/config" && test ! -e "$legacy"; then
    read_config
    test "$adoption_state" = adopted || die "canonical service exists without completed adoption"
    verify_artifacts >/dev/null
    printf 'adoption already complete and verified\n'
    return
  fi
  repo_arg="$(canonical_repo "$repo_arg")"
  if test -f "$legacy"; then
    predecessor_kind=legacy
    test -r "$old_config/repository" && test -r "$old_config/manager" || die "legacy definition is not adapter-managed"
    test "$(sed -n '1p' "$old_config/repository")" = "$repo_arg" || die "legacy repository differs from requested repository"
    legacy_active "$m" && die "legacy writer is active; stop it before adoption"
    test ! -e "$canonical" || die "canonical definition already exists alongside legacy definition"
  elif test -f "$canonical"; then
    predecessor_kind=canonical
    canonical_active "$m" && die "canonical predecessor is active; stop it before adoption"
    verify_known_canonical_predecessor "$m" "$canonical" "$repo_arg"
  else
    die "no legacy or recognized canonical predecessor definition is present"
  fi
  bundle="$recovery_root/adoption-$(date -u +%Y%m%dT%H%M%SZ)-$$"; mkdir -p "$bundle"; chmod 700 "$bundle"
  if test "$predecessor_kind" = legacy; then
    cp -p "$legacy" "$bundle/predecessor-definition"; cp -R "$old_config" "$bundle/legacy-config"
  else
    cp -p "$canonical" "$bundle/predecessor-definition"
  fi
  test ! -f "$state_root/state.sqlite" || cp -p "$state_root/state.sqlite" "$bundle/state.sqlite.before"
  printf '{"schemaVersion":1,"predecessorKind":"%s","legacyIdentity":"%s","canonicalIdentity":"%s","repository":"%s"}\n' "$predecessor_kind" "$legacy_identity" "$logical_identity" "$(json_string "$repo_arg")" | write_atomic "$bundle/manifest.json"
  if test "$predecessor_kind" = legacy; then rm -f "$legacy"; else unload_canonical_predecessor "$m"; rm -f "$canonical"; fi
  install_service --repo "$repo_arg" --machine-interface "$machine_arg" --revision "$expected_revision"
  read_config
  desired="$(machine_call status | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).desiredMode))')"
  if test -e "$state_root/stop"; then machine_call stop >/dev/null
  elif test -e "$state_root/pause" || test "$desired" = paused; then machine_call pause >/dev/null
  fi
  printf "adoption_state='adopted'\npredecessor_kind='%s'\nrecovery_bundle='%s'\n" "$predecessor_kind" "$bundle" >>"$config_root/config"
  if test "$predecessor_kind" = legacy; then
    rm -f "$old_config/repository" "$old_config/manager" "$old_config/controller"
    rmdir "$old_config" 2>/dev/null || die "legacy config contains unknown files; recovery retained and adoption requires operator review"
  fi
  printf 'adopted %s predecessor into inactive %s; recovery=%s\n' "$predecessor_kind" "$logical_identity" "$bundle"
}

rollback_service() {
  read_config; test "$adoption_state" = adopted || die "no completed adoption to roll back"
  test -d "$recovery_bundle" && test -r "$recovery_bundle/manifest.json" || die "recovery bundle is missing"
  machine_call stop >/dev/null; manager_stop
  local status; status="$(machine_call status)"
  node -e 'const s=JSON.parse(process.argv[1]); if(s.ownerId!=null||s.desiredMode!=="stopped")process.exit(1)' "$status" || die "controller still has an owner or is not stopped"
  test "$(sha256 "$configured_definition")" = "$configured_definition_sha256" || die "canonical definition changed; refusing rollback"
  rm -f "$configured_definition"; test "$configured_manager" != systemd || rm -f "$(timer_path)"
  if test "${predecessor_kind:-legacy}" = canonical; then
    cp -p "$recovery_bundle/predecessor-definition" "$configured_definition"
  else
    cp -p "$recovery_bundle/predecessor-definition" "$(legacy_definition_for "$configured_manager")"
    mkdir -p "$state_root/config"; cp -R "$recovery_bundle/legacy-config/." "$state_root/config/"
  fi
  test ! -f "$recovery_bundle/state.sqlite.before" || cp -p "$recovery_bundle/state.sqlite.before" "$state_root/state.sqlite"
  : >"$state_root/stop"; rm -f "$config_root/config"
  printf 'restored inactive %s predecessor definition; stopped intent retained\n' "${predecessor_kind:-legacy}"
}

uninstall_service() { read_config; machine_call stop >/dev/null; manager_stop; test "$(sha256 "$configured_definition")" = "$configured_definition_sha256" || die "refusing to remove changed definition"; rm -f "$configured_definition"; test "$configured_manager" != systemd || rm -f "$(timer_path)"; rm -f "$config_root/config"; printf 'removed managed definition; stopped state retained\n'; }
show_logs() { test -f "$log_file" && tail -n "${ONEPROMPT_LOG_LINES:-200}" "$log_file" || printf 'no controller log at %s\n' "$log_file"; }

command="${1:-}"; test -n "$command" || die "usage: install|start|status|logs|pause|resume|stop|verify|run|adopt-plan|adopt|rollback|uninstall"; shift
case "$command" in install) install_service "$@";; start) start_service;; status) status_service;; logs) show_logs;; pause) pause_service;; resume) resume_service;; stop) stop_service;; verify) verify_service;; run) run_worker;; adopt-plan) adopt_plan;; adopt) adopt_service "$@";; rollback) rollback_service;; uninstall) uninstall_service;; *) die "unknown command: $command";; esac
