#!/usr/bin/env bash
set -euo pipefail

readonly profile_slug="${DESKTOP_TOOLS_PROFILE_SLUG:-brian}"
case "$profile_slug" in
  ''|?|??|*[^a-z0-9-]*|-*|*-|*--) printf 'desktop-tools: invalid profile slug\n' >&2; exit 64 ;;
esac
[ "${#profile_slug}" -le 63 ] || { printf 'desktop-tools: invalid profile slug\n' >&2; exit 64; }

curl -q --fail --show-error --silent --proto '=https' --proto-redir '=https' --tlsv1.2 \
  --max-redirs 0 --retry 2 --retry-all-errors --retry-delay 1 --connect-timeout 10 --max-time 60 \
  "https://${profile_slug}.desktop.tools/" | bash
