#!/usr/bin/env bash
set -euo pipefail
# @file Proxmox VE 9.2 + PBS 4.2 + Coolify v4 Fleet Convergence & Self-Healing (#91-#120)
# @brief Reclaims orphaned ZFS snapshots on Proxmox, tunes OpenZFS 2.4 pools, relocates PBS S3/R2 caches off root, and hardens Coolify

MODE="${1:---apply}"

log() {
  printf '[fleet-proxmox-pbs-converge] %s\n' "$*"
}

# 1. Proxmox VE 9.2 ZFS Pool, Kernel, VM & Snapshot Reconciliation (#91-#100, #106, #120)
if command -v pveversion >/dev/null 2>&1 && command -v zfs >/dev/null 2>&1; then
  log "Converging Proxmox VE 9.2 ZFS pools, kernel pin, VM ballooning, and Sanoid/cv4pve retention..."

  # #92: Lift dangerous 32G root quota on rpool/ROOT/pve-1 to 128G so Sanoid snapshots never ENOSPC /
  CURRENT_QUOTA="$(zfs get -H -o value quota rpool/ROOT/pve-1 2>/dev/null || echo "none")"
  if [ "$CURRENT_QUOTA" = "32G" ] && [ "$MODE" = "--apply" ]; then
    log "Raising rpool/ROOT/pve-1 quota from 32G to 128G..."
    zfs set quota=128G rpool/ROOT/pve-1
  fi

  # #94 & #106: Enable autotrim on NVMe/SSD pools (kasm, rpool, optane) and set zstd-fast-3 + atime=off + xattr=sa
  for pool in rpool kasm optane; do
    if zpool list "$pool" >/dev/null 2>&1 && [ "$MODE" = "--apply" ]; then
      zpool set autotrim=on "$pool" 2>/dev/null || true
    fi
  done
  for ds in rpool storage kasm optane; do
    if zfs list "$ds" >/dev/null 2>&1 && [ "$MODE" = "--apply" ]; then
      zfs set compression=zstd-fast-3 "$ds" 2>/dev/null || true
      zfs set atime=off "$ds" 2>/dev/null || true
      zfs set xattr=sa "$ds" 2>/dev/null || true
    fi
  done
  if zfs list storage/vm-105-disk-0 >/dev/null 2>&1 && [ "$MODE" = "--apply" ]; then
    zfs set compression=zstd-fast-3 storage/vm-105-disk-0 2>/dev/null || true
  fi

  # #95: Pin Linux 7.0.2-6-pve kernel for next boot and refresh ESPs
  if [ "$MODE" = "--apply" ] && [ -d /lib/modules/7.0.2-6-pve ]; then
    proxmox-boot-tool kernel pin 7.0.2-6-pve >/dev/null 2>&1 || true
  fi

  # #97: OpenZFS 2.4 ARC 32GiB cap, L2ARC persistent rebuild, BClone, and Proxmox VE 9 sysctls
  if [ "$MODE" = "--apply" ]; then
    cat > /etc/modprobe.d/zfs.conf <<'EOF'
options zfs zfs_arc_min=8589934592
options zfs zfs_arc_max=34359738368
options zfs l2arc_rebuild_enabled=1
options zfs l2arc_write_max=67108864
options zfs l2arc_write_boost=134217728
options zfs zfs_bclone_enabled=1
options zfs zfs_bclone_wait_dirty=1
EOF
    echo 34359738368 > /sys/module/zfs/parameters/zfs_arc_max 2>/dev/null || true
    echo 1 > /sys/module/zfs/parameters/l2arc_rebuild_enabled 2>/dev/null || true
    echo 67108864 > /sys/module/zfs/parameters/l2arc_write_max 2>/dev/null || true
    echo 134217728 > /sys/module/zfs/parameters/l2arc_write_boost 2>/dev/null || true

    cat > /etc/sysctl.d/99-proxmox-ve9-tuning.conf <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
vm.swappiness = 10
vm.max_map_count = 1048576
fs.inotify.max_user_watches = 1048576
fs.inotify.max_user_instances = 8192
EOF
    sysctl --system >/dev/null 2>&1 || true
  fi

  # #98, #102, #122: Disable KVM ballooning on critical VMs (100, 101, 103, 105) & right-size PBS VM 105 to 8GiB
  if [ "$MODE" = "--apply" ]; then
    for vmid in 100 101 103; do
      [ -f "/etc/pve/qemu-server/${vmid}.conf" ] && qm set "$vmid" --balloon 0 >/dev/null 2>&1 || true
    done
    [ -f "/etc/pve/qemu-server/105.conf" ] && qm set 105 --memory 8192 --balloon 0 >/dev/null 2>&1 || true
  fi

  # #99: Ensure weekly ZFS scrub + trim timers across all pools
  if [ "$MODE" = "--apply" ]; then
    for pool in rpool storage kasm optane; do
      systemctl enable --now "zfs-scrub-weekly@${pool}.timer" 2>/dev/null || true
      systemctl enable --now "zfs-trim-weekly@${pool}.timer" 2>/dev/null || true
    done
  fi

  # #100 & #105: Pre-backup application-consistent SQL/Redis dump hook before daily 01:30 vzdump
  if [ "$MODE" = "--apply" ]; then
    cat > /etc/cron.d/proxmox-pbs-sql-prebackup <<'EOF'
15 1 * * * root /usr/sbin/qm guest exec 100 -- bash -lc 'mkdir -p /var/backups/sql && docker exec coolify-db pg_dumpall -U coolify > /var/backups/sql/coolify-db.sql && docker exec coolify-redis redis-cli save' >/dev/null 2>&1 || true
20 1 * * * root /usr/sbin/qm guest exec 101 -- bash -lc 'mkdir -p /var/backups/sql && docker exec agent-paperclip-database-1 pg_dumpall -U postgres > /var/backups/sql/paperclip-db.sql' >/dev/null 2>&1 || true
EOF
    chmod 0644 /etc/cron.d/proxmox-pbs-sql-prebackup
  fi

  # #92: Sanoid retention tuning & prune
  if [ -f /etc/sanoid/sanoid.conf ] && [ "$MODE" = "--apply" ]; then
    cat > /etc/sanoid/sanoid.conf <<'EOF'
[template_proxmoxroot]
recursive = yes
process_children_only = no
hourly = 6
daily = 7
monthly = 2
yearly = 0
autosnap = yes
autoprune = yes

[rpool/ROOT/pve-1]
use_template = proxmoxroot
EOF
    sanoid --prune-snapshots >/dev/null 2>&1 || true
  fi

  # #120: Post-Quantum ML-KEM on Proxmox cloudflared
  if [ -f /etc/systemd/system/cloudflared.service ] || [ -f /lib/systemd/system/cloudflared.service ]; then
    mkdir -p /etc/systemd/system/cloudflared.service.d
    printf '[Service]\nEnvironment="TUNNEL_POST_QUANTUM=true"\n' > /etc/systemd/system/cloudflared.service.d/post-quantum.conf
    systemctl daemon-reload
  fi

  # #123: Throttle vzdump I/O (120 MB/s, ionice 7) for Exos HDD thermals, preserve vzdump-hc-hook.sh, and disable VFIO idle D3cold
  if [ "$MODE" = "--apply" ]; then
    cat > /etc/modprobe.d/vfio-d3cold.conf <<'EOF'
options vfio_pci disable_idle_d3=1
EOF
    cat > /etc/vzdump.conf <<'EOF'
bwlimit: 120000
ionice: 7
pigz: 1
zstd: 1
EOF
    if [ -x /usr/local/bin/vzdump-hc-hook.sh ]; then
      printf 'script: /usr/local/bin/vzdump-hc-hook.sh\n' >> /etc/vzdump.conf
    fi
  fi

  # #124: Harden Healthchecks heartbeat script with curl retries so transient tunnel flaps never fire false DOWN emails
  if [ -f /usr/local/bin/proxmox-healthcheck.sh ] && [ "$MODE" = "--apply" ]; then
    if ! grep -q -- '--retry 3' /usr/local/bin/proxmox-healthcheck.sh 2>/dev/null; then
      sed -i 's/curl -fsS -m 15/curl -fsS -m 20 --retry 3 --retry-delay 5 --retry-all-errors/g' /usr/local/bin/proxmox-healthcheck.sh 2>/dev/null || true
    fi
  fi
fi

# 2. Proxmox Backup Server (PBS 4.2) S3/R2 Local Cache Offload & ZFS/Ext4 Tuning (#101-#108, #125)
if command -v proxmox-backup-manager >/dev/null 2>&1; then
  log "Converging Proxmox Backup Server (PBS 4.2)..."
  if [ -d /mnt/datastore/pbs-local ] && [ "$MODE" = "--apply" ]; then
    mkdir -p /mnt/datastore/pbs-local/.s3-cache/cloudflare-r2 /mnt/datastore/pbs-local/.s3-cache/wasabi
    chown -R backup:backup /mnt/datastore/pbs-local/.s3-cache
    for store in cloudflare-r2 wasabi; do
      src="/mnt/${store}"
      dst="/mnt/datastore/pbs-local/.s3-cache/${store}"
      if [ -d "$src" ] && ! mountpoint -q "$src"; then
        log "Relocating PBS S3 local cache $src -> $dst (4.9TB datastore disk)..."
        if [ -n "$(ls -A "$src" 2>/dev/null)" ]; then
          cp -a "$src/." "$dst/"
          find "$src" -mindepth 1 -delete
        fi
        mount --bind "$dst" "$src"
        if ! grep -qF "$dst $src none bind" /etc/fstab 2>/dev/null; then
          printf '%s %s none bind,nofail 0 0\n' "$dst" "$src" >> /etc/fstab
        fi
      fi
      # #125: Remove empty ownerless backup group directories so PBS datastore GC never fails with missing owner errors
      for ns_type in vm ct host; do
        if [ -d "${src}/${ns_type}" ]; then
          for grp_dir in "${src}/${ns_type}"/*; do
            [ -d "$grp_dir" ] || continue
            if [ ! -f "$grp_dir/owner" ] && [ -z "$(ls -A "$grp_dir" 2>/dev/null)" ]; then
              log "Removing empty ownerless PBS backup group directory: $grp_dir"
              rmdir "$grp_dir" 2>/dev/null || true
            fi
          done
        fi
      done
    done
    cat > /etc/sysctl.d/99-pbs-s3-tuning.conf <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
vm.swappiness = 10
vm.vfs_cache_pressure = 50
EOF
    sysctl --system >/dev/null 2>&1 || true
    journalctl --vacuum-size=128M >/dev/null 2>&1 || true
  fi
fi

log "Fleet Proxmox/PBS convergence complete."
