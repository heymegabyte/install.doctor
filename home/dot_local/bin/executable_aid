#!/usr/bin/env bash
# aid — machine-side client for the aid control plane. Reads the device token stored by `aid-pair`
# (~/.config/aid/device-token) and talks to the control plane as THIS device (tenant from the token).
#   aid status   pairing + desired-state summary (tenant / revision / digest)
#   aid pull     fetch this device's desired ENVIRONMENT.md and write it to AID_ENV_PATH
# Headless-safe, dependency-light (no jq). URL + paths are env-overridable.
set -uo pipefail

AID_CONTROL_PLANE_URL="${AID_CONTROL_PLANE_URL:-https://aid-control-plane.manhattan.workers.dev}"
AID_TOKEN_PATH="${AID_TOKEN_PATH:-$HOME/.config/aid/device-token}"
AID_ENV_PATH="${AID_ENV_PATH:-$HOME/.config/aid/ENVIRONMENT.md}"
AID_CNF_HOOK="${AID_CNF_HOOK:-$HOME/.config/shell/not-found-hook.sh}" # the ONE cnf resolver (install path)
AID_CNF_JOURNAL="${AID_CNF_JOURNAL:-${CNF_JOURNAL:-$HOME/.local/var/log/install.doctor/cnf-installs.ndjson}}" # U09/U10 lazy-install telemetry
AID_TOTAL=0
AID_PRESENT=0
AID_MISSING=""

log() { command -v gum >/dev/null 2>&1 && gum log --level info -- "$*" || printf '\033[1;36m[aid]\033[0m %s\n' "$*"; }
err() { command -v gum >/dev/null 2>&1 && gum log --level error -- "$*" || printf '\033[1;31m[aid]\033[0m %s\n' "$*" >&2; }

# Extract a JSON string field value portably (no jq). jsonStr '<json>' <field> -> value (or empty).
jsonStr() { printf '%s' "$1" | grep -oE "\"$2\":\"[^\"]*\"" | head -1 | sed -E "s/\"$2\":\"([^\"]*)\"/\1/"; }

readToken() { [ -s "$AID_TOKEN_PATH" ] && cat "$AID_TOKEN_PATH"; }

# Post an event to History (/api/device/report) as this device. Prints the response; the caller
# decides whether a failure is fatal (manual report) or best-effort (auto-register from aid plan).
postReport() {
  local kind="$1" status="$2" summary="$3" detail="$4" token u body
  token="$(readToken)" || true
  [ -z "$token" ] && return 2
  u="${AID_CONTROL_PLANE_URL%/}"
  if command -v jq >/dev/null 2>&1; then
    if [ -n "$detail" ]; then
      body="$(jq -nc --arg k "$kind" --arg s "$status" --arg sm "$summary" --argjson d "$detail" '{kind:$k,status:$s,summary:$sm,detail:$d}')"
    else
      body="$(jq -nc --arg k "$kind" --arg s "$status" --arg sm "$summary" '{kind:$k,status:$s,summary:$sm}')"
    fi
  else
    body="{\"kind\":\"${kind}\",\"status\":\"${status}\"}"
  fi
  curl -fsS -X POST -H "authorization: Bearer ${token}" -H 'content-type: application/json' -d "$body" "${u}/api/device/report" 2>/dev/null
}

cmdStatus() {
  local u token resp tenant revision digest
  u="${AID_CONTROL_PLANE_URL%/}"
  token="$(readToken)" || true
  if [ -z "$token" ]; then
    err "not paired — run: aid-pair"
    return 2
  fi
  resp="$(curl -fsS -H "authorization: Bearer ${token}" "$u/api/device/current" 2>/dev/null || true)"
  if [ -z "$resp" ]; then
    err "could not fetch desired state (token revoked, or no blueprint for this tenant yet)"
    return 1
  fi
  tenant="$(jsonStr "$resp" tenant)"
  revision="$(jsonStr "$resp" revision)"
  digest="$(jsonStr "$resp" digest)"
  log "paired ✓  tenant=${tenant}  revision=${revision}  digest=${digest:0:12}"
}

cmdPull() {
  local u token code
  u="${AID_CONTROL_PLANE_URL%/}"
  token="$(readToken)" || true
  if [ -z "$token" ]; then
    err "not paired — run: aid-pair"
    return 2
  fi
  mkdir -p "$(dirname "$AID_ENV_PATH")"
  code="$(curl -fsS -H "authorization: Bearer ${token}" -o "${AID_ENV_PATH}.tmp" -w '%{http_code}' "$u/api/device/current.md" 2>/dev/null || echo 000)"
  if [ "$code" != 200 ]; then
    rm -f "${AID_ENV_PATH}.tmp"
    err "pull failed (HTTP ${code} — token revoked, or no blueprint for this tenant)"
    return 1
  fi
  mv "${AID_ENV_PATH}.tmp" "$AID_ENV_PATH"
  log "pulled desired ENVIRONMENT.md -> ${AID_ENV_PATH} ($(wc -c <"$AID_ENV_PATH" | tr -d ' ') bytes)"
}

# Reconcile the desired blueprint vs installed packages → AID_TOTAL / AID_PRESENT / AID_MISSING.
# Presence is by command name (package==command); a package whose binary differs (ripgrep->rg) may show
# missing — a software.yml `_bin`-aware check is a later refinement. LOCAL + offline (S23).
computeReconcile() {
  command -v jq >/dev/null 2>&1 || {
    err "this requires jq"
    return 3
  }
  if [ ! -s "$AID_ENV_PATH" ]; then
    cmdPull || return $?
  fi
  local json pkgs p
  json="$(awk '/^```install-doctor[+]json[[:space:]]*$/{f=1;next} /^```[[:space:]]*$/{f=0} f' "$AID_ENV_PATH")"
  if [ -z "$json" ]; then
    err "no install-doctor+json blueprint fence in $AID_ENV_PATH"
    return 1
  fi
  pkgs="$(printf '%s' "$json" | jq -r '.defaults.packages[]?' 2>/dev/null)"
  AID_TOTAL=0
  AID_PRESENT=0
  AID_MISSING=""
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    AID_TOTAL=$((AID_TOTAL + 1))
    if isInstalled "$p"; then
      AID_PRESENT=$((AID_PRESENT + 1))
    else
      AID_MISSING="${AID_MISSING} ${p}"
    fi
  done < <(printf '%s\n' "$pkgs")
  AID_MISSING="${AID_MISSING# }"
}

# Detect the host package manager by what is actually installed (self-contained; no detect_os dep).
detectManager() {
  if command -v brew >/dev/null 2>&1; then
    echo brew
  elif command -v apt-get >/dev/null 2>&1; then
    echo apt
  elif command -v dnf >/dev/null 2>&1; then
    echo dnf
  elif command -v pacman >/dev/null 2>&1; then
    echo pacman
  elif command -v apk >/dev/null 2>&1; then
    echo apk
  else
    echo ""
  fi
}

# Resolve a package key to the per-manager package name via the cnf index (fire #3); fall back to the key.
resolvePkg() {
  local key="$1" col="$2" idx="${AID_CNF_INDEX:-$HOME/.cache/cnf/index.tsv}" val=""
  if [ -n "$col" ] && [ -f "$idx" ]; then
    val="$(awk -F'\t' -v k="$key" -v c="$col" '$2==k {print $c; exit}' "$idx")"
  fi
  printf '%s' "${val:-$key}"
}

# Is a desired package present? Resolve its binary name(s) from the cnf index (col1=bin, col2=key) and
# check `command -v` on those — fixes name≠binary false-missing (angular-cli->ng, android-platform-tools
# ->adb, ripgrep->rg). Fall back to the key itself when the index/row is absent (still works offline).
isInstalled() {
  local key="$1" idx="${AID_CNF_INDEX:-$HOME/.cache/cnf/index.tsv}" bins b
  if [ -f "$idx" ]; then
    bins="$(awk -F'\t' -v k="$key" '$2 == k && $1 != "" {print $1}' "$idx")"
  fi
  [ -z "$bins" ] && bins="$key"
  while IFS= read -r b; do
    [ -z "$b" ] && continue
    command -v "$b" >/dev/null 2>&1 && return 0
  done < <(printf '%s\n' "$bins")
  return 1
}

# aid plan — LOCAL, offline reconciliation of desired vs installed packages (+ auto-register to History).
cmdPlan() {
  computeReconcile || return $?
  log "desired packages: ${AID_TOTAL} · present: ${AID_PRESENT} · missing: $((AID_TOTAL - AID_PRESENT))"
  if [ -n "$AID_MISSING" ]; then
    log "to install:${AID_MISSING:+ }${AID_MISSING}"
  else
    log "all desired packages present ✓"
  fi
  local detail
  detail="$(jq -nc --argjson t "$AID_TOTAL" --argjson p "$AID_PRESENT" --arg m "$AID_MISSING" '{total:$t,present:$p,missing:($m|split(" ")|map(select(length>0)))}')"
  postReport check success "plan: ${AID_PRESENT}/${AID_TOTAL} present" "$detail" >/dev/null 2>&1 && log "recorded to History ✓" || true
}

# aid report — record a run/event to History (POST /api/device/report) as this device.
#   aid report [--kind run|apply|check|enroll|other] [--status success|failed|partial|preview]
#              [--summary "..."] [--detail '<json>']
cmdReport() {
  local kind="run" status="success" summary="" detail="" resp id
  while [ $# -gt 0 ]; do
    case "$1" in
    --kind)
      kind="${2:-}"
      shift 2
      ;;
    --status)
      status="${2:-}"
      shift 2
      ;;
    --summary)
      summary="${2:-}"
      shift 2
      ;;
    --detail)
      detail="${2:-}"
      shift 2
      ;;
    *) shift ;;
    esac
  done
  if ! readToken >/dev/null 2>&1; then
    err "not paired — run: aid-pair"
    return 2
  fi
  resp="$(postReport "$kind" "$status" "$summary" "$detail")" || {
    err "report failed (token revoked / offline)"
    return 1
  }
  id="$(jsonStr "$resp" id)"
  log "reported ✓ ${kind}/${status} (id ${id})"
}

# aid apply — install the MISSING packages (from reconciliation). DRY-RUN by default; real install needs
# --yes or AID_APPLY=1 (host mutation is opt-in). Resolves per-manager names via the cnf index; reports.
cmdApply() {
  local doIt=0 p mgr col n
  [ "${1:-}" = "--yes" ] && doIt=1
  [ "${AID_APPLY:-0}" = "1" ] && doIt=1
  computeReconcile || return $?
  if [ -z "$AID_MISSING" ]; then
    log "nothing to install — all desired packages present ✓"
    postReport apply success "apply: 0 to install" '{"installed":0}' >/dev/null 2>&1 || true
    return 0
  fi
  mgr="$(detectManager)"
  if [ -z "$mgr" ]; then
    err "no supported package manager found (brew/apt/dnf/pacman/apk)"
    return 1
  fi
  case "$mgr" in
  brew) col=3 ;;
  apt) col=4 ;;
  dnf) col=5 ;;
  pacman) col=6 ;;
  *) col="" ;;
  esac
  local -a names=() runCmd=()
  for p in $AID_MISSING; do names+=("$(resolvePkg "$p" "$col")"); done
  case "$mgr" in
  brew) runCmd=(brew install "${names[@]}") ;;
  apt) runCmd=(sudo apt-get install -y "${names[@]}") ;;
  dnf) runCmd=(sudo dnf install -y "${names[@]}") ;;
  pacman) runCmd=(sudo pacman -S --noconfirm --needed "${names[@]}") ;;
  apk) runCmd=(sudo apk add "${names[@]}") ;;
  esac
  n="${#names[@]}"
  if [ "$doIt" != 1 ]; then
    log "DRY-RUN — would install ${n} package(s) via ${mgr}:"
    log "  ${runCmd[*]}"
    log "(run 'aid apply --yes' or set AID_APPLY=1 to execute)"
    postReport apply preview "apply dry-run: ${n} via ${mgr}" "$(jq -nc --arg c "${runCmd[*]}" --argjson n "$n" '{installed:0,planned:$n,command:$c}' 2>/dev/null)" >/dev/null 2>&1 || true
    return 0
  fi
  [ "${HEADLESS_INSTALL:-0}" = "1" ] && log "HEADLESS_INSTALL=1 — non-interactive"
  log "installing ${n} package(s) via ${mgr}…"
  if "${runCmd[@]}"; then
    log "apply ✓ installed ${n} via ${mgr}"
    postReport apply success "apply: installed ${n} via ${mgr}" "$(jq -nc --argjson n "$n" --arg m "$mgr" '{installed:$n,manager:$m}' 2>/dev/null)" >/dev/null 2>&1 || true
  else
    err "apply failed (${mgr} returned non-zero)"
    postReport apply failed "apply failed via ${mgr}" "$(jq -nc --arg m "$mgr" '{manager:$m}' 2>/dev/null)" >/dev/null 2>&1 || true
    return 1
  fi
}

# aid up — one-command SYNC of this machine's view to its desired state: pull the desired ENVIRONMENT.md
# then reconcile (which auto-registers a History 'check' event). READ-ONLY: never installs — `aid apply`
# stays the explicit, opt-in mutation. Unpaired → point to `aid-pair`.
cmdUp() {
  if ! readToken >/dev/null 2>&1; then
    err "not paired — run: aid-pair"
    return 2
  fi
  log "aid up — syncing this machine's view to its desired state…"
  cmdPull || return $?
  cmdPlan || return $?
  log "aid up ✓ (view synced + recorded; run 'aid apply' to install missing packages)"
}

# aid provider — write the OpenCode provider config (fetched from the control plane, aid-core SSOT) to
# ~/.config/opencode so OpenCode routes aid through the control plane's /api/ai/v1. No token needed (the
# config carries only the {env:AID_INFERENCE_TOKEN} ref). Safe: won't clobber an existing config sans --force.
cmdProvider() {
  local force=0 u out code
  [ "${1:-}" = "--force" ] && force=1
  u="${AID_CONTROL_PLANE_URL%/}"
  out="${AID_OPENCODE_CONFIG_PATH:-$HOME/.config/opencode/opencode.json}"
  if [ -s "$out" ] && [ "$force" -ne 1 ]; then
    err "OpenCode config already exists at ${out} — pass --force to overwrite"
    return 1
  fi
  mkdir -p "$(dirname "$out")"
  code="$(curl -fsS -o "${out}.tmp" -w '%{http_code}' "$u/api/provider-config" 2>/dev/null || echo 000)"
  if [ "$code" != 200 ]; then
    rm -f "${out}.tmp"
    err "fetch provider-config failed (HTTP ${code})"
    return 1
  fi
  mv "${out}.tmp" "$out"
  log "wrote OpenCode provider config -> ${out} (aid routes via ${u}/api/ai/v1; set AID_INFERENCE_TOKEN to use)"
}

# Install a missing command via the ONE canonical resolver's install path (CNF_NO_EXEC = install only;
# the caller runs it). Subshell-scoped so the sourced hook never mutates aid's env. `aid exec`/`prewarm`
# ARE the authorized unattended-install context (§4.E) → CNF_ALLOW_NONINTERACTIVE opts past the E13 gate.
# Returns 0 if the command is present after, non-zero otherwise. All install chatter → stderr.
cnfInstall() {
  local cmd="$1"
  [ -f "$AID_CNF_HOOK" ] || { err "cnf resolver not found at $AID_CNF_HOOK"; return 127; }
  # shellcheck source=/dev/null
  ( export CNF_ALLOW_NONINTERACTIVE=1 CNF_NO_EXEC=1; . "$AID_CNF_HOOK"; __cnf_resolve "$cmd" ) >&2 </dev/null
  hash -r 2>/dev/null || true
  command -v "$cmd" >/dev/null 2>&1
}

# aid exec <cmd> [args...] — run a command, installing it first if missing (authorized on-demand, §4.E).
# exec replaces the aid process so argv/stdin/stdout/stderr/exit-status/signals pass through intact (E06-E08).
cmdExec() {
  local cmd="${1:-}"
  [ -z "$cmd" ] && { err "usage: aid exec <command> [args...]"; return 2; }
  shift
  if command -v "$cmd" >/dev/null 2>&1; then exec "$cmd" "$@"; fi
  log "aid exec: '$cmd' not installed — installing via install.doctor…"
  if cnfInstall "$cmd"; then
    postReport exec ok "aid exec installed $cmd" "" >/dev/null 2>&1 || true # best-effort History (U01), before run
    exec "$cmd" "$@"
  fi
  err "aid exec: '$cmd' still not found after install"
  return 127
}

# aid prewarm <cmd...> — INSTALL the named tools now (authorized), never run them (§4.E / V09 prewarm).
cmdPrewarm() {
  [ "$#" -ge 1 ] || { err "usage: aid prewarm <command> [command...]"; return 2; }
  local rc=0 cmd
  for cmd in "$@"; do
    if command -v "$cmd" >/dev/null 2>&1; then log "prewarm: $cmd already present"; continue; fi
    log "prewarm: installing ${cmd}…"
    if cnfInstall "$cmd"; then
      log "prewarm: $cmd installed"
      postReport prewarm ok "aid prewarm installed $cmd" "" >/dev/null 2>&1 || true # best-effort History (U01)
    else
      err "prewarm: $cmd failed"; rc=1
    fi
  done
  return "$rc"
}

# aid installs — summarize lazy-install telemetry (U09/U10 cold/warm latency + cache effectiveness) from
# the cnf hook's LOCAL journal. Read-only, no network, no secrets.
cmdInstalls() {
  [ -s "$AID_CNF_JOURNAL" ] || { log "no lazy-install telemetry yet ($AID_CNF_JOURNAL)"; return 0; }
  if command -v jq >/dev/null 2>&1; then
    jq -s '{total:length,
            installed:([.[]|select(.outcome=="installed")]|length),
            failed:([.[]|select(.outcome=="failed")]|length),
            warm_skips:([.[]|select(.outcome=="concurrent-skip")]|length),
            avg_install_ms:([.[]|select(.outcome=="installed").duration_ms]|if length>0 then (add/length|floor) else 0 end)}' "$AID_CNF_JOURNAL"
  else
    log "installs: $(wc -l < "$AID_CNF_JOURNAL" | tr -d ' ') recorded in $AID_CNF_JOURNAL (install jq for a summary)"
  fi
}

usage() {
  printf 'usage: aid <up|status|pull|plan|report|apply|provider|exec|prewarm|installs>\n' >&2
  return 1
}

main() {
  case "${1:-}" in
  up) cmdUp ;;
  provider)
    shift
    cmdProvider "$@"
    ;;
  status) cmdStatus ;;
  pull) cmdPull ;;
  plan) cmdPlan ;;
  report)
    shift
    cmdReport "$@"
    ;;
  apply)
    shift
    cmdApply "$@"
    ;;
  exec)
    shift
    cmdExec "$@"
    ;;
  prewarm)
    shift
    cmdPrewarm "$@"
    ;;
  installs) cmdInstalls ;;
  *) usage ;;
  esac
}

main "$@"
