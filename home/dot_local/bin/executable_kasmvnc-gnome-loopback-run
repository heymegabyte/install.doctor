#!/usr/bin/env bash
# @file ~/.local/bin/kasmvnc-gnome-loopback-run
# @description Bridges the live GNOME Wayland desktop (gnome-remote-desktop on 127.0.0.1:5900)
# into native Xkasmvnc :20 on 127.0.0.1:8444 with iGPU DRI3, 1920x1080 geometry, and local scaling.
set -euo pipefail

SECRET_DIR="${KASMVNC_SECRET_DIR:-$HOME/.config/remote-desktop}"
WEBSOCKET_PORT="${KASMVNC_WEBSOCKET_PORT:-8444}"
RFB_PORT="${KASMVNC_RFB_PORT:-5920}"
mkdir -p "$SECRET_DIR"
chmod 700 "$SECRET_DIR"

if [ -f "$SECRET_DIR/vnc-password" ]; then
  node -e 'const fs=require("node:fs");const b=fs.readFileSync(process.argv[1]).subarray(0,8);const o=Buffer.alloc(8);b.copy(o);process.stdout.write(o)' \
    "$SECRET_DIR/vnc-password" | openssl enc -des-ecb -nopad -K e84ad660c4721ae0 > "$SECRET_DIR/vnc-passwd"
  chmod 0600 "$SECRET_DIR/vnc-passwd"
fi

pkill -u "$USER" -f "(/usr/bin/Xvnc :20|/usr/bin/Xkasmvnc :20)" 2>/dev/null || true
sleep 0.5
rm -f /tmp/.X20-lock /tmp/.X11-unix/X20

# Prefer an Intel or AMD integrated GPU before any discrete-GPU fallback.
DRI_ARGS=()
for render_node in /sys/class/drm/renderD*/device/vendor; do
  [ -r "$render_node" ] || continue
  vendor="$(cat "$render_node")"
  if [ "$vendor" = "0x8086" ] || [ "$vendor" = "0x1002" ]; then
    device="/dev/dri/$(basename "$(dirname "$(dirname "$render_node")")")"
    [ -e "$device" ] && DRI_ARGS=(-hw3d -drinode "$device") && break
  fi
done
if [ "${#DRI_ARGS[@]}" -eq 0 ]; then
  for device in /dev/dri/renderD128 /dev/dri/renderD129; do
    [ -e "$device" ] && DRI_ARGS=(-hw3d -drinode "$device") && break
  done
fi

CERT_FILE="$SECRET_DIR/kasmvnc.pem"
KEY_FILE="$SECRET_DIR/kasmvnc.pem"
if [ ! -s "$CERT_FILE" ] && [ -s "$HOME/.vnc/tls-cert.pem" ]; then
  CERT_FILE="$HOME/.vnc/tls-cert.pem"
  KEY_FILE="$HOME/.vnc/tls-key.pem"
fi
PASSWD_FILE="$SECRET_DIR/kasmpasswd"
if [ ! -s "$PASSWD_FILE" ] && [ -s "$HOME/.kasmpasswd" ]; then
  PASSWD_FILE="$HOME/.kasmpasswd"
fi

# Prepare responsive local-scaling webroot (resize=scale)
WEB_ROOT="${KASMVNC_WEB_ROOT:-$HOME/.local/share/kasmvnc-www}"
if [ -x "$HOME/.local/bin/kasmvnc-fit-browser" ]; then
  KASMVNC_WEB_ROOT="$WEB_ROOT" "$HOME/.local/bin/kasmvnc-fit-browser" >/dev/null 2>&1 || true
else
  mkdir -p "$WEB_ROOT"
  cp -a /usr/share/kasmvnc/www/. "$WEB_ROOT/"
  node - "$WEB_ROOT" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const marker = "default-local-scaling";
const script = `<script id="default-local-scaling">
(() => {
  const params = new URLSearchParams(window.location.search);
  if (!params.has('resize')) {
    params.set('resize', 'scale');
    window.location.replace(
      `${window.location.pathname}?${params.toString()}${window.location.hash}`
    );
  }
})();
</script>
`;
for (const name of ["index.html", "screen.html"]) {
  const file = path.join(process.argv[2], name);
  const html = fs.readFileSync(file, "utf8");
  if (!html.includes(marker)) fs.writeFileSync(file, html.replace("</head>", `${script}</head>`));
}
NODE
fi

GEOMETRY="${KASMVNC_GEOMETRY:-1920x1080}"
DESKTOP_TITLE="${KASMVNC_DESKTOP_TITLE:-$(hostname -s 2>/dev/null || hostname) (GNOME)}"

"${XKASMVNC_BIN:-/usr/bin/Xkasmvnc}" :20 \
  -interface 127.0.0.1 \
  -UseIPv4 1 \
  -UseIPv6 0 \
  -localhost 1 \
  -websocketPort "$WEBSOCKET_PORT" \
  -rfbport "$RFB_PORT" \
  -sslOnly 1 \
  -cert "$CERT_FILE" \
  -key "$KEY_FILE" \
  -DisableBasicAuth 1 \
  -SecurityTypes None \
  -KasmPasswordFile "$PASSWD_FILE" \
  -httpd "$WEB_ROOT" \
  -http-header Cache-Control=no-store \
  -http-header Cross-Origin-Embedder-Policy=require-corp \
  -http-header Cross-Origin-Opener-Policy=same-origin \
  -depth 24 \
  -geometry "$GEOMETRY" \
  -FrameRate 60 \
  -RectThreads 4 \
  "${DRI_ARGS[@]}" \
  -DynamicQualityMin 7 \
  -DynamicQualityMax 8 \
  -AcceptSetDesktopSize 1 \
  -AcceptPointerEvents 1 \
  -AcceptKeyEvents 1 \
  -AcceptCutText 1 \
  -SendCutText 1 \
  -AlwaysShared 1 \
  -DisconnectClients 0 \
  -PublicIP 127.0.0.1 \
  -desktop "$DESKTOP_TITLE" \
  -nolisten tcp \
  -ac &
XVNC_PID=$!

trap "kill $XVNC_PID 2>/dev/null || true" EXIT INT TERM

for _ in $(seq 1 30); do
  [ -S /tmp/.X11-unix/X20 ] && break
  sleep 0.2
done

export DISPLAY=:20
openbox &

while kill -0 "$XVNC_PID" 2>/dev/null; do
  loginctl unlock-session >/dev/null 2>&1 || true
  gdbus call --session --dest org.gnome.ScreenSaver \
    --object-path /org/gnome/ScreenSaver \
    --method org.gnome.ScreenSaver.SetActive false >/dev/null 2>&1 || true
  /usr/bin/xtigervncviewer \
    -display :20 \
    -PasswordFile="$SECRET_DIR/vnc-passwd" \
    -FullScreen=1 \
    -FullScreenMode=All \
    -FullscreenSystemKeys=1 \
    -RemoteResize=0 \
    -Shared=1 \
    -MenuKey= \
    -AlertOnFatalError=0 \
    -ReconnectOnError=0 \
    -PreferredEncoding=Raw \
    -CursorType=System \
    -SendClipboard=1 \
    -AcceptClipboard=1 \
    127.0.0.1::5900 || true
  sleep 1
done
