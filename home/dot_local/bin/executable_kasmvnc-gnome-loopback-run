#!/usr/bin/env bash
# @file ~/.local/bin/kasmvnc-gnome-loopback-run
# @description Bridges the live GNOME Wayland desktop (gnome-remote-desktop on 127.0.0.1:5900)
# into native Xkasmvnc :20 on 127.0.0.1:8444 with iGPU DRI3, 1920x1080 geometry, and local scaling.
set -euo pipefail

SECRET_DIR="${KASMVNC_SECRET_DIR:-$HOME/.config/remote-desktop}"
WEBSOCKET_PORT="${KASMVNC_WEBSOCKET_PORT:-8444}"
RFB_PORT="${KASMVNC_RFB_PORT:-5920}"
mkdir -p "$SECRET_DIR"
chmod 700 "$SECRET_DIR"

if [ -f "$SECRET_DIR/vnc-password" ]; then
  python3 - "$SECRET_DIR" << 'PY'
import ctypes, ctypes.util, sys
from pathlib import Path

sec = Path(sys.argv[1])
pw = (sec / "vnc-password").read_bytes().strip()[:8].ljust(8, b"\0")
fixed = (23, 82, 107, 6, 35, 78, 88, 7)
key = bytes(int(f"{v:08b}"[::-1], 2) for v in fixed)
crypto = ctypes.CDLL(ctypes.util.find_library("crypto"))
sched = ctypes.create_string_buffer(128)
crypto.DES_set_key_unchecked(ctypes.create_string_buffer(key, 8), sched)
out = ctypes.create_string_buffer(8)
crypto.DES_ecb_encrypt(ctypes.create_string_buffer(pw, 8), out, sched, 1)
dest = sec / "vnc-passwd"
dest.write_bytes(out.raw)
dest.chmod(0o600)
PY
fi

pkill -u "$USER" -f "(/usr/bin/Xvnc :20|/usr/bin/Xkasmvnc :20)" 2>/dev/null || true
sleep 0.5
rm -f /tmp/.X20-lock /tmp/.X11-unix/X20

# Prefer integrated GPU (00:02.0 -> renderD129) for desktop/KasmVNC DRI3 when a discrete NVIDIA GPU is present
DRI_ARGS=()
if [ -e /dev/dri/by-path/pci-0000:00:02.0-render ]; then
  DRI_ARGS=(-hw3d -drinode "$(readlink -f /dev/dri/by-path/pci-0000:00:02.0-render)")
elif [ -e /dev/dri/renderD129 ]; then
  DRI_ARGS=(-hw3d -drinode /dev/dri/renderD129)
elif [ -e /dev/dri/renderD128 ]; then
  DRI_ARGS=(-hw3d -drinode /dev/dri/renderD128)
fi

CERT_FILE="$SECRET_DIR/kasmvnc.pem"
KEY_FILE="$SECRET_DIR/kasmvnc.pem"
if [ ! -s "$CERT_FILE" ] && [ -s "$HOME/.vnc/tls-cert.pem" ]; then
  CERT_FILE="$HOME/.vnc/tls-cert.pem"
  KEY_FILE="$HOME/.vnc/tls-key.pem"
fi
PASSWD_FILE="$SECRET_DIR/kasmpasswd"
if [ ! -s "$PASSWD_FILE" ] && [ -s "$HOME/.kasmpasswd" ]; then
  PASSWD_FILE="$HOME/.kasmpasswd"
fi

# Prepare responsive local-scaling webroot (resize=scale)
WEB_ROOT="${KASMVNC_WEB_ROOT:-$HOME/.local/share/kasmvnc-www}"
if [ -x "$HOME/.local/bin/kasmvnc-fit-browser" ]; then
  KASMVNC_WEB_ROOT="$WEB_ROOT" "$HOME/.local/bin/kasmvnc-fit-browser" >/dev/null 2>&1 || true
else
  mkdir -p "$WEB_ROOT"
  cp -a /usr/share/kasmvnc/www/. "$WEB_ROOT/"
  python3 - "$WEB_ROOT" <<'PY'
from pathlib import Path
import sys

marker = "default-local-scaling"
script = """<script id="default-local-scaling">
(() => {
  const params = new URLSearchParams(window.location.search);
  if (!params.has('resize')) {
    params.set('resize', 'scale');
    window.location.replace(
      `${window.location.pathname}?${params.toString()}${window.location.hash}`
    );
  }
})();
</script>
"""
for page_name in ("index.html", "screen.html"):
    page_path = Path(sys.argv[1]) / page_name
    html = page_path.read_text()
    if marker not in html:
        html = html.replace("</head>", f"{script}</head>", 1)
        page_path.write_text(html)
PY
fi

GEOMETRY="${KASMVNC_GEOMETRY:-1920x1080}"
DESKTOP_TITLE="${KASMVNC_DESKTOP_TITLE:-$(hostname -s 2>/dev/null || hostname) (GNOME)}"

"${XKASMVNC_BIN:-/usr/bin/Xkasmvnc}" :20 \
  -interface 127.0.0.1 \
  -UseIPv4 1 \
  -UseIPv6 0 \
  -localhost 1 \
  -websocketPort "$WEBSOCKET_PORT" \
  -rfbport "$RFB_PORT" \
  -sslOnly 1 \
  -cert "$CERT_FILE" \
  -key "$KEY_FILE" \
  -DisableBasicAuth 1 \
  -SecurityTypes None \
  -KasmPasswordFile "$PASSWD_FILE" \
  -httpd "$WEB_ROOT" \
  -http-header Cache-Control=no-store \
  -http-header Cross-Origin-Embedder-Policy=require-corp \
  -http-header Cross-Origin-Opener-Policy=same-origin \
  -depth 24 \
  -geometry "$GEOMETRY" \
  -FrameRate 60 \
  -RectThreads 4 \
  "${DRI_ARGS[@]}" \
  -DynamicQualityMin 7 \
  -DynamicQualityMax 8 \
  -AcceptSetDesktopSize 1 \
  -AcceptPointerEvents 1 \
  -AcceptKeyEvents 1 \
  -AcceptCutText 1 \
  -SendCutText 1 \
  -AlwaysShared 1 \
  -DisconnectClients 0 \
  -PublicIP 127.0.0.1 \
  -desktop "$DESKTOP_TITLE" \
  -nolisten tcp \
  -ac &
XVNC_PID=$!

trap "kill $XVNC_PID 2>/dev/null || true" EXIT INT TERM

for _ in $(seq 1 30); do
  [ -S /tmp/.X11-unix/X20 ] && break
  sleep 0.2
done

export DISPLAY=:20
openbox &

while kill -0 "$XVNC_PID" 2>/dev/null; do
  loginctl unlock-session >/dev/null 2>&1 || true
  gdbus call --session --dest org.gnome.ScreenSaver \
    --object-path /org/gnome/ScreenSaver \
    --method org.gnome.ScreenSaver.SetActive false >/dev/null 2>&1 || true
  /usr/bin/xtigervncviewer \
    -display :20 \
    -PasswordFile="$SECRET_DIR/vnc-passwd" \
    -FullScreen=1 \
    -FullScreenMode=All \
    -FullscreenSystemKeys=1 \
    -RemoteResize=0 \
    -Shared=1 \
    -MenuKey= \
    -AlertOnFatalError=0 \
    -ReconnectOnError=0 \
    -PreferredEncoding=Raw \
    -CursorType=System \
    -SendClipboard=1 \
    -AcceptClipboard=1 \
    127.0.0.1::5900 || true
  sleep 1
done
