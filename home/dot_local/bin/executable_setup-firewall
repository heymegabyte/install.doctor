#!/usr/bin/env bash
# @file ~/.local/bin/setup-firewall
# @brief Setup and enable the Cloudflare-Only Zero-Trust Host Firewall
# @description
#   Delegates to `~/.local/bin/cloudflare-firewall` (or `post-firewall.sh`) to enforce
#   default-deny incoming policy while permitting public ingress on ports 22, 80, and 443
#   exclusively from official Cloudflare IPv4/IPv6 edge CIDRs (plus local loopback and
#   explicitly approved Zero-Trust interfaces such as wg0, CloudflareWARP, and utun*).
set -euo pipefail

if [ -x "$HOME/.local/bin/cloudflare-firewall" ]; then
  exec "$HOME/.local/bin/cloudflare-firewall" "$@"
elif command -v cloudflare-firewall > /dev/null 2>&1; then
  exec cloudflare-firewall "$@"
elif command -v ufw > /dev/null 2>&1; then
  sudo ufw default deny incoming
  sudo ufw default allow outgoing
  sudo ufw --force enable
  sudo ufw reload
fi
