#!/usr/bin/env bash
set -euo pipefail

die() { printf 'healthchecks-sync-discord-secrets: %s\n' "$*" >&2; exit 1; }

project_id="${INFISICAL_PROJECT_ID:-}"
environment="${INFISICAL_ENVIRONMENT:-prod}"
secret_path="${INFISICAL_SECRET_PATH:-/}"

while test "$#" -gt 0; do
  case "$1" in
    --project-id) test "$#" -ge 2 || die '--project-id requires a value'; project_id=$2; shift 2 ;;
    --environment) test "$#" -ge 2 || die '--environment requires a value'; environment=$2; shift 2 ;;
    --path) test "$#" -ge 2 || die '--path requires a value'; secret_path=$2; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

test -n "$project_id" || die 'set INFISICAL_PROJECT_ID or pass --project-id'
command -v infisical >/dev/null || die 'infisical CLI is unavailable'
command -v docker >/dev/null || die 'docker CLI is unavailable'
command -v node >/dev/null || die 'node is unavailable'
test "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = active || die 'Docker Swarm is not active'

secret_exists() { docker secret inspect "$1" >/dev/null 2>&1; }

id_exists=0
secret_exists discord_client_id && id_exists=1
secret_exists_exists=0
secret_exists discord_client_secret && secret_exists_exists=1
if test "$id_exists" = 1 && test "$secret_exists_exists" = 1; then
  printf 'Healthchecks Discord Docker secrets already exist; no values retrieved.\n'
  exit 0
fi
test "$id_exists" = "$secret_exists_exists" || die 'partial Docker secret state; reconcile both names before retrying'

created=()
rollback() {
  local name
  for name in "${created[@]}"; do docker secret rm "$name" >/dev/null 2>&1 || true; done
}
trap rollback ERR INT TERM

create_secret() {
  local infisical_name=$1 docker_name=$2
  if ! infisical secrets get "$infisical_name" \
      --projectId "$project_id" --env "$environment" --path "$secret_path" \
      --plain --secret-overriding=false --silent --telemetry=false 2>/dev/null \
    | node -e 'const b=[]; process.stdin.on("data",c=>b.push(c)).on("end",()=>{let v=Buffer.concat(b); if(v.at(-1)===10)v=v.subarray(0,-1); if(!v.length)process.exit(2); process.stdout.write(v);});' \
    | docker secret create "$docker_name" - >/dev/null; then
    docker secret rm "$docker_name" >/dev/null 2>&1 || true
    rollback
    created=()
    die "failed to provision Docker secret $docker_name"
  fi
  created+=("$docker_name")
}

create_secret DISCORD_CLIENT_ID discord_client_id
create_secret DISCORD_CLIENT_SECRET discord_client_secret
trap - ERR INT TERM
printf 'Provisioned Healthchecks Discord Docker secrets from Infisical.\n'
