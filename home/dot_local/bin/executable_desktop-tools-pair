#!/usr/bin/env bash
# desktop-tools-pair — browser-first one-link device enrollment for https://desktop.tools.
# Starts a pairing with the desktop.tools control plane, prints a short code + a browser verify URL
# for the operator to approve, polls until approved, then stores the minted device token locally (0600).
#
# Env seams: DESKTOP_TOOLS_CONTROL_PLANE_URL · DESKTOP_TOOLS_TENANT · DESKTOP_TOOLS_TOKEN_PATH · DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH · DESKTOP_TOOLS_PROFILE_ID · DESKTOP_TOOLS_PROFILE_DIGEST · DESKTOP_TOOLS_PAIR_TIMEOUT · DESKTOP_TOOLS_PAIR_INTERVAL
# Usage: desktop-tools-pair [--force]
set -uo pipefail

DESKTOP_TOOLS_CONTROL_PLANE_URL="${DESKTOP_TOOLS_CONTROL_PLANE_URL:-${AID_CONTROL_PLANE_URL:-https://desktop.tools}}"
DESKTOP_TOOLS_TENANT="${DESKTOP_TOOLS_TENANT:-${AID_TENANT:-_default}}"
DESKTOP_TOOLS_TOKEN_PATH="${DESKTOP_TOOLS_TOKEN_PATH:-${AID_TOKEN_PATH:-$HOME/.config/desktop-tools/device-token}}"
DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH="${DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH:-$HOME/.config/desktop-tools/device-fingerprint}"
DESKTOP_TOOLS_PAIR_TIMEOUT="${DESKTOP_TOOLS_PAIR_TIMEOUT:-${AID_PAIR_TIMEOUT:-300}}"
DESKTOP_TOOLS_PAIR_INTERVAL="${DESKTOP_TOOLS_PAIR_INTERVAL:-${AID_PAIR_INTERVAL:-3}}"
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

log() { command -v gum >/dev/null 2>&1 && gum log --level info -- "$*" || printf '\033[1;36m[desktop-tools-pair]\033[0m %s\n' "$*"; }
err() { command -v gum >/dev/null 2>&1 && gum log --level error -- "$*" || printf '\033[1;31m[desktop-tools-pair]\033[0m %s\n' "$*" >&2; }

isTrue() { case "${1:-}" in 1|true|TRUE|yes|YES|on|ON) return 0 ;; *) return 1 ;; esac; }

writePrivateFile() {
  local destination="$1" directory temporary
  directory="$(dirname "$destination")"
  mkdir -p "$directory" || return 1
  temporary="$(mktemp "$directory/.desktop-tools-secret.XXXXXX")" || return 1
  chmod 600 "$temporary" || { rm -f -- "$temporary"; return 1; }
  if ! cat >"$temporary" || ! mv -f -- "$temporary" "$destination"; then
    rm -f -- "$temporary"
    return 1
  fi
  chmod 600 "$destination" 2>/dev/null || true
}

jsonStr() { printf '%s' "$1" | grep -oE "\"$2\":\"[^\"]*\"" | head -1 | sed -E "s/\"$2\":\"([^\"]*)\"/\1/"; }

openBrowser() {
  isTrue "${HEADLESS_INSTALL:-0}" && return 0
  if command -v open >/dev/null 2>&1; then
    open "$1" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1 || true
  fi
}

main() {
  local u="${DESKTOP_TOOLS_CONTROL_PLANE_URL%/}"
  case "$DESKTOP_TOOLS_TENANT" in ''|*[!a-z0-9._-]*|[-.]* ) err 'tenant identifier is invalid'; return 2 ;; esac
  case "$DESKTOP_TOOLS_PAIR_TIMEOUT" in ''|*[!0-9]*) err 'pair timeout must be an integer from 1 to 3600 seconds'; return 2 ;; esac
  case "$DESKTOP_TOOLS_PAIR_INTERVAL" in ''|*[!0-9]*) err 'pair interval must be an integer from 1 to 60 seconds'; return 2 ;; esac
  if [ "$DESKTOP_TOOLS_PAIR_TIMEOUT" -lt 1 ] || [ "$DESKTOP_TOOLS_PAIR_TIMEOUT" -gt 3600 ]; then
    err 'pair timeout must be an integer from 1 to 3600 seconds'; return 2
  fi
  if [ "$DESKTOP_TOOLS_PAIR_INTERVAL" -lt 1 ] || [ "$DESKTOP_TOOLS_PAIR_INTERVAL" -gt 60 ]; then
    err 'pair interval must be an integer from 1 to 60 seconds'; return 2
  fi
  if [ "$DESKTOP_TOOLS_PAIR_INTERVAL" -gt "$DESKTOP_TOOLS_PAIR_TIMEOUT" ]; then
    err 'pair interval cannot exceed the total timeout'; return 2
  fi
  if [ -L "$DESKTOP_TOOLS_TOKEN_PATH" ] || { [ -e "$DESKTOP_TOOLS_TOKEN_PATH" ] && [ ! -f "$DESKTOP_TOOLS_TOKEN_PATH" ]; }; then
    err "device token path is unsafe: $DESKTOP_TOOLS_TOKEN_PATH"; return 1
  fi
  if [ -s "$DESKTOP_TOOLS_TOKEN_PATH" ] && [ "$FORCE" -ne 1 ]; then
    log "already paired (token at $DESKTOP_TOOLS_TOKEN_PATH); pass --force to re-pair"
    return 0
  fi
  local hostLabel requestBody profileId="${DESKTOP_TOOLS_PROFILE_ID:-}" profileDigest="${DESKTOP_TOOLS_PROFILE_DIGEST:-}" fingerprint=''
  hostLabel="$(hostname 2>/dev/null | tr -cd 'A-Za-z0-9._-' | cut -c1-200)"
  [ -n "$hostLabel" ] || hostLabel=unknown
  requestBody="{\"tenant\":\"${DESKTOP_TOOLS_TENANT}\",\"label\":\"${hostLabel}\",\"permissions\":[\"pull-desired-state\",\"report-status\"]}"
  if [ -n "$profileId" ] || [ -n "$profileDigest" ]; then
    case "$profileId" in ''|*[!a-z0-9._-]*|[-.]* ) err 'profile identifier is invalid'; return 2 ;; esac
    case "$profileDigest" in *[!a-f0-9]*|'') err 'profile digest is invalid'; return 2 ;; esac
    [ "${#profileDigest}" -eq 64 ] || { err 'profile digest is invalid'; return 2; }
    mkdir -p "$(dirname "$DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH")" || return 1
    if [ ! -s "$DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH" ]; then
      od -An -N32 -tx1 /dev/urandom | tr -d ' \n' | writePrivateFile "$DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH" || return 1
    fi
    if [ -L "$DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH" ] || [ ! -f "$DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH" ]; then
      err 'device fingerprint path is unsafe'; return 1
    fi
    chmod 600 "$DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH" 2>/dev/null || true
    fingerprint="$(tr -d '\r\n' < "$DESKTOP_TOOLS_DEVICE_FINGERPRINT_PATH")"
    case "$fingerprint" in *[!a-f0-9]*|'') err 'device fingerprint is invalid'; return 2 ;; esac
    [ "${#fingerprint}" -eq 64 ] || { err 'device fingerprint is invalid'; return 2; }
    requestBody="{\"tenant\":\"${DESKTOP_TOOLS_TENANT}\",\"label\":\"${hostLabel}\",\"permissions\":[\"pull-desired-state\",\"report-status\",\"authorize-privileged-run\"],\"machineFingerprint\":\"${fingerprint}\",\"profileId\":\"${profileId}\",\"profileRevisionDigest\":\"${profileDigest}\"}"
  fi
  log "starting pairing with $u (tenant ${DESKTOP_TOOLS_TENANT})…"
  local start
  start="$(curl -fsS --connect-timeout 5 --max-time 20 -X POST -H 'content-type: application/json' \
    -d "$requestBody" "$u/api/devices/pair/start" 2>/dev/null)"
  local code pollSecret verifyUrl
  code="$(jsonStr "$start" code)"
  pollSecret="$(jsonStr "$start" pollSecret)"
  verifyUrl="$(jsonStr "$start" verifyUrl)"
  [ -z "$verifyUrl" ] && verifyUrl="$u/pair?code=${code}"
  if [ -z "$code" ] || [ -z "$pollSecret" ]; then
    err "pairing start failed: ${start:-no response from $u}"
    return 1
  fi
  printf '\n'
  log "PAIRING CODE:  ${code}"
  log "APPROVE AT:    ${verifyUrl}"
  printf '\n'
  openBrowser "$verifyUrl"
  log "waiting for approval (timeout ${DESKTOP_TOOLS_PAIR_TIMEOUT}s)…"
  local waited=0 resp status errf token deviceId
  while [ "$waited" -lt "$DESKTOP_TOOLS_PAIR_TIMEOUT" ]; do
    local -a claimHeaders=()
    if [ -n "$fingerprint" ]; then
      claimHeaders=(-H "x-desktop-tools-tenant: ${DESKTOP_TOOLS_TENANT}" \
        -H "x-desktop-tools-profile-revision: ${profileDigest}" \
        -H "x-desktop-tools-device-fingerprint: ${fingerprint}")
    fi
    resp="$(curl -sS --connect-timeout 5 --max-time 20 -H "authorization: Bearer ${pollSecret}" \
      "${claimHeaders[@]}" "$u/api/devices/pair/poll" 2>/dev/null || true)"
    status="$(jsonStr "$resp" status)"
    errf="$(jsonStr "$resp" error)"
    case "$status" in
    claimed)
      token="$(jsonStr "$resp" token)"
      deviceId="$(jsonStr "$resp" deviceId)"
      if [ -z "$token" ]; then
        err "pairing claimed but no token in response"
        return 1
      fi
      printf '%s' "$token" | writePrivateFile "$DESKTOP_TOOLS_TOKEN_PATH" || { err 'could not store the device token safely'; return 1; }
      log "paired ✓ device ${deviceId} — token stored at ${DESKTOP_TOOLS_TOKEN_PATH} (mode 0600)"
      return 0
      ;;
    denied | revoked | cancelled)
      err "pairing ended without authorization: ${status}"
      return 1
      ;;
    expired)
      err "pairing expired before approval"
      return 1
      ;;
    esac
    case "$errf" in
    already_claimed | not_found)
      err "pairing not claimable: ${errf}"
      return 1
      ;;
    esac
    sleep "$DESKTOP_TOOLS_PAIR_INTERVAL"
    waited=$((waited + DESKTOP_TOOLS_PAIR_INTERVAL))
  done
  err "pairing timed out after ${DESKTOP_TOOLS_PAIR_TIMEOUT}s (never approved)"
  return 1
}

main "$@"
