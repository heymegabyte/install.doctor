#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for target in "$SCRIPT_DIR/populate-secrets.ts" "$SCRIPT_DIR/executable_populate-secrets.ts"; do
  if [ -f "$target" ]; then
    exec node --experimental-strip-types "$target" "$@"
  fi
done
printf 'populate-secrets.ts not found beside launcher\n' >&2
exit 1
