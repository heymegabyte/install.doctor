#!/usr/bin/env bash

set -Eeo pipefail
trap "rm -f ~/.gist" ERR

### Load the validated canonical GitHub token using envchain
if command -v envchain > /dev/null; then
    export $(envchain default env | grep 'GITHUB_TOKEN')
    echo "$GITHUB_TOKEN" > ~/.gist
fi

### Pass command to gist
gist $*

### Remove home directory clutter
rm -f ~/.gist
