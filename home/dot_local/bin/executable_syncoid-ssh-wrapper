#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for target in "$SCRIPT_DIR/syncoid-ssh-wrapper.ts" "$SCRIPT_DIR/executable_syncoid-ssh-wrapper.ts"; do
  if [ -f "$target" ]; then
    exec node --experimental-strip-types "$target" "$@"
  fi
done
printf 'syncoid-ssh-wrapper.ts not found beside launcher\n' >&2
exit 1
