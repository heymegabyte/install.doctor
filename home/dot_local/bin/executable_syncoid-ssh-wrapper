#!/usr/bin/env python3
"""Restricted forced-command adapter for read-only Syncoid source access."""

from __future__ import annotations

import os
import shlex
import subprocess
import sys
from collections.abc import Sequence


READ_ONLY_ZFS = {"get", "holds", "list", "send"}
READ_ONLY_ZPOOL = {"get", "list", "status"}
FILTERS = {"lzop", "mbuffer", "pv", "zstd"}
FORBIDDEN_TOKENS = {";", "&&", "||", ">", ">>", "<", "<<", "&"}


def reject(message: str) -> "NoReturn":
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def validate_segment(arguments: Sequence[str], position: int, total: int) -> None:
    if not arguments:
        reject("empty pipeline segment")
    executable = arguments[0]
    if "/" in executable:
        reject("executable paths are not allowed")
    if executable == "zfs":
        if position != 0 or len(arguments) < 2 or arguments[1] not in READ_ONLY_ZFS:
            reject("unauthorized zfs operation")
        if arguments[1] == "send" and any(
            argument.startswith("--output") or argument in {"-o", "--raw"}
            for argument in arguments[2:]
        ):
            reject("output and raw-file options are not allowed")
        return
    if executable == "zpool":
        if total != 1 or len(arguments) < 2 or arguments[1] not in READ_ONLY_ZPOOL:
            reject("unauthorized zpool operation")
        return
    if executable in FILTERS:
        if position == 0:
            reject("filters require an allowlisted producer")
        return
    if executable == "command" and total == 1 and list(arguments[1:2]) == ["-v"] and len(arguments) == 3:
        if arguments[2] not in FILTERS | {"zfs", "zpool"}:
            reject("command lookup is outside the allowlist")
        return
    reject("executable is outside the allowlist")


def parse(command: str) -> list[list[str]]:
    if not command or len(command) > 16_384 or "\n" in command or "\r" in command or "\x00" in command:
        reject("missing or malformed forced command")
    try:
        tokens = shlex.split(command, posix=True)
    except ValueError:
        reject("invalid shell quoting")
    if any(token in FORBIDDEN_TOKENS or "$" in token or "`" in token for token in tokens):
        reject("shell expansion and redirection are not allowed")
    segments: list[list[str]] = [[]]
    for token in tokens:
        if token == "|":
            segments.append([])
        else:
            segments[-1].append(token)
    for index, segment in enumerate(segments):
        validate_segment(segment, index, len(segments))
    return segments


def execute(segments: Sequence[Sequence[str]]) -> int:
    processes: list[subprocess.Popen[bytes]] = []
    previous_stdout = None
    for index, segment in enumerate(segments):
        process = subprocess.Popen(
            list(segment),
            stdin=previous_stdout,
            stdout=subprocess.PIPE if index < len(segments) - 1 else None,
            close_fds=True,
            env={"PATH": os.environ.get("PATH", "/usr/sbin:/usr/bin:/sbin:/bin"), "LANG": "C"},
        )
        if previous_stdout is not None:
            previous_stdout.close()
        previous_stdout = process.stdout
        processes.append(process)
    statuses = [process.wait() for process in processes]
    return next((status for status in statuses if status != 0), 0)


if __name__ == "__main__":
    raise SystemExit(execute(parse(os.environ.get("SSH_ORIGINAL_COMMAND", ""))))
