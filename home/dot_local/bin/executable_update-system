#!/usr/bin/env bash
# Keeps the host current: every PRESENT package manager + mise-managed runtimes + the install.doctor
# config itself. Invoked weekly by the Monday-02:00 crontab entry (home/dot_config/crontab/config-user)
# and runnable by hand. set -u safe — a bare cron environment has no DEBUG, so all optional env vars are
# default-expanded (a bare "$DEBUG" under `set -u` would abort the ENTIRE update with "unbound variable").
# Every updater is command-guarded, so it is a no-op where its manager is absent (minimum-footprint hosts).

set -euo pipefail

updateApk() {
  if command -v apk > /dev/null; then
    gum log -sl info 'Running sudo apk update' && sudo apk update || gum log -sl error 'Failed to run sudo apk update'
    gum log -sl info 'Running sudo apk upgrade' && sudo apk upgrade || gum log -sl error 'Failed to run sudo apk upgrade'
  fi
}

updateAptGet() {
  if command -v apt-get > /dev/null; then
    gum log -sl info 'Running sudo apt-get update' && sudo apt-get update || gum log -sl error 'Failed to run sudo apt-get update'
    gum log -sl info 'Running sudo apt-get upgrade -y' && sudo apt-get upgrade -y || gum log -sl error 'Failed to run sudo apt-get upgrade -y'
  fi
}

updateBrew() {
  if command -v brew > /dev/null; then
    gum log -sl info 'Running brew update' && brew update || gum log -sl error 'Failed to run brew update'
    gum log -sl info 'Running brew upgrade' && brew upgrade || gum log -sl error 'Failed to run brew upgrade'
    if [ -d /Applications ] && [ -d /System ]; then
      ### macOS
      gum log -sl info 'Running brew upgrade --cask' && brew upgrade --cask || gum log -sl error 'Failed to run brew upgrade --cask'
    fi
  fi
}

updateCrew() {
  if command -v crew > /dev/null; then
    gum log -sl info 'Running crew update' && crew update || gum log -sl error 'Failed to run crew update'
  fi
}

updateDnf() {
  if command -v dnf > /dev/null; then
    gum log -sl info 'Running sudo dnf update -y' && sudo dnf update -y || gum log -sl error 'Failed to run sudo dnf update -y'
  fi
}

updateFlatpak() {
  if command -v flatpak > /dev/null; then
    gum log -sl info 'Running flatpak update -y' && flatpak update -y || gum log -sl error 'Failed to run flatpak update -y'
  fi
}

updatePacman() {
  if command -v pacman > /dev/null; then
    ### --noconfirm so the unattended Monday-02:00 cron never hangs on a prompt
    gum log -sl info 'Running sudo pacman -Syu --noconfirm' && sudo pacman -Syu --noconfirm || gum log -sl error 'Failed to run sudo pacman -Syu'
  fi
}

updateSnap() {
  if command -v snap > /dev/null; then
    gum log -sl info 'Running sudo snap refresh' && sudo snap refresh || gum log -sl error 'Failed to run sudo snap refresh'
  fi
}

updateZypper() {
  if command -v zypper > /dev/null; then
    ### -y so the unattended Monday-02:00 cron never hangs on a prompt
    gum log -sl info 'Running sudo zypper --non-interactive update' && sudo zypper --non-interactive update || gum log -sl error 'Failed to run sudo zypper update'
  fi
}

### Language package managers the cnf lazy-installer resolves through (__cnf_pref: … npm pipx … gem). The OS
### managers + mise cover most tools, but a CLI installed via `npm install -g` / `pipx install` / `gem install`
### is kept current ONLY here — else the Monday-02:00 "everything updated" promise silently skips them (same
### install-vs-update contract as #267's apk-in-cron). Each has a CLEAN, non-interactive update-ALL safe for the
### unattended cron. cargo + go are omitted deliberately (no safe unattended update-all — cargo needs the
### cargo-update crate; `go install` re-fetches per-binary); pip --user upgrade-all is too fragile unattended.
updateNpm() {
  if command -v npm > /dev/null; then
    gum log -sl info 'Running npm update -g' && npm update -g || gum log -sl error 'Failed to run npm update -g'
  fi
}

updatePipx() {
  if command -v pipx > /dev/null; then
    gum log -sl info 'Running pipx upgrade-all' && pipx upgrade-all || gum log -sl error 'Failed to run pipx upgrade-all'
  fi
}

updateGem() {
  if command -v gem > /dev/null; then
    ### user-scope gems only (matches the cnf hook's `gem install`, no sudo); `--system` is intentionally NOT run.
    gum log -sl info 'Running gem update' && gem update || gum log -sl error 'Failed to run gem update'
  fi
}

### mise owns version-managed runtimes (ADR 0003 — Node.js / Go / Rust et al). Upgrade the tools + mise itself.
updateMise() {
  if command -v mise > /dev/null; then
    gum log -sl info 'Running mise upgrade' && mise upgrade --yes || gum log -sl error 'Failed to run mise upgrade'
    mise self-update --yes > /dev/null 2>&1 || true
  fi
}

### chezmoi pulls + applies the latest install.doctor config, so the host keeps improving over time.
updateChezmoi() {
  if command -v chezmoi > /dev/null; then
    gum log -sl info 'Running chezmoi update (pull + apply the latest install.doctor config)' && chezmoi update || gum log -sl error 'Failed to run chezmoi update'
  fi
}

if [ -n "${DEBUG:-}" ] || [ -n "${DEBUG_MODE:-}" ]; then
  gum log -sl info 'DEBUG/DEBUG_MODE is set — running updates synchronously'
  updateApk
  updateAptGet
  updateBrew
  updateCrew
  updateDnf
  updateFlatpak
  updatePacman
  updateSnap
  updateZypper
  updateNpm
  updatePipx
  updateGem
  updateMise
  updateChezmoi
else
  ### OS package managers are independent — run them in parallel, then settle.
  updateApk &
  updateAptGet &
  updateBrew &
  updateCrew &
  updateDnf &
  updateFlatpak &
  updatePacman &
  updateSnap &
  updateZypper &
  updateNpm &
  updatePipx &
  updateGem &
  wait
  ### mise + chezmoi run AFTER the package managers settle (chezmoi apply may itself invoke them).
  updateMise
  updateChezmoi
fi

gum log -sl info 'Finished running update-system'
