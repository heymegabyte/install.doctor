#!/usr/bin/env zx

$.verbose = false
// Preserves color from subshells
//process.env.CLICOLOR_FORCE = 3

let installOrder, osArch, osId, osType, pkgs, sysType, chezmoiConfig, isHeadless
const cacheDir = os.homedir() + '/.cache/installx'
const IMPLEMENTED_PROVIDER_TYPES = new Set([
  'apk', 'apt', 'basher', 'baulk', 'brew', 'cargo', 'cask', 'choco',
  'crew', 'dnf', 'emerge', 'flatpak', 'gem', 'go', 'npm', 'pacman',
  'pip', 'pipx', 'pkg_add', 'rpm-ostree', 'scoop', 'snap', 'winget', 'xbps', 'yay',
  'yum', 'zypper'
])

const customArgv = minimist(process.argv.slice(3), {
  boolean: [
    'all',
    'lazy',
    'check'
  ],
  string: [
    'tier'
  ],
  alias: {
    a: 'all',
    l: 'lazy',
    c: 'check',
    t: 'tier'
  }
})

function log(message) {
  if (customArgv.check) return
  console.log(`${chalk.greenBright.bold('installx ❯')} ${message}`)
}

function hasMutableGoReference(instruction) {
  if (instruction.installType !== 'go') return false
  return instruction.installList.some(value => !/@v\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$/.test(String(value)))
}

async function getOsInfo() {
  const arch = process.arch === 'x64' ? 'x64' : process.arch === 'arm64' ? 'arm64' : process.arch
  if (process.platform !== 'linux') return { arch, id: process.platform }
  try {
    const release = fs.readFileSync('/etc/os-release', 'utf8')
    const match = release.match(/^ID=(?:"([^"]+)"|'([^']+)'|([^\n]+))$/m)
    const id = (match?.[1] || match?.[2] || match?.[3] || 'linux').trim().toLowerCase()
    return { arch, id }
  } catch {
    return { arch, id: 'linux' }
  }
}

function execPromise(command) {
  return new Promise(function (resolve, reject) {
    require('child_process').exec(command, (error, stdout, stderr) => {
      if (error) {
        reject(error)
        return
      }
      resolve(stdout.trim())
    })
  })
}

function getPkgData(pref, pkg, installer) {
  if (installer) {
    if (pkg[`${pref}:${installer}:${osId}:${osArch}`]) {
      return `${pref}:${installer}:${osId}:${osArch}` // Handles case like `_bin:pipx:debian:x64:`
    } else if (pkg[`${pref}:${osId}:${installer}:${osArch}`]) {
      return `${pref}:${osId}:${installer}:${osArch}` // Handles case like `_bin:debian:pipx:x64:`
    } else if (pkg[`${pref}:${installer}:${osType}:${osArch}`]) {
      return `${pref}:${installer}:${osType}:${osArch}` // Handles case like `_bin:pipx:windows:x64:`
    } else if (pkg[`${pref}:${osType}:${installer}:${osArch}`]) {
      return `${pref}:${osType}:${installer}:${osArch}` // Handles case like `_bin:windows:pipx:x64:`
    } else if (pkg[`${pref}:${installer}:${osId}`]) {
      return `${pref}:${installer}:${osId}` // Handles case like `_bin:pipx:fedora:`
    } else if (pkg[`${pref}:${osId}:${installer}`]) {
      return `${pref}:${osId}:${installer}` // Handles case like `_bin:fedora:pipx:`
    } else if (pkg[`${pref}:${installer}:${osType}`]) {
      return `${pref}:${installer}:${osType}` // Handles case like `_bin:pipx:darwin:`
    } else if (pkg[`${pref}:${osType}:${installer}`]) {
      return `${pref}:${osType}:${installer}` // Handles case like `_bin:darwin:pipx:`
    } else if (pkg[`${pref}:${installer}`]) {
      return `${pref}:${installer}` // Handles case like `_bin:pipx:`
    } else if (pkg[`${pref}`]) {
      return `${pref}` // Handles case like `_bin:`
    } else {
      return false
    }
  } else {
    if (pkg[`${pref}:${osId}:${osArch}`]) {
      return `${pref}:${osId}:${osArch}` // Handles case like `pipx:debian:x64:`
    } else if (pkg[`${pref}:${osType}:${osArch}`]) {
      return `${pref}:${osType}:${osArch}` // Handles case like `pipx:windows:x64:`
    } else if (pkg[`${pref}:${osId}`]) {
      return `${pref}:${osId}` // Handles case like `pipx:fedora:`
    } else if (pkg[`${pref}:${osType}`]) {
      return `${pref}:${osType}` // Handles case like `pipx:darwin:`
    } else if (pkg[`${pref}`]) {
      return `${pref}` // Handles case like `pipx:`
    } else {
      return false
    }
  }
}

async function getSoftwareDefinitions() {
  try {
    // Try to read from chezmoi source directory first
    const chezmoiSourceDir = `${os.homedir()}/.local/share/chezmoi`
    const fallbackPath = `${os.homedir()}/.local/share/install.doctor/software.yml`
    
    let softwareYmlPath = `${chezmoiSourceDir}/software.yml`
    
    // If the file doesn't exist in chezmoi source, try fallback location
    if (!fs.existsSync(softwareYmlPath)) {
      if (fs.existsSync(fallbackPath)) {
        softwareYmlPath = fallbackPath
      } else {
        // Try current working directory as last resort
        const cwdPath = `${process.cwd()}/software.yml`
        if (fs.existsSync(cwdPath)) {
          softwareYmlPath = cwdPath
        } else {
          throw new Error(`software.yml not found in any of the expected locations: ${softwareYmlPath}, ${fallbackPath}, ${cwdPath}`)
        }
      }
    }
    
    return YAML.parse(fs.readFileSync(softwareYmlPath, 'utf8'))
  } catch (e) {
    throw Error('Failed to load software definitions', e)
  }
}

async function getChezmoiConfig() {
  try {
    return YAML.parse(fs.readFileSync(`${os.homedir()}/.config/chezmoi/chezmoi.yaml`, 'utf8'))
  } catch (e) {
    throw Error('Failed to load Chezmoi configuration', e)
  }
}

async function getSystemType() {
  if (process.platform === "win32") {
    return "windows"
  } else if (process.platform === "linux") {
    if (fs.existsSync('/run/ostree-booted') && which.sync('rpm-ostree', { nothrow: true })) {
      return "dnf"
    } else if (which.sync('apk', { nothrow: true })) {
      return "apk"
    } else if (which.sync('apt-get', { nothrow: true })) {
      return "apt"
    } else if (which.sync('dnf', { nothrow: true })) {
      return "dnf"
    } else if (which.sync('pacman', { nothrow: true })) {
      return "pacman"
    } else if (which.sync('zypper', { nothrow: true })) {
      return "zypper"
    } else {
      return "linux"
    }
  } else {
    return process.platform
  }
}

function expandDeps(keys, seen = new Set(), visiting = new Set()) {
  const expanded = []
  for (const i of keys) {
    if (!pkgs[i]) throw new Error(`unknown package dependency: ${i}`)
    if (visiting.has(i)) throw new Error(`dependency cycle detected at package: ${i}`)
    if (seen.has(i)) continue
    visiting.add(i)
    seen.add(i)
    expanded.push(i)
    for (const pref of installOrder[sysType]) {
      const installKey = getPkgData(pref, pkgs[i], false)
      if (installKey) {
        const installType = installKey.split(':')[0]
        const depsKey = getPkgData('_deps', pkgs[i], installType)
        if (depsKey) {
          const deps = typeof pkgs[i][depsKey] === 'string' ? [pkgs[i][depsKey]] : pkgs[i][depsKey]
          expanded.push(...expandDeps(deps, seen, visiting))
        }
      }
    }
    visiting.delete(i)
  }
  return expanded
}

function missingDependencies(keys, seen = new Set(), missing = new Set()) {
  for (const key of keys) {
    if (seen.has(key)) continue
    seen.add(key)
    const pkg = pkgs[key]
    if (!pkg) {
      missing.add(key)
      continue
    }
    for (const pref of installOrder[sysType]) {
      const installKey = getPkgData(pref, pkg, false)
      if (!installKey) continue
      const depsKey = getPkgData('_deps', pkg, installKey.split(':')[0])
      if (!depsKey) break
      const deps = typeof pkg[depsKey] === 'string' ? [pkg[depsKey]] : pkg[depsKey]
      missingDependencies(deps, seen, missing)
      break
    }
  }
  return [...missing].sort()
}

async function createCaskLinks(caskMap) {
  if (!caskMap) return
  const engineOwnedRaw = process.env.INSTALL_DOCTOR_ENGINE_CASK_LAUNCHERS || ''
  if (engineOwnedRaw && !/^[a-z0-9._:+-]+(?:,[a-z0-9._:+-]+)*$/.test(engineOwnedRaw)) {
    throw new Error('INSTALL_DOCTOR_ENGINE_CASK_LAUNCHERS is malformed')
  }
  const engineOwned = new Set(engineOwnedRaw.split(',').filter(Boolean))
  const caskApps = caskMap
    .filter(x => {
      if (engineOwned.has(x.listKey)) return false
      // Filter out macOS apps that already have a _app installed
      if (x.installType === 'cask' || (osId === 'darwin' && x._app)) {
        const appField = getPkgData('_app', x, x.installType)
        const binField = getPkgData('_bin', x, x.installType)
        const sysDir = fs.existsSync(`/Applications/${x[appField]}`)
        const homeDir = fs.existsSync(`${os.homedir()}/Applications/${x[appField]}`)
        const binFile = fs.existsSync(`${os.homedir()}/.local/bin/cask/${x[binField]}`)
        if (sysDir || homeDir) {
          return !binFile
        } else {
          return false
        }
      } else {
        return false
      }
    })
  caskApps.length && await $`mkdir -p "$HOME/.local/bin/cask"`
  for (const app of caskApps) {
    const appField = getPkgData('_app', app, app.installType)
    if (!appField) {
      log(`${app.listKey} is missing an _app definition`)
      return
    }
    const binField = getPkgData('_bin', app, app.installType)
    if (!binField) {
      log(`${app.listKey} is missing a _bin definition`)
      return
    }
    if (fs.existsSync(`${os.homedir()}/Applications/${app[appField]}`)) {
      fs.writeFileSync(`${os.homedir()}/.local/bin/cask/${app[binField]}`, `#!/usr/bin/env bash\nopen "$HOME/Applications/${app[appField]}" "$@"`)
      await $`chmod +x '${os.homedir()}/.local/bin/cask/${app[binField]}'`
    } else if (fs.existsSync(`/Applications/${app[appField]}`)) {
      fs.writeFileSync(`${os.homedir()}/.local/bin/cask/${app[binField]}`, `#!/usr/bin/env bash\nopen "/Applications/${app[appField]}" "$@"`)
      await $`chmod +x '${os.homedir()}/.local/bin/cask/${app[binField]}'`
    } else {
      log(`Unable to create bin link to ${app[appField]}`)
    }
  }
  caskApps.length && log(`Finished creating Homebrew cask links in ~/.local/bin/cask`)
}

async function createFlatpakLinks(flatpakMap) {
  const flatpakInstallations = await $`flatpak --installations`
  const flatpakDir = flatpakInstallations.stdout.replace('\n', '')
  const flatpakApps = flatpakMap
    .filter(x => {
      if (x.installType === 'flatpak') {
        const binField = getPkgData('_bin', x, x.installType)
        const binFile = fs.existsSync(`${os.homedir()}/.local/bin/flatpak/${x[binField]}`)
        return !binFile
      }
      return false
    })
  flatpakApps.length && await $`mkdir -p "$HOME/.local/bin/flatpak"`
  for (const app of flatpakApps) {
    const binField = getPkgData('_bin', app, app.installType)
    if (!binField) {
      log(`${app.listKey} is missing a _bin definition`)
      return
    }
    if (fs.existsSync(`${flatpakDir}/app/${app.installList[0]}`)) {
      fs.writeFileSync(`${os.homedir()}/.local/bin/flatpak/${app[binField]}`, `#!/usr/bin/env bash\nflatpak run ${app.installList[0]} "$@"`)
      await $`chmod +x '${os.homedir()}/.local/bin/flatpak/${app[binField]}'`
    } else {
      log(`Unable to create bin link to ${app.installList[0]}`)
    }
  }
  flatpakApps.length && log(`Finished creating Flatpak links in ~/.local/bin/flatpak`)
}

async function bundleInstall(brews, casks, caskMap) {
  const bundleDir = fs.mkdtempSync(path.join(os.tmpdir(), 'installx-brew-'))
  const brewfile = path.join(bundleDir, 'Brewfile')
  try {
    const lines = []
    casks.length && log(`Adding following casks to Brewfile for installation: ${casks.join(' ')}`)
    for (const cask of casks) {
      if (cask.indexOf('/') !== -1) {
        lines.push(`tap "${cask.substring(0, cask.lastIndexOf('/'))}"`)
      }
      if (cask.indexOf(' --no-quarantine') === -1) {
        lines.push(`cask "${cask}"`)
      } else {
        lines.push(`cask "${cask.replace(' --no-quarantine', '')}", args: { "no-quarantine": true }`)
      }
    }
    brews.length && log(`Adding following brews to Brewfile for installation: ${brews.join(' ')}`)
    for (const brew of brews) {
      if (brew.indexOf('/') !== -1) {
        lines.push(`tap "${brew.substring(0, brew.lastIndexOf('/'))}"`)
      }
      lines.push(`brew "${brew}"`)
    }
    log(`Creating Brewfile to install from`)
    fs.writeFileSync(brewfile, lines.join('\n'))
    log(`Installing packages via brew bundle`)
    await $`brew bundle --file ${brewfile}`
    log(`Finished installing via Brewfile`)
  } catch (e) {
    console.log('Error:', e)
    log(`Error occurred while installing via Brewfile`)
    throw e
  } finally {
    fs.rmSync(bundleDir, { recursive: true, force: true })
  }

  try {
    await createCaskLinks(caskMap)
  } catch (e) {
    console.log('Error:', e)
    log(`Error occurred while creating cask bin links`)
    throw e
  }
}

async function forEachSeries(iterable) {
  for (const task of iterable) {
    await (typeof task === 'function' ? task() : task)
  }
}

async function installPackages(pkgInstructions) {
  const combined = {}
  const tasks = []
  log(`Populating install order lists`)
  for (const option of installOrder[sysType]) {
    const instructions = pkgInstructions.filter(x => x.installType === option).filter((value, index, array) => array.indexOf(value) === index)
    if (instructions.length) {
      combined[option] = instructions
    }
  }
  log(`Running Homebrew installation via Brewfile`)
  if ((combined.brew && combined.brew.length) || (combined.cask && combined.cask.length)) {
    tasks.push(() => bundleInstall(combined.brew ? combined.brew.flatMap(x => x.installList.flatMap(i => i)) : [], combined.cask ? combined.cask.flatMap(x => x.installList.flatMap(i => i)) : [], combined.cask))
  }
  for (const key of Object.keys(combined)) {
    if (key !== 'script') {
      log(`Install orders for ${key}: ${combined[key].flatMap(i => i.installList).join(' ')}`)
    }
    switch (key) {
      case 'apk':
        const apkPackages = combined[key]?.flatMap(x => x.installList || []) || []
        if (apkPackages.length > 0) {
          tasks.push(() => $`sudo ${key} add ${apkPackages.join(' ')}`)
        }
        break
      case 'appimage':
        tasks.push(() => {
          throw new Error('appimage provider is disabled until the catalog binds an immutable URL, SHA-256 digest, size, and destination')
        })
        break
      case 'apt':
        const packages = combined[key]?.flatMap(x => x.installList || []) || []
        if (packages.length > 0) {
          tasks.push(() => $`DEBIAN_FRONTEND=noninteractive sudo apt-get -o DPkg::Options::=--force-confdef install -y ${packages}`)
        }
        break
      case 'pipx':
        tasks.push(...combined[key].flatMap(x => x.installList.flatMap(i => () => $`uv tool install ${i.split(' ')}`)))
        break
      case 'basher':
      case 'baulk':
      case 'cargo':
      case 'crew':
      case 'gem':
      case 'go':
      case 'pip':
      case 'scoop': // Maybe needs forEachSeries
      case 'winget': // Maybe needs forEachSeries
        tasks.push(...combined[key].flatMap(x => x.installList.flatMap(i => () => $`${key} install ${i.split(' ')}`)))
        break
      case 'npm':
        tasks.push(...combined[key].flatMap(x => x.installList.flatMap(i => () => $`volta install ${i}`)))
        break
      case 'binary':
        tasks.push(() => {
          throw new Error('binary provider is disabled until the catalog binds an immutable URL, SHA-256 digest, size, and destination')
        })
        break
      case 'brew':
      case 'cask': // Handled above
        break
      case 'choco':
        tasks.push(() => $`${key} install -y ${combined[key].flatMap(x => x.installList).join(' ')}`)
        break
      case 'dnf':
      case 'yum':
        if (fs.existsSync('/run/ostree-booted') && which.sync('rpm-ostree', { nothrow: true })) {
          tasks.push(() => $`sudo rpm-ostree install --idempotent --allow-inactive ${combined[key].flatMap(x => x.installList)}`)
        } else {
          tasks.push(() => $`sudo ${key} install -y ${combined[key].flatMap(x => x.installList).join(' ')}`)
        }
        break
      case 'rpm-ostree':
        tasks.push(() => $`sudo rpm-ostree install --idempotent --allow-inactive ${combined[key].flatMap(x => x.installList)}`)
        break
      case 'zypper':
        tasks.push(() => $`sudo ${key} --non-interactive install -y ${combined[key].flatMap(x => x.installList).join(' ')}`)
        break
      case 'emerge':
      case 'pkg_add':
        tasks.push(() => $`sudo ${key} ${combined[key].flatMap(x => x.installList).join(' ')}`)
        break
      case 'snap':
        const command = `${combined[key].flatMap(x => x.installList).join(' ')}`
        process.env.DEBUG && console.log(command)
        const items = command.match(/\S+/g) || []
        process.env.DEBUG && console.log(items)
        let classicInstall = []
        let regularInstall = []
        // Split the command into individual items
        let previousItem = ""
        items.forEach(item => {
          if (item === '--classic') {
            classicInstall.push(previousItem)
          } else if (!item.startsWith("--")) {
            // Add non-flag items to regularInstall temporarily
            regularInstall.push(item)
          }
          previousItem = item
        })

        // Filter out items that were moved to classicInstall from regularInstall
        regularInstall = regularInstall.filter(item => !classicInstall.includes(item))

        if (classicInstall.length > 0) {
          process.env.DEBUG && log(`DEBUG: sudo snap install ${classicInstall.join(' ')} --classic`)
          tasks.push(() => $`sudo snap install ${['--classic', ...classicInstall]}`)
        }

        if (regularInstall.length > 0) {
          process.env.DEBUG && log(`DEBUG: sudo snap install ${regularInstall.join(' ')}`)
          tasks.push(() => $`sudo snap install ${regularInstall}`)
        }
        break
      case 'flatpak':
        tasks.push(() => forEachSeries(combined[key].flatMap(x => x.installList.flatMap(i => () => $`sudo ${key} install -y flathub ${i}`))))
        break
      case 'github':
      case 'pkg-darwin':
      case 'sbopkg':
      case 'eopkg':
      case 'pkg-freebsd':
      case 'pkg-termux':
      case 'pkgin':
      case 'pkg':
        throw new Error(`catalog provider '${key}' has no verified check/apply/verify adapter`)
      case 'pacman':
        tasks.push(() => $`sudo ${key} -Sy --noconfirm --needed ${combined[key].flatMap(x => x.installList).join(' ')}`)
        break
      case 'script':
        throw new Error(`catalog script providers are unsupported; migrate to a package manager or immutable artifact descriptor: ${combined[key].map(x => x.listKey).sort().join(',')}`)
      case 'xbps':
        tasks.push(() => $`sudo xbps-install -S ${combined[key].flatMap(x => x.installList).join(' ')}`)
        break
      case 'yay':
        tasks.push(() => $`yay -Sy --noconfirm --needed ${combined[key].flatMap(x => x.installList).join(' ')}`)
        break
      default:
        throw new Error(`catalog provider '${key}' is unknown or has no verified adapter`)
    }
  }
  // Start commands only when a bounded worker claims them. Constructing zx
  // ProcessPromises earlier starts the processes and defeats throttling.
  const CONCURRENCY = Math.min(16, Math.max(1, parseInt(process.env.INSTALLX_CONCURRENCY || process.env.INSTALL_DOCTOR_CONCURRENCY || '4', 10) || 4))
  log(`Performing ${tasks.length} installations (concurrency=${CONCURRENCY})`)
  const installs = new Array(tasks.length)
  let cursor = 0
  async function worker() {
    while (cursor < tasks.length) {
      const index = cursor++
      try {
        installs[index] = { status: 'fulfilled', value: await tasks[index]() }
      } catch (reason) {
        installs[index] = { status: 'rejected', reason }
      }
    }
  }
  await Promise.all(Array.from({ length: Math.min(CONCURRENCY, tasks.length || 1) }, worker))
  const failures = installs.filter(result => result.status === 'rejected')
  if (failures.length) {
    failures.forEach(({ reason }) => console.error(reason))
    throw new Error(`${failures.length} installation task(s) failed`)
  }
  log(`All of the installations have finished`)
  process.env.DEBUG && console.log('Completed installs:', installs)
  await postInstall(combined)
}

async function postInstall(combined) {
  log(`Running post-install routine`)
  const promises = []
  Object.keys(combined).includes('flatpak') && promises.push(createFlatpakLinks(combined.flatpak))
  const postInstalls = await Promise.allSettled(promises)
  const postInstallFailures = postInstalls.filter(result => result.status === 'rejected')
  if (postInstallFailures.length) {
    postInstallFailures.forEach(({ reason }) => console.error(reason))
    throw new Error(`${postInstallFailures.length} post-install task(s) failed`)
  }
  process.env.DEBUG && console.log('Post installs:', postInstalls)
}

async function acquireManagerList(type, command, persist = true) {
  if (which.sync(type, { nothrow: true })) {
    const cacheFile = path.join(cacheDir, type)
    const output = await execPromise(command)
    if (persist) fs.writeFileSync(cacheFile, `${output}\n`, { mode: 0o600 })
    return output.split('\n')
  } else {
    log(`${type} is not installed`)
    return []
  }
}

// Resolve versioned package name per package manager syntax:
//   brew: pkg@version   npm: pkg@version   pipx: pkg==version
//   cargo: pkg@version  go: pkg@version    apt: pkg=version
function versionedPkg(pkgName, version, manager) {
  if (!version) return pkgName
  switch (manager) {
    case 'pipx': case 'pip': return `${pkgName}==${version}`
    case 'apt':  case 'apk': return `${pkgName}=${version}`
    default:     return `${pkgName}@${version}`
  }
}

function pkgMap(pkgDefs) {
  return pkgDefs
    .map(i => {
      for (const pref of installOrder[sysType]) {
        const installKey = getPkgData(pref, pkgs[i], false)
        if (installKey) {
          const rawList = typeof pkgs[i][installKey] === 'string' ? [pkgs[i][installKey]] : pkgs[i][installKey]
          const version = pkgs[i]._version
          const installList = version
            ? rawList.map(name => versionedPkg(name, version, installKey.split(':')[0]))
            : rawList
          if (version) {
            log(`  📌 ${i} pinned to ${version}`)
          }
          return {
            ...pkgs[i],
            listKey: i,
            installKey,
            installType: installKey.split(':')[0],
            installList
          }
        }
      }
      return {
        ...pkgs[i],
        listKey: i,
        installKey: false,
        installType: false,
        installList: []
      }
    })
    .filter(x => x.installKey)
}

async function checkIfHeadless() {
  if (/^(?:1|true|yes)$/i.test(process.env.HEADLESS_INSTALL || '')) return true
  try {
    process.env.DEBUG && log('Checking if session is headless')
    runSilentCommand(`if [ -d /System ] && [ -d /Applications ]; then system_profiler SPDisplaysDataType > /dev/null 2>&1; else xrandr --listmonitors > /dev/null 2>&1; fi`)
    return false
  } catch (e) {
    return true
  }
}


async function main() {
  if (!customArgv.check) await $`mkdir -p ${cacheDir}`
  log(`Acquiring software definitions and system information`)
  const initData = await Promise.all([
    getOsInfo(),
    getSoftwareDefinitions(),
    getSystemType(),
    getChezmoiConfig(),
    checkIfHeadless()
  ])
  osArch = initData[0].arch
  osId = process.platform === 'win32' ? 'win32' : (process.platform === 'linux' ? initData[0].id : process.platform)
  osType = process.platform === 'win32' ? 'windows' : process.platform
  pkgs = initData[1].softwarePackages
  sysType = initData[2]
  chezmoiConfig = initData[3]
  isHeadless = initData[4]
  installOrder = initData[1].installerPreference
  log(`Populating lists of pre-installed packages`)
  const listPromises = [
    acquireManagerList('apt', `if command -v dpkg; then dpkg -l; fi`, !customArgv.check),
    acquireManagerList('brew', `brew list -1`, !customArgv.check),
    acquireManagerList('cargo', `cargo install --list | awk '/^[[:alnum:]]/ {print $1}'`, !customArgv.check),
    acquireManagerList('dnf', `rpm -qa`, !customArgv.check),
    acquireManagerList('flatpak', `flatpak --columns=app list`, !customArgv.check),
    acquireManagerList('gem', `gem list | awk '{print $1}'`, !customArgv.check),
    acquireManagerList('npm', `volta list --format plain | awk '{print $2}' | sed 's/@.*//'`, !customArgv.check),
    acquireManagerList('pacman', `pacman -Qs`, !customArgv.check),
    acquireManagerList('pip', `pip3 list | awk '{print $1}'`, !customArgv.check),
    // `pipx:` remains the catalog provider name for compatibility, but uv is
    // the execution backend. Inventory uv's tool environments so idempotency
    // does not reinstall every Python CLI on each provisioning run.
    acquireManagerList('uv', `uv tool list | awk '/^[^[:space:]-]/ {print $1}'`, !customArgv.check),
    acquireManagerList('snap', `if command -v snapd; then snap list; fi`, !customArgv.check),
    acquireManagerList('zap', `zap list`, !customArgv.check)
  ]
  const lists = await Promise.all(listPromises)
  const managerLists = {
    // AppImage packages are installed by Zap, so idempotency must use Zap's
    // inventory rather than Volta/npm's unrelated package list.
    appimage: lists[11],
    apt: lists[0],
    brew: lists[1],
    cargo: lists[2],
    cask: lists[1],
    dnf: lists[3],
    flatpak: lists[4],
    gem: lists[5],
    npm: lists[6],
    pacman: lists[7],
    pip: lists[8],
    pipx: lists[9],
    snap: lists[10],
    zap: lists[11]
  }
  log(`Acquiring installation keys`)
  const requestedKeys = customArgv._ || []
  if (customArgv.check && !customArgv.all && requestedKeys.length === 0) {
    throw new Error('inspection requires --all or at least one package key')
  }
  const unknownKeys = requestedKeys.filter(key => !pkgs[key]).sort()
  if (unknownKeys.length) throw new Error(`unknown package keys: ${unknownKeys.join(',')}`)
  const expandedRequestedKeys = expandDeps(requestedKeys)
  const installKeys = Object.keys(pkgs)
    .filter(i => expandedRequestedKeys.includes(i))
  log(`Constructing installation data`)
  const installData = pkgMap(customArgv.all ? Object.keys(pkgs) : installKeys)
  const unavailableRequested = customArgv.all
    ? []
    : expandedRequestedKeys.filter(key => !installData.some(item => item.listKey === key)).sort()
  if (unavailableRequested.length) {
    if (customArgv.check) {
      process.stdout.write(`${JSON.stringify({
        schemaVersion: 1,
        status: 'unsupported',
        selected: unavailableRequested,
        missing: unavailableRequested,
        unsupported: unavailableRequested
      })}\n`)
      process.exitCode = 21
      return
    }
    throw new Error(`no applicable provider for current platform: ${unavailableRequested.join(',')}`)
  }
  const selectedServiceKeys = new Set(
    (process.env.INSTALL_DOCTOR_SELECTED_SERVICES || '')
      .split(',')
      .filter(Boolean)
  )
  if ([...selectedServiceKeys].some(key => !/^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$/.test(key) || !pkgs[key])) {
    throw new Error('INSTALL_DOCTOR_SELECTED_SERVICES contains an invalid or unknown package key')
  }
  const requestedSelectedPackages = (process.env.INSTALL_DOCTOR_SELECTED_PACKAGES || '').split(',').filter(Boolean)
  if (requestedSelectedPackages.some(key => !/^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$/.test(key) || !pkgs[key])) {
    throw new Error('INSTALL_DOCTOR_SELECTED_PACKAGES contains an invalid or unknown package key')
  }
  const selectedRoots = [...new Set([...requestedSelectedPackages, ...selectedServiceKeys])]
  const missingSelectedDependencies = missingDependencies(selectedRoots)
  if (missingSelectedDependencies.length) {
    throw new Error(`selected packages reference unknown dependencies: ${missingSelectedDependencies.join(',')}`)
  }
  const selectedPackageKeys = new Set(expandDeps(selectedRoots))
  const explicitRequestedKeys = new Set([...expandedRequestedKeys, ...selectedPackageKeys])
  const unavailableSelections = [...explicitRequestedKeys]
    .filter(key => !installData.some(item => item.listKey === key))
    .sort()
  if (unavailableSelections.length) {
    if (customArgv.check) {
      process.stdout.write(`${JSON.stringify({ schemaVersion: 1, status: 'unsupported', selected: unavailableSelections, missing: unavailableSelections, unsupported: unavailableSelections })}\n`)
      process.exitCode = 21
      return
    }
    throw new Error(`no applicable provider for current platform: ${unavailableSelections.join(',')}`)
  }
  const policyUnsupported = installData
    .filter(item => explicitRequestedKeys.has(item.listKey))
    .filter(item => item._deprecated || (isHeadless && (item._app || item.flatpak)))
    .map(item => item.listKey)
    .sort()
  if (policyUnsupported.length) {
    if (customArgv.check) {
      process.stdout.write(`${JSON.stringify({ schemaVersion: 1, status: 'unsupported', selected: policyUnsupported, missing: policyUnsupported, unsupported: policyUnsupported })}\n`)
      process.exitCode = 21
      return
    }
    throw new Error(`explicit selection is unsupported by current policy or host capabilities: ${policyUnsupported.join(',')}`)
  }
  log(`Filtering install instructions`)
  process.env.DEBUG && log(`Headless session detected: ${isHeadless}`)
  const desiredInstructions = installData
    // `--all` is the automatic provisioning path. Catalog entries with
    // `_default: false` stay available through an explicit named invocation
    // (`installx <key>`) but must never be pulled into a workstation/server
    // merely because they are an app, preload, or enabled service.
    .filter(x => !customArgv.all || x._default !== false || explicitRequestedKeys.has(x.listKey))
    .filter(x => !!x.installList)
    .filter(x => !x._deprecated)
    .filter(x => {
      const tier = String(customArgv.tier || process.env.INSTALL_DOCTOR_TIER || '').trim().toLowerCase()
      if (tier === 'minimal' || tier === 'server') {
        if ((x._app || x.flatpak || x.appimage || x.cask) && !explicitRequestedKeys.has(x.listKey)) return false
        if (tier === 'minimal') return !!x._preload || explicitRequestedKeys.has(x.listKey)
      }
      if (!customArgv.lazy) return true
      if (isHeadless && (x._app || x.flatpak || x.appimage) && !explicitRequestedKeys.has(x.listKey)) return false
      // A lazy run installs the minimum baseline plus only those service
      // packages explicitly selected in the immutable desired-state plan.
      return !!x._preload || selectedPackageKeys.has(x.listKey) || selectedServiceKeys.has(x.listKey)
    })
  const unsafePredicates = desiredInstructions.filter(x => getPkgData('_when', x, x.installType)).map(x => x.listKey).sort()
  if (unsafePredicates.length) {
    throw new Error(`catalog _when predicates are unsupported; migrate to typed declarative conditions: ${unsafePredicates.join(',')}`)
  }
  const installInstructions = desiredInstructions
    .map(x => {
      return {
        ...x,
        installList: x.installList.filter(y => {
          if ((x.installType === 'brew' || x.installType === 'cask') && y.includes('/')) {
            return managerLists[x.installType] ? !managerLists[x.installType].includes(y.substring(y.lastIndexOf('/') + 1, y.length)) : true
          } else {
            return managerLists[x.installType] ? !managerLists[x.installType].includes(y) : true
          }
        })
      }
    })
    .filter(x => {
      // Filter out packages already installed by by package managers
      return x.installList.length
    })
  if (customArgv.check) {
    const selected = desiredInstructions.map(x => x.listKey).sort()
    const missing = installInstructions.map(x => x.listKey).sort()
    const unsupported = installInstructions
      .filter(x => !IMPLEMENTED_PROVIDER_TYPES.has(x.installType) || hasMutableGoReference(x))
      .map(x => x.listKey)
      .sort()
    if (unsupported.length) {
      process.stdout.write(`${JSON.stringify({ schemaVersion: 1, status: 'unsupported', selected, missing, unsupported })}\n`)
      process.exitCode = 21
      return
    }
    const status = missing.length ? 'mutation-needed' : 'converged'
    process.stdout.write(`${JSON.stringify({ schemaVersion: 1, status, selected, missing })}\n`)
    process.exitCode = missing.length ? 10 : 0
    return
  }
  const unsupportedScripts = installInstructions.filter(x => x.installType === 'script').map(x => x.listKey).sort()
  if (unsupportedScripts.length) {
    throw new Error(`catalog script providers are unsupported; migrate to a package manager or immutable artifact descriptor: ${unsupportedScripts.join(',')}`)
  }
  const unsupportedAppimages = installInstructions.filter(x => x.installType === 'appimage').map(x => x.listKey).sort()
  if (unsupportedAppimages.length) {
    throw new Error(`catalog appimage providers require a typed immutable artifact descriptor: ${unsupportedAppimages.join(',')}`)
  }
  const mutableGoProviders = installInstructions.filter(hasMutableGoReference).map(x => x.listKey).sort()
  if (mutableGoProviders.length) {
    throw new Error(`catalog go providers require an exact semantic or pseudo-version: ${mutableGoProviders.join(',')}`)
  }
  const unverifiedBinaries = installInstructions.filter(x => x.installType === 'binary').map(x => x.listKey).sort()
  if (unverifiedBinaries.length) {
    throw new Error(`catalog binary providers require a typed immutable artifact descriptor: ${unverifiedBinaries.join(',')}`)
  }
  log(`Running installation routine`)
  await installPackages(installInstructions)
  log(`Installation process complete!`)
}

main().catch(error => {
  if (customArgv.check) {
    process.stdout.write(`${JSON.stringify({ schemaVersion: 1, status: 'error', selected: [], missing: [], error: 'inspection-failed' })}\n`)
    process.exitCode = 20
    return
  }
  throw error
})
