#!/usr/bin/env zx
// @file Get Secret
// @brief Retrieves operational secrets from Infisical and narrowly scoped offline secrets from the local host store.

$.verbose = false

const customArgv = minimist(process.argv.slice(3), {
  boolean: ['exists'],
  alias: {
    e: 'exists',
  },
})

const hostname = (await $`hostname -s`).stdout.trim()
const secretDir = `${os.homedir()}/.local/share/chezmoi/home/.chezmoitemplates/secrets-${hostname}`
const offlineSecretNames = new Set([
  'AGE_PASSWORD',
  'DISK_UNLOCK_KEY',
  'ENCRYPTION_PASSWORD',
  'RESTIC_PASSWORD',
  'encryption-password',
])

async function infisicalConfigured() {
  try {
    await $`command -v infisical`
  } catch {
    return false
  }
  return Boolean(
    process.env.INFISICAL_TOKEN ||
      process.env.INFISICAL_UNIVERSAL_AUTH_CLIENT_ID ||
      fs.existsSync(`${os.homedir()}/.infisical.json`) ||
      fs.existsSync(`${process.cwd()}/.infisical.json`)
  )
}

async function getInfisicalSecret(secretName) {
  // Scope is deliberately fixed: caller-supplied environment/path variables may
  // not broaden a host identity. Project/identity binding remains in Infisical.
  try {
    const secretPath = `/hosts/${hostname}`
    const res = await $`infisical secrets get ${secretName} --env=prod --path=${secretPath} --plain --silent`
    const val = res.stdout.trim()
    return val || null
  } catch {
    return null
  }
}

async function resolveSingleSecret(secretName) {
  if (process.env[secretName]) {
    return process.env[secretName]
  }
  const backend = process.env.INSTALL_DOCTOR_SECRET_BACKEND || 'auto'
  if (!['auto', 'local', 'infisical'].includes(backend)) {
    throw new Error('INSTALL_DOCTOR_SECRET_BACKEND must be auto, local, or infisical')
  }
  const hasInfisical = await infisicalConfigured()
  if (backend === 'infisical' || (backend === 'auto' && hasInfisical)) {
    if (!hasInfisical) return null
    // Fail closed. A configured target identity must never silently inherit the
    // controller's chezmoi keyring when Infisical is unavailable or denies access.
    return getInfisicalSecret(secretName)
  }
  if (!offlineSecretNames.has(secretName)) return null
  const secretPath = `${secretDir}/${secretName}`
  if (fs.existsSync(secretPath)) {
    try {
      const decryptedSecret = await $`cat "${secretPath}" | chezmoi decrypt`
      return decryptedSecret.stdout.trim()
    } catch {
      return null
    }
  }
  return null
}

if (customArgv.exists && !customArgv._.length) {
  console.error('Must pass one or more secrets to check for when using --exists', customArgv)
  process.exit(1)
} else if (!customArgv.exists && (!customArgv._.length || customArgv._.length > 1)) {
  console.log('Must pass exactly one argument.', customArgv)
  process.exit(1)
} else if (customArgv.exists) {
  for (const secretName of customArgv._) {
    const val = await resolveSingleSecret(secretName)
    if (!val) {
      console.error('One or more secret names are unavailable from Infisical or the approved offline store')
      console.log('Secrets that were checked:', customArgv._)
      process.exit(1)
    }
  }
  process.exit(0)
} else {
  const secretName = customArgv._[0]
  const val = await resolveSingleSecret(secretName)
  if (val !== null) {
    console.log(val)
    process.exit(0)
  }
  console.error(`Secret ${secretName} is unavailable from Infisical or the approved offline store`)
  process.exit(1)
}
