#!/usr/bin/env zx
// @file Get Secret
// @brief Retrieves operational secrets from Infisical and narrowly scoped offline secrets from the local host store.

$.verbose = false

const { execFileSync } = await import('node:child_process')

const customArgv = minimist(process.argv.slice(3), {
  boolean: ['exists'],
  alias: {
    e: 'exists',
  },
})

const hostname = (await $`hostname -s`).stdout.trim()
const secretDir = `${os.homedir()}/.local/share/chezmoi/home/.chezmoitemplates/secrets-${hostname}`
const offlineSecretNames = new Set([
  'AGE_PASSWORD',
  'DESKTOP_AUTOLOGIN_PASSWORD',
  'DISK_UNLOCK_KEY',
  'ENCRYPTION_PASSWORD',
  'RESTIC_PASSWORD',
  'RESTIC_SYSTEM_PASSWORD',
  'SUDO_PASSWORD',
  'VNC_PASSWORD',
  'VNC_READ_PASSWORD',
  'encryption-password',
])

async function infisicalConfigured() {
  try {
    await $`command -v curl`
  } catch {
    return false
  }
  return fs.existsSync(`${os.homedir()}/.infisical.json`)
}

function readInfisicalBinding() {
  const configPath = `${os.homedir()}/.infisical.json`
  if (!fs.existsSync(configPath)) return null
  const config = JSON.parse(fs.readFileSync(configPath, 'utf8'))
  const projectId = config.workspaceId || config.projectId
  if (!/^[0-9a-f-]{36}$/.test(projectId || '')) return null
  if (config.secretPath !== '/') return null
  if (!/^[a-z0-9.-]+\.megabyte\.space$/.test(config.hostId || '')) return null
  if (!/^[0-9a-f-]{36}$/.test(config.clientId || '')) return null
  return { projectId, secretPath: config.secretPath, hostId: config.hostId, clientId: config.clientId }
}

function readUniversalAuthClientSecret(binding) {
  try {
    if (process.platform === 'darwin') {
      return execFileSync('security', [
        'find-generic-password', '-a', binding.hostId,
        '-s', 'com.heymegabyte.infisical-universal-auth-client-secret', '-w',
      ], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()
    }
    const credentialPath = `${os.homedir()}/.config/infisical/universal-auth-client-secret`
    const stat = fs.statSync(credentialPath)
    if ((stat.mode & 0o077) !== 0) return null
    return fs.readFileSync(credentialPath, 'utf8').trim()
  } catch {
    return null
  }
}

function getUniversalAuthAccessToken(binding) {
  const clientSecret = readUniversalAuthClientSecret(binding)
  if (!clientSecret) return null
  const response = execFileSync('curl', [
    '--silent', '--show-error', '--fail-with-body', '--max-time', '15',
    '--header', 'Content-Type: application/json', '--data-binary', '@-',
    'https://app.infisical.com/api/v1/auth/universal-auth/login',
  ], {
    encoding: 'utf8',
    input: JSON.stringify({ clientId: binding.clientId, clientSecret }),
    stdio: ['pipe', 'pipe', 'ignore'],
    timeout: 15_000,
    maxBuffer: 1024 * 1024,
  })
  const token = JSON.parse(response)?.accessToken
  return typeof token === 'string' && token.length > 0 ? token : null
}

async function getInfisicalSecret(secretName) {
  // Scope is deliberately fixed: caller-supplied environment/path variables may
  // not broaden a host identity. Project/identity binding remains in Infisical.
  try {
    const binding = readInfisicalBinding()
    if (!binding) return null
    const accessToken = getUniversalAuthAccessToken(binding)
    if (!accessToken) return null
    const endpoint = new URL(`https://app.infisical.com/api/v4/secrets/${encodeURIComponent(secretName)}`)
    endpoint.searchParams.set('projectId', binding.projectId)
    endpoint.searchParams.set('environment', 'prod')
    endpoint.searchParams.set('secretPath', binding.secretPath)
    const curlConfig = [
      `url = "${endpoint.toString()}"`,
      `header = "Authorization: Bearer ${accessToken}"`,
      'silent', 'show-error', 'fail-with-body', 'max-time = 15',
    ].join('\n')
    const response = execFileSync('curl', ['--config', '-'], {
      encoding: 'utf8',
      input: curlConfig,
      stdio: ['pipe', 'pipe', 'ignore'],
      timeout: 15_000,
      maxBuffer: 16 * 1024 * 1024,
    })
    const val = JSON.parse(response)?.secret?.secretValue
    return typeof val === 'string' && val.length > 0 ? val : null
  } catch {
    return null
  }
}

async function resolveSingleSecret(secretName) {
  const backend = process.env.INSTALL_DOCTOR_SECRET_BACKEND || 'auto'
  if (!['auto', 'local', 'infisical'].includes(backend)) {
    throw new Error('INSTALL_DOCTOR_SECRET_BACKEND must be auto, local, or infisical')
  }
  const hasInfisical = await infisicalConfigured()
  if (backend === 'infisical' || (backend === 'auto' && hasInfisical)) {
    if (!hasInfisical) return null
    // Fail closed. A configured target identity must never silently inherit the
    // controller's chezmoi keyring when Infisical is unavailable or denies access.
    return getInfisicalSecret(secretName)
  }
  if (!offlineSecretNames.has(secretName)) return null
  const secretPath = `${secretDir}/${secretName}`
  if (fs.existsSync(secretPath)) {
    try {
      const decryptedSecret = await $`cat "${secretPath}" | chezmoi decrypt`
      return decryptedSecret.stdout.trim()
    } catch {
      return null
    }
  }
  return null
}

if (customArgv.exists && !customArgv._.length) {
  console.error('Must pass one or more secrets to check for when using --exists', customArgv)
  process.exit(1)
} else if (!customArgv.exists && (!customArgv._.length || customArgv._.length > 1)) {
  console.log('Must pass exactly one argument.', customArgv)
  process.exit(1)
} else if (customArgv.exists) {
  for (const secretName of customArgv._) {
    const val = await resolveSingleSecret(secretName)
    if (!val) {
      console.error('One or more secret names are unavailable from Infisical or the approved offline store')
      console.log('Secrets that were checked:', customArgv._)
      process.exit(1)
    }
  }
  process.exit(0)
} else {
  const secretName = customArgv._[0]
  const val = await resolveSingleSecret(secretName)
  if (val !== null) {
    console.log(val)
    process.exit(0)
  }
  console.error(`Secret ${secretName} is unavailable from Infisical or the approved offline store`)
  process.exit(1)
}
