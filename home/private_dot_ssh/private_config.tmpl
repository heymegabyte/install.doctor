# BEGIN Ubuntu fleet Cloudflare Access
Host ubuntu.megabyte.space
    # ubuntu.megabyte.space is now the web desktop (Selkies, HTTP). SSH rides the
    # ssh-ubuntu.megabyte.space hostname on the same private-apps tunnel (ssh://2222).
    HostName ssh-ubuntu.megabyte.space
    User professormanhattan
    Port 22
    ProxyCommand "/Users/Apple/.ssh/ubuntu-ssh-proxy.sh" "/opt/homebrew/opt/cloudflared/bin/cloudflared" %h
    IdentityFile "/Users/Apple/.ssh/id_rsa"
    IdentitiesOnly yes
    ForwardAgent no
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ConnectTimeout 90
    StrictHostKeyChecking yes
# END Ubuntu fleet Cloudflare Access

Include /Users/Apple/.config/colima/ssh_config

Host *
    IgnoreUnknown AddKeysToAgent,UseKeychain
    AddKeysToAgent yes
    UseKeychain yes
    ExitOnForwardFailure yes
    ForwardAgent yes
    ForwardX11 no
    ForwardX11Trusted no
    GSSAPIAuthentication no
    Port 22
    PreferredAuthentications publickey
    Protocol 2
    ServerAliveInterval 60
    ServerAliveCountMax 30
    IdentitiesOnly yes
    IdentityAgent none
    {{ if eq .host.hostname "automation" -}}
    IdentityFile ~/.ssh/ssh-13147527
    {{- else if eq .host.hostname "macbook-pro" -}}
    IdentityFile ~/.ssh/ssh-5c-nano-laptop
    {{- else if eq .host.hostname "reserved" -}}
    IdentityFile ~/.ssh/ssh-5c-nano-green
    {{- else if eq .host.hostname "workstation" -}}
    IdentityFile ~/.ssh/ssh-5c-green
    {{- else -}}
    IdentityFile ~/.ssh/ssh-13196452
    IdentityFile ~/.ssh/ssh-5-nano
    IdentityFile ~/.ssh/ssh-5-nfc-green
    IdentityFile ~/.ssh/ssh-5-nfc-red
    IdentityFile ~/.ssh/ssh-5-nfc-yellow
    {{- end }}
    IdentityFile ~/.ssh/id_rsa
Host gitlab.com
    UpdateHostKeys no
    {{ if eq .host.distro.id "darwin" -}}
    IdentityAgent /Users/apple/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    {{- end }}
Host github.com
    Hostname github.com
    UpdateHostKeys no
    {{ if eq .host.distro.id "darwin" -}}
    IdentityAgent /Users/apple/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    {{- end }}
Host automation
    User {{ .user.username }}
    Hostname ssh-automation.{{ .host.domain }}
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
Host macbook-pro
    User {{ .user.username }}
    Hostname ssh-macbook-pro.{{ .host.domain }}
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
Host reserved
    User {{ .user.username }}
    Hostname ssh-reserved.{{ .host.domain }}
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
Host workstation
    User {{ .user.username }}
    Hostname ssh-workstation.{{ .host.domain }}
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h

# ssh-coolify.megabyte.space via Cloudflare Access (added by Claude 2026-10-10)
# 2026-10-27: switched to non-interactive service-token proxy (CF_ACCESS_SSH_COOLIFY_*)
# so the unattended /loop deploys without a browser login. See coolify-ssh-proxy.sh.
Host ssh-coolify.megabyte.space
  ProxyCommand "/Users/Apple/.ssh/coolify-ssh-proxy.sh" "/opt/homebrew/bin/cloudflared" %h
  StrictHostKeyChecking accept-new
  User root

# ssh-proxmox.megabyte.space via Cloudflare Access (added by Claude 2026-10-11)
Host ssh-proxmox.megabyte.space
  ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
  StrictHostKeyChecking accept-new
  User root

# proxmox.megabyte.space resolves to the Proxmox WEB UI (:8006); SSH is routed via the
# ssh-proxmox tunnel hostname. This alias makes 'ssh proxmox.megabyte.space' reach the host's SSH.
Host proxmox.megabyte.space
  ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname ssh-proxmox.megabyte.space
  StrictHostKeyChecking accept-new
  User root
