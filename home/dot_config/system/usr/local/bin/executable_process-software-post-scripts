#!/usr/bin/env bash
# @file /usr/local/bin/process-software-post-scripts
# @brief Rejects executable post-install metadata in the eager software closure
# @description
#     This script reads the `${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi/software.yml` file,
#     validates that the catalog contains no executable `_post*` metadata.
#     Typed `post-installx/post-PACKAGE_KEY.sh` hooks have one execution owner:
#     run_after_20-post-install.sh.tmpl. Catalog YAML never grants shell authority.

set -uo pipefail

SOFTWARE_YAML="${INSTALL_DOCTOR_SOFTWARE_YAML:-${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi/software.yml}"

# @description Main script execution logic
main() {
  if [[ ! -f "$SOFTWARE_YAML" ]]; then
    printf 'Configuration file not found: %s\n' "$SOFTWARE_YAML" >&2
    exit 1
  fi

  local line package='' key rejected='' in_software=0
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$line" = 'softwarePackages:' ]; then
      in_software=1
      continue
    fi
    [ "$in_software" -eq 1 ] || continue
    if [[ "$line" =~ ^[[:space:]][[:space:]]([a-z0-9][a-z0-9._+-]*):[[:space:]]*$ ]]; then
      package="${BASH_REMATCH[1]}"
      continue
    fi
    if [[ "$line" =~ ^[[:space:]]+_post[[:space:]]*: ]]; then
      key='_post'
      rejected+="${rejected:+,}${package:-unknown}:$key"
    elif [[ "$line" =~ ^[[:space:]]+[\"\'](_post(:[^\"\']+)*)[\"\'][[:space:]]*: ]]; then
      key="${BASH_REMATCH[1]}"
      rejected+="${rejected:+,}${package:-unknown}:$key"
    fi
  done < "$SOFTWARE_YAML"
  if [ -n "$rejected" ]; then
    printf 'Catalog _post commands are unsupported; migrate to typed post-installx hooks: %s\n' "$rejected" >&2
    return 2
  fi
  printf 'Catalog post-install metadata validation complete.\n'
}

main
