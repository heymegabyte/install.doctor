#!/usr/bin/env bash
# @file /usr/local/bin/process-software-groups
# @brief Reconciles only the selected packages' declared groups and folders.

set -uo pipefail
[ -z "${DEBUG:-}" ] || set -x

SOFTWARE_YAML="${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi/software.yml"
MODE=apply
case "${1:-}" in --check|check) MODE=check; shift ;; '') ;; *) printf 'INVALID\tusage\n' >&2; exit 20 ;; esac
[ "$#" -eq 0 ] || { printf 'INVALID\tusage\n' >&2; exit 20; }

invalid() { printf 'INVALID\t%s\n' "$*" >&2; return 20; }
selectedKeys() {
  local RAW KEY SEEN=','
  RAW="${INSTALL_DOCTOR_SELECTED_PACKAGES:-}"
  [ -z "${INSTALL_DOCTOR_SELECTED_SERVICES:-}" ] || RAW="${RAW:+$RAW,}${INSTALL_DOCTOR_SELECTED_SERVICES}"
  [ "${#RAW}" -le 524288 ] || { invalid selected-input-too-large; return; }
  [ -z "$RAW" ] || [[ "$RAW" =~ ^[a-z0-9][a-z0-9._:-]{0,127}(,[a-z0-9][a-z0-9._:-]{0,127})*$ ]] \
    || { invalid selected-input-format; return; }
  [ -n "$RAW" ] || return 0
  while IFS= read -r KEY; do
    [ -n "$KEY" ] || continue
    case "$SEEN" in *",$KEY,"*) continue ;; esac
    SEEN="$SEEN$KEY,"
    printf '%s\n' "$KEY"
  done < <(printf '%s\n' "${RAW//,/$'\n'}" | LC_ALL=C sort)
}

validGroup() { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }
validFolder() {
  local PATH_VALUE="$1" COMPONENT CURRENT=''
  [[ "$PATH_VALUE" =~ ^/(etc|opt|var/(cache|lib|log))/[A-Za-z0-9._/-]+$ ]] || return 1
  case "$PATH_VALUE" in *'//'*|*'/../'*|*'/./'*|*'/..'|*'/.'|*/) return 1 ;; esac
  IFS='/' read -r -a COMPONENTS <<<"$PATH_VALUE"
  for COMPONENT in "${COMPONENTS[@]}"; do
    [ -n "$COMPONENT" ] || continue
    CURRENT="$CURRENT/$COMPONENT"
    [ ! -L "$CURRENT" ] || return 1
  done
}
groupExists() {
  if [[ "$OSTYPE" == darwin* ]]; then dscl . -read "/Groups/$1" >/dev/null 2>&1
  else getent group "$1" >/dev/null 2>&1; fi
}
userExists() { id -u "$1" >/dev/null 2>&1; }
userInGroup() { case " $(id -Gn "$1" 2>/dev/null) " in *" $2 "*) return 0 ;; *) return 1 ;; esac; }
folderMatches() {
  local ACTUAL
  [ -d "$1" ] && [ ! -L "$1" ] || return 1
  ACTUAL="$(stat -f '%Su:%Sg:%Lp' "$1" 2>/dev/null || stat -c '%U:%G:%a' "$1" 2>/dev/null)" || return 1
  [ "$ACTUAL" = "$2:$3:750" ]
}

reconcilePackage() {
  local PACKAGE="$1" DECLARED_GROUPS FOLDERS GROUP FOLDER OWNER TARGET_GROUP NEEDS=false
  yq -e '.softwarePackages["'"$PACKAGE"'"] | type == "!!map"' "$SOFTWARE_YAML" >/dev/null 2>&1 \
    || { invalid "unknown-selected-package\t$PACKAGE"; return; }
  DECLARED_GROUPS="$(yq -r '.softwarePackages["'"$PACKAGE"'"]._groups // [] | .[]' "$SOFTWARE_YAML")" || return 20
  FOLDERS="$(yq -r '.softwarePackages["'"$PACKAGE"'"]._folders // [] | .[]' "$SOFTWARE_YAML")" || return 20
  while IFS= read -r GROUP; do [ -z "$GROUP" ] || validGroup "$GROUP" || { invalid "unsafe-group\t$PACKAGE"; return; }; done <<<"$DECLARED_GROUPS"
  while IFS= read -r FOLDER; do [ -z "$FOLDER" ] || validFolder "$FOLDER" || { invalid "unsafe-folder\t$PACKAGE"; return; }; done <<<"$FOLDERS"
  if [ -n "$FOLDERS" ]; then
    TARGET_GROUP="$(printf '%s\n' "$DECLARED_GROUPS" | sed -n '1p')"
    [ -n "$TARGET_GROUP" ] || TARGET_GROUP="${INSTALL_DOCTOR_USER:-${USER:-}}"
    OWNER="$TARGET_GROUP"
    validGroup "$OWNER" || { invalid "missing-safe-folder-owner\t$PACKAGE"; return; }
    while IFS= read -r FOLDER; do
      [ -n "$FOLDER" ] || continue
      if ! userExists "$OWNER" || ! groupExists "$TARGET_GROUP" || ! folderMatches "$FOLDER" "$OWNER" "$TARGET_GROUP"; then
        NEEDS=true
        if [ "$MODE" = apply ]; then
          command -v own-folder >/dev/null 2>&1 || return 20
          sudo own-folder "$FOLDER" "$OWNER" "$TARGET_GROUP" || return 1
          folderMatches "$FOLDER" "$OWNER" "$TARGET_GROUP" || return 1
        fi
      fi
    done <<<"$FOLDERS"
  else
    OWNER="${INSTALL_DOCTOR_USER:-${USER:-}}"
    validGroup "$OWNER" || { invalid missing-safe-install-user; return; }
    userExists "$OWNER" || { invalid install-user-does-not-exist; return; }
    while IFS= read -r GROUP; do
      [ -n "$GROUP" ] || continue
      if ! groupExists "$GROUP" || ! userInGroup "$OWNER" "$GROUP"; then
        NEEDS=true
        if [ "$MODE" = apply ]; then
          command -v add-usergroup >/dev/null 2>&1 || return 20
          sudo add-usergroup "$OWNER" "$GROUP" || return 1
          groupExists "$GROUP" && userInGroup "$OWNER" "$GROUP" || return 1
        fi
      fi
    done <<<"$DECLARED_GROUPS"
  fi
  [ "$NEEDS" = false ] || [ "$MODE" = apply ] || return 10
}

main() {
  local PACKAGE PACKAGES STATUS=0 RESULT
  [ -f "$SOFTWARE_YAML" ] && [ ! -L "$SOFTWARE_YAML" ] || { invalid configuration-not-found; return; }
  command -v yq >/dev/null 2>&1 || { invalid yq-not-installed; return; }
  PACKAGES="$(selectedKeys)" || return 20
  while IFS= read -r PACKAGE; do
    [ -n "$PACKAGE" ] || continue
    reconcilePackage "$PACKAGE"; RESULT=$?
    case "$RESULT" in 0) ;; 10) [ "$STATUS" -eq 20 ] || STATUS=10 ;; *) STATUS=20 ;; esac
  done <<<"$PACKAGES"
  return "$STATUS"
}

main
