---
services:
  kasm:
    image: lscr.io/linuxserver/kasm:latest@sha256:39d8187ac99a2d361b485d289c49a8556487710776a69bddae76395f8a0e32c2
    container_name: Kasm
    privileged: true
    environment:
      KASM_PORT: 443
      DOCKER_HUB_USERNAME: "${DOCKER_HUB_USERNAME:-}"
      DOCKER_HUB_PASSWORD: "${DOCKER_HUB_PASSWORD:-}"
      DOCKER_MTU: 1500
    volumes:
      - /path/to/data:/opt
      - /path/to/profiles:/profiles #optional
      - /dev/input:/dev/input #optional
      - /run/udev/data:/run/udev/data #optional
    ports:
      - 3000:3000
      - 443:443
    restart: unless-stopped
