---
# Source: https://github.com/rundeck/docker-zoo/blob/master/postgres/docker-compose.yml
version: '3'

services:
    rundeck:
        image: rundeck/rundeck:SNAPSHOT@sha256:484a2daa6a58fceedb46c9de4129917804660aaa3b893ed9b780ff572e909562
        links:
          - postgres
        environment:
            RUNDECK_DATABASE_DRIVER: org.postgresql.Driver
            RUNDECK_DATABASE_USERNAME: rundeck
            RUNDECK_DATABASE_PASSWORD: "${RUNDECK_DATABASE_PASSWORD:?set RUNDECK_DATABASE_PASSWORD}"
            RUNDECK_DATABASE_URL: jdbc:postgresql://postgres/rundeck?autoReconnect=true&useSSL=false&allowPublicKeyRetrieval=true
            RUNDECK_GRAILS_URL: http://localhost:4440
        volumes:
          - ${RUNDECK_LICENSE_FILE:-/dev/null}:/home/rundeck/etc/rundeckpro-license.key
        ports:
          - 4440:4440
    postgres:
        image: postgres:latest@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
        expose:
          - 5432
        environment:
          - POSTGRES_DB=rundeck
          - POSTGRES_USER=rundeck
          - POSTGRES_PASSWORD=${RUNDECK_DATABASE_PASSWORD:?set RUNDECK_DATABASE_PASSWORD}
        volumes:
          - dbdata:/var/lib/postgresql/data

volumes:
    dbdata:
