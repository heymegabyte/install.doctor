version: "3.8"

services:
  browserless:
    image: browserless/chrome:latest@sha256:57d19e414d9fe4ae9d2ab12ba768c97f38d51246c5b31af55a009205c136012f
    deploy:
      replicas: 1
      restart_policy:
        condition: on-failure
      resources:
        limits:
          cpus: '1.0'
          memory: 1024M
    ports:
      - "3000:3000" # change host port if needed
    environment:
      - TOKEN=${BROWSERLESS_TOKEN:?set BROWSERLESS_TOKEN} # required: to secure access
      - MAX_CONCURRENT_SESSIONS=5
      - PREBOOT_CHROME=true
      - CONNECTION_TIMEOUT=300000
      - KEEP_ALIVE=true
    volumes:
      - browserless_data:/data

volumes:
  browserless_data:
