### Hack Nerd Font (4 core weights only — eliminates 30 redundant font HTTP requests)
{{- if not .host.headless }}
{{-   $fontDir := "" }}
{{-   $fontUrlBase := "https://raw.githubusercontent.com/ryanoasis/nerd-fonts/b6c7639200240f2608e751a3aafe1720125895b3/patched-fonts/Hack" }}
{{-   if eq .host.distro.family "darwin" }}
{{-     $fontDir = "Library/Fonts" }}
{{-   else if eq .host.distro.family "linux" }}
{{-     $fontDir = ".local/share/fonts" }}
{{-   else if eq .host.distro.family "windows" }}
{{-     $fontDir = "Windows/Fonts" }}
{{-   end }}
["{{ $fontDir }}/Hack-Regular-Nerd-Font.ttf"]
