{{ $gitArgs := "clone.args = ['--depth', '1']\n    pull.args = ['--ff-only']" }}

### Qubes OS Ansible Playbooks (Qubes only)
{{- if .host.qubes }}
[".local/share/ansible-qubes"]
    type = "git-repo"
    url = "https://github.com/ProfessorManhattan/ansible-qubes.git"
    {{ $gitArgs }}
{{- end }}

