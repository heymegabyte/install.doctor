{
  "name": "install-doctor-site",
  "private": true,
  "version": "0.0.1",
  "description": "Install Doctor Site",
  "scripts": {
    "build": "stencil build --prerender --ci",
    "build:docs": "cd docs && npm ci --force && npm run build",
    "build:noscript": "node scripts/build-noscript.mjs",
    "build:prod": "npm run build:docs && npm run build:noscript && npm run build",
    "deploy": "npm run build:prod && firebase deploy",
    "start": "stencil build --dev --watch --serve --ssr"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "devDependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/docgen": "^0.3.1",
    "@ionic/prettier-config": "^4.0.0",
    "@stencil/core": "^4.45.2",
    "@stencil/helmet": "^0.3.3",
    "@stencil/router": "^2.0.0-2",
    "@stencil/sass": "^3.3.3",
    "@stencil/ssg": "^0.0.22",
    "@stencil/store": "^2.2.5",
    "@types/cacheable-request": "^8.3.6",
    "@types/jest": "^30.0.0",
    "@types/keyv": "^4.2.0",
    "@types/node-fetch": "^2.5.7",
    "@types/normalize-package-data": "^2.4.4",
    "@types/prismjs": "^1.26.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "husky": "^9.1.7",
    "ionic-ds-no-fonts": "^4.1.5",
    "ionicons": "^8.1.0",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "node-fetch": "^3.3.2",
    "prettier": "^2.1.2",
    "prismic-dom": "^2.2.7",
    "prismic-javascript": "^3.0.2",
    "prismjs": "^1.30.0",
    "resize-observer-polyfill": "^1.5.1",
    "rollup-plugin-dotenv": "^0.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "workbox-build": "^7.4.1"
  },
  "author": "Ionic Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionic-team/capacitor.git"
  },
  "bugs": {
    "url": "https://github.com/ionic-team/capacitor"
  },
  "resolutions": {
    "natives": "1.1.3"
  },
  "homepage": "https://github.com/ionic-team/capacitor",
  "prettier": "@ionic/prettier-config",
  "dependencies": {
    "parallax-js": "^3.1.0",
    "workbox-precaching": "^7.4.1"
  },
  "volta": {
    "node": "20.20.2"
  }
}
