{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "lib": ["dom", "esnext"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "module": "esnext",
    "target": "es2017",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "jsxFactory": "h",
    "baseUrl": ".",
    "paths": {
      "@stencil/core": ["node_modules/@stencil/core"],
      "@theme-tools/ui/newsletter": ["node_modules/@theme-tools/ui/dist/newsletter"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src", "types/jsx.d.ts"],
  "exclude": ["node_modules"]
}
