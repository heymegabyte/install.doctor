  "capabilityPatterns": {
    "cloudflare-mcp-provider": ["^AWS_", "^BROWSERBASE_", "^CLOUDAMQP_API_KEY$", "^FLY_API_TOKEN$", "^NEON_API_KEY$", "^POSTHOG_(PERSONAL_API_KEY|HOST)$", "^UPSTASH_(API_KEY|EMAIL)$", "^TINYBIRD_(TOKEN|MCP_TOKEN|API_HOST|HOST|WORKSPACE_ID)$", "^SENTRY_(AUTH_TOKEN|API_KEY)$"],
    "core-development": ["^GIT_", "^NPM_", "^PYPI_", "^DOCKERHUB_", "^CONTEXT7_"],
    "github": ["^GITHUB_", "^GH_"],
    "cloudflare": ["^CLOUDFLARE_", "^CF_", "^R2_", "^TURNSTILE_"],
    "infisical-bootstrap": ["^INFISICAL_(URL|DOMAIN|UNIVERSAL_AUTH_CLIENT_ID|UNIVERSAL_AUTH_CLIENT_SECRET)$"],
    "observability": ["^SENTRY_", "^POSTHOG_", "^LANGFUSE_", "^GRAFANA_", "^PROMETHEUS_", "^LOKI_", "^NETDATA_", "^OTEL_", "^GA4_", "^GTM_"],
    "deployment": ["^VERCEL_", "^COOLIFY_", "^FLY_", "^HEROKU_", "^SURGE_", "^DOCKER_"],
    "communications": ["^SLACK_", "^DISCORD_", "^TELEGRAM_", "^TWILIO_", "^RESEND_", "^SENDGRID_", "^SES_"],
    "infrastructure-operations": ["^PROXMOX_", "^PVE_", "^TAILSCALE_", "^RESTIC_", "^AWS_", "^VULTR_", "^DIGITALOCEAN_", "^HASS_", "^MINIO_", "^WASABI_"],
    "ai-gateway-client": ["^LITELLM_API_KEY$", "^LITELLM_KEY_(TWENTY|WORKER)$"],
    "ai-gateway-runtime": ["^LITELLM_(MASTER_KEY|SALT_KEY|DATABASE_URL|REDIS_URL|METRICS_API_KEY)$"],
    "ai-provider-upstream": ["^OPENAI_", "^ANTHROPIC_", "^DEEPSEEK_", "^GEMINI_", "^GOOGLE_.*API", "^REPLICATE_", "^FAL_", "^VOICEKIT_", "^ELEVENLABS_", "^TAVILY_", "^BROWSERBASE_"]
  },
  "alwaysExcludePatterns": [
    "PASSWORD$",
    "^SUDO_",
    "^VNC_",
    "^DISK_UNLOCK_",
    "^ENCRYPTION_",
    "^AGE_",
    "LICENSE$",
    "PRODUCT_KEY$",
    "^APPLE_PASSWORD$",
    "^GMAIL_PASSWORD$"
  ],
  "offlineBootstrapAllowlist": [
    "AGE_PASSWORD",
    "DISK_UNLOCK_KEY",
    "ENCRYPTION_PASSWORD",
    "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID",
    "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET"
  ]
}
