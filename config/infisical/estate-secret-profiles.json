{
  "schemaVersion": 1,
  "organizationId": "ae2b5959-d074-4948-9068-ae06794c760b",
  "environment": "prod",
  "hosts": {
    "macos.megabyte.space": {
      "profile": "developer-workstation",
      "secretPath": "/hosts/macos-megabyte-space"
    },
    "ubuntu.megabyte.space": {
      "profile": "server-runner",
      "secretPath": "/hosts/ubuntu-megabyte-space"
    },
    "zen.megabyte.space": {
      "profile": "managed-workstation",
      "secretPath": "/hosts/zen-megabyte-space"
    },
    "legion.megabyte.space": {
      "profile": "managed-workstation",
      "secretPath": "/hosts/legion-megabyte-space"
    }
  },
  "profiles": {
    "developer-workstation": [
      "core-development",
      "github",
      "cloudflare",
      "infisical-bootstrap",
      "observability",
      "deployment",
      "communications",
      "infrastructure-operations",
      "ai-development"
    ],
    "server-runner": [
      "core-development",
      "github",
      "cloudflare",
      "infisical-bootstrap",
      "observability",
      "deployment",
      "infrastructure-operations",
      "ai-development"
    ],
    "managed-workstation": [
      "core-development",
      "github",
      "cloudflare",
      "infisical-bootstrap",
      "observability",
      "infrastructure-operations"
    ]
  },
  "capabilityPatterns": {
    "core-development": ["^GIT_", "^NPM_", "^PYPI_", "^DOCKERHUB_", "^CONTEXT7_"],
    "github": ["^GITHUB_", "^GH_"],
    "cloudflare": ["^CLOUDFLARE_", "^CF_", "^R2_", "^TURNSTILE_"],
    "infisical-bootstrap": ["^INFISICAL_(URL|DOMAIN|UNIVERSAL_AUTH_CLIENT_ID|UNIVERSAL_AUTH_CLIENT_SECRET)$"],
    "observability": ["^SENTRY_", "^POSTHOG_", "^LANGFUSE_", "^GRAFANA_", "^PROMETHEUS_", "^LOKI_", "^NETDATA_", "^OTEL_", "^GA4_", "^GTM_"],
    "deployment": ["^VERCEL_", "^COOLIFY_", "^FLY_", "^HEROKU_", "^SURGE_", "^DOCKER_"],
    "communications": ["^SLACK_", "^DISCORD_", "^TELEGRAM_", "^TWILIO_", "^RESEND_", "^SENDGRID_", "^SES_"],
    "infrastructure-operations": ["^PROXMOX_", "^PVE_", "^TAILSCALE_", "^RESTIC_", "^AWS_", "^VULTR_", "^DIGITALOCEAN_", "^HASS_", "^MINIO_", "^WASABI_"],
    "ai-development": ["^OPENAI_", "^ANTHROPIC_", "^DEEPSEEK_", "^GEMINI_", "^GOOGLE_.*API", "^REPLICATE_", "^FAL_", "^VOICEKIT_", "^ELEVENLABS_", "^TAVILY_", "^BROWSERBASE_"]
  },
  "alwaysExcludePatterns": [
    "PASSWORD$",
    "^SUDO_",
    "^VNC_",
    "^DISK_UNLOCK_",
    "^ENCRYPTION_",
    "^AGE_",
    "LICENSE$",
    "PRODUCT_KEY$",
    "^APPLE_PASSWORD$",
    "^GMAIL_PASSWORD$"
  ],
  "offlineBootstrapAllowlist": [
    "AGE_PASSWORD",
    "DISK_UNLOCK_KEY",
    "ENCRYPTION_PASSWORD",
    "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID",
    "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET"
  ]
}
