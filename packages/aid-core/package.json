{
  "name": "@install-doctor/aid-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/core.js",
    "./installer-contracts": "./dist/installer-contracts.js",
    "./broker-approval-contracts": "./dist/broker-approval-contracts.js",
    "./device-authorization": "./dist/device-authorization.js",
    "./profile-resolution": "./dist/profile-resolution.js",
    "./product-identity": "./dist/product-identity.js",
    "./redaction": "./dist/redaction.js",
    "./profile-export": "./dist/profile-export.js",
    "./terminal-lifecycle": "./dist/terminal-lifecycle.js",
    "./platform-support-evidence": "./dist/platform-support-evidence.js",
    "./identity-authority": "./dist/identity-authority.js",
    "./telemetry-semantics": "./dist/telemetry-semantics.js",
    "./offline-secret-exceptions": "./dist/offline-secret-exceptions.js",
    "./host-data-coverage": "./dist/host-data-coverage.js",
    "./hardware-evidence": "./dist/hardware-evidence.js",
    "./correlated-telemetry": "./dist/correlated-telemetry.js",
    "./effective-authorization": "./dist/effective-authorization.js",
    "./agent-sandbox-policy": "./dist/agent-sandbox-policy.js",
    "./task-agent-compiler": "./dist/task-agent-compiler.js",
    "./extension-admission": "./dist/extension-admission.js",
    "./software-catalog": "./dist/software-catalog.js",
    "./catalog-audit": "./dist/catalog-audit.js",
    "./operations-dashboards": "./dist/operations-dashboards.js",
    "./saas-api-contracts": "./dist/saas-api-contracts.js",
    "./theme-tools-research-provisioning": "./dist/theme-tools-research-provisioning.js"
  },
  "types": "./dist/core.d.ts",
  "description": "Tested contracts for Install Doctor aid; not a deployed daemon or gateway",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "lint": "cd ../.. && node packages/aid-core/node_modules/eslint/bin/eslint.js --config packages/aid-core/eslint.config.mjs --max-warnings=0 \"packages/aid-core/src/**/*.ts\" \"packages/aid-core/test/**/*.mjs\" scripts/check-offline-secret-inventory.mjs scripts/generate-desktop-tools-status.mjs",
    "inventory:check": "node ../../scripts/check-offline-secret-inventory.mjs --check",
    "inventory:refresh": "node ../../scripts/check-offline-secret-inventory.mjs --write",
    "test": "npm run build && npm run typecheck:test && npm run lint && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@typescript-eslint/utils": "8.74.0",
    "eslint": "10.15.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.74.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
