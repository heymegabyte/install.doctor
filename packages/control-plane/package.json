{
  "name": "@install-doctor/aid-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aid control plane (Phase A skeleton) — Cloudflare Worker + Hono; imports aid-core route contracts. NOT production: /api/ai/v1 returns 501 until provider/ProjectSites wiring lands.",
  "scripts": {
    "precheck": "npm --prefix ../aid-core run build",
    "pretest": "npm --prefix ../installer-engine run build",
    "check": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run check && node scripts/run-tests.mjs",
    "release:publish": "node scripts/publish-release-to-r2.mjs publish",
    "release:activate": "node scripts/publish-release-to-r2.mjs activate",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "better-auth": "^1.7.14",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=18"
  }
}
