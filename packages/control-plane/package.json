{
  "name": "@install-doctor/aid-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aid control plane (Phase A skeleton) — Cloudflare Worker + Hono; imports aid-core route contracts. NOT production: /api/ai/v1 returns 501 until provider/ProjectSites wiring lands.",
  "scripts": {
    "precheck": "npm --prefix ../aid-core run build",
    "pretest": "npm --prefix ../installer-engine run build",
    "types:runtime": "node -e \"require('node:fs').mkdirSync('.wrangler', { recursive: true })\" && wrangler types .wrangler/control-plane-runtime.d.ts --include-env=false",
    "typecheck": "npm run types:runtime && tsc --project tsconfig.json",
    "typecheck:tooling": "tsc --project tsconfig.tooling.json",
    "check": "npm run typecheck && npm run typecheck:tooling && wrangler deploy --dry-run --outdir dist",
    "typecheck:test": "tsc --project tsconfig.test.json && tsc --project tsconfig.composition-test.json",
    "test": "npm run check && npm run typecheck:test && node scripts/run-tests.mjs",
    "release:publish": "node scripts/publish-release-to-r2.mjs publish",
    "release:activate": "node scripts/publish-release-to-r2.mjs activate",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@better-auth/passkey": "1.7.20",
    "better-auth": "1.7.20",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.8.3",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=18"
  }
}
