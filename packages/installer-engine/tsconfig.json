{
  "extends": "../aid-core/vendor/theme-tools/tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "exactOptionalPropertyTypes": true,
    "types": [
      "node"
    ],
    "noEmit": false,
    "noEmitOnError": true,
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
