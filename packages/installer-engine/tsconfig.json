{
  "extends": "../aid-core/vendor/theme-tools/tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": false,
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*.ts"]
}
