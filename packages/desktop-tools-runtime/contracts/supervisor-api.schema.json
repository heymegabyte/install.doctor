{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop.tools/schemas/local-supervisor-v1.json",
  "title": "Desktop Tools local supervisor contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commands", "network", "ambientShell", "inference", "skills", "externalDirectories", "tools"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "commands": {
      "const": ["validate", "prepare", "run", "service", "status"]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opencodeHost", "privilegedPortsAllowed"],
      "properties": {
        "opencodeHost": { "const": "127.0.0.1" },
        "privilegedPortsAllowed": { "const": false }
      }
    },
    "ambientShell": { "const": false },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "baseUrl", "preferredProvider", "liteLlmAllowed", "credentialSource"],
      "properties": {
        "provider": { "const": "projectsites" },
        "baseUrl": { "const": "https://desktop.tools/api/ai/v1" },
        "preferredProvider": { "const": "deepseek" },
        "liteLlmAllowed": { "const": false },
        "credentialSource": { "const": "protected-file" }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "sha256", "load"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "load": { "const": "on-demand" }
        }
      }
    },
    "externalDirectories": { "const": "deny" },
    "tools": {
      "const": [
        "desktop_tools_discover", "desktop_tools_validate", "desktop_tools_plan", "desktop_tools_approve",
        "desktop_tools_apply", "desktop_tools_verify", "desktop_tools_status", "desktop_tools_resume",
        "desktop_tools_rollback_config", "desktop_tools_deprovision_preview"
      ]
    }
  }
}
