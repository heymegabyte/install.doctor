{
  "name": "@desktop-tools/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Least-privilege local Desktop Tools supervisor and typed tool contracts.",
  "exports": {
    "./opencode-host": "./src/opencode-host.mjs",
    "./durable-session": "./src/durable-session.mjs"
  },
  "scripts": {
    "prebuild": "npm run typecheck",
    "build": "node scripts/build.mjs",
    "lint": "node ../aid-core/node_modules/eslint/bin/eslint.js --max-warnings=0 \"{src,scripts,test}/**/*.mjs\"",
    "test": "npm run typecheck && npm run lint && node --test test/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.19.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.8.3"
  }
}
